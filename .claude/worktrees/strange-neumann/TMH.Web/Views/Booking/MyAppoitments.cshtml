@model List<TMH.Shared.DTOs.AppointmentDetailDto>
@{
    ViewBag.Title = "Lịch khám của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .apt-wrap { max-width: 860px; margin: 40px auto; padding: 0 20px; }
    .apt-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
    .apt-title { font-family: 'Crimson Pro', serif; font-size: 28px; font-weight: 600; color: #0a4d7c; }
    .btn-new { height: 40px; padding: 0 20px; background: #0a4d7c; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; text-decoration: none; display: flex; align-items: center; gap: 6px; }
    .btn-new:hover { background: #1a6fa8; color: #fff; }
    .empty-state { text-align: center; padding: 60px 20px; color: #7a9bb0; }
    .empty-icon { font-size: 48px; margin-bottom: 16px; opacity: .4; }
    .empty-title { font-size: 16px; font-weight: 500; margin-bottom: 8px; color: #3a5a72; }
    .empty-sub { font-size: 13px; margin-bottom: 24px; }
    .apt-card { background: #fff; border: 1px solid #d4e8f5; border-radius: 14px; padding: 20px 24px; margin-bottom: 14px; display: flex; gap: 20px; align-items: flex-start; }
    .apt-card:hover { border-color: #1a6fa8; }
    .apt-date-col { text-align: center; min-width: 60px; background: #f0f8ff; border-radius: 10px; padding: 10px 8px; }
    .apt-day { font-size: 24px; font-weight: 700; color: #0a4d7c; line-height: 1; }
    .apt-month { font-size: 11px; color: #7a9bb0; margin-top: 2px; }
    .apt-body { flex: 1; }
    .apt-doctor { font-size: 15px; font-weight: 500; color: #0a4d7c; margin-bottom: 2px; }
    .apt-spec { font-size: 12px; color: #c9a227; font-weight: 500; margin-bottom: 8px; }
    .apt-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: #7a9bb0; margin-bottom: 8px; }
    .apt-code { font-family: monospace; font-size: 11px; background: #f0f8ff; padding: 2px 8px; border-radius: 4px; color: #1a6fa8; }
    .apt-note { font-size: 12px; color: #555; background: #fafafa; border-left: 3px solid #d4e8f5; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-top: 6px; }
    .apt-diag { font-size: 12px; color: #2d7a52; background: #f0faf4; border-left: 3px solid #2d7a52; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-top: 6px; }
    .apt-cancel-reason { font-size: 12px; color: #721c24; background: #f8d7da; border-left: 3px solid #c0392b; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-top: 6px; }
    .apt-actions { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; min-width: 110px; }
    .badge { display: inline-block; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }
    .badge-cho { background: #fff3cd; color: #856404; }
    .badge-xacnhan { background: #d1ecf1; color: #0c5460; }
    .badge-den { background: #cce5ff; color: #004085; }
    .badge-kham { background: #d4edda; color: #155724; }
    .badge-hoan { background: #e2e3e5; color: #383d41; }
    .badge-huy { background: #f8d7da; color: #721c24; }
    .badge-vang { background: #fdecea; color: #a32d2d; }
    .btn-cancel { font-size: 12px; color: #c0392b; background: none; border: 1px solid #f5c6c6; border-radius: 7px; padding: 5px 12px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-cancel:hover { background: #fdecea; }
    .btn-review { font-size: 12px; color: #856404; background: #fff9e6; border: 1px solid #ffc107; border-radius: 7px; padding: 5px 12px; cursor: pointer; font-family: 'DM Sans', sans-serif; white-space: nowrap; }
    .btn-review:hover { background: #fff3cd; }
    .btn-reviewed { font-size: 12px; color: #155724; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 7px; padding: 5px 12px; font-family: 'DM Sans', sans-serif; cursor: default; }
    .btn-book-again { font-size: 12px; color: #1a6fa8; background: none; border: 1px solid #d4e8f5; border-radius: 7px; padding: 5px 12px; cursor: pointer; font-family: 'DM Sans', sans-serif; text-decoration: none; display: block; text-align: center; }
    .btn-book-again:hover { background: #f0f8ff; }
    .filter-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
    .filter-btn { height: 32px; padding: 0 14px; border: 1px solid #d4e8f5; border-radius: 20px; font-size: 12px; color: #3a5a72; background: #fff; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .filter-btn.active { background: #0a4d7c; color: #fff; border-color: #0a4d7c; }

    /* Cancel reason modal */
    .cancel-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9000; align-items: center; justify-content: center; }
    .cancel-overlay.open { display: flex; }
    .cancel-box { background: #fff; border-radius: 16px; padding: 28px 28px 24px; width: 440px; max-width: 95vw; box-shadow: 0 16px 48px rgba(0,0,0,.18); }
    .cancel-title { font-size: 17px; font-weight: 600; color: #0a4d7c; margin-bottom: 6px; }
    .cancel-sub { font-size: 13px; color: #7a9bb0; margin-bottom: 18px; }
    .reason-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .reason-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid #d4e8f5; border-radius: 9px; cursor: pointer; font-size: 13px; color: #3a5a72; transition: all .15s; }
    .reason-item:hover { border-color: #1a6fa8; background: #f0f8ff; }
    .reason-item.selected { border-color: #c0392b; background: #fdecea; color: #c0392b; font-weight: 500; }
    .reason-item input[type=radio] { accent-color: #c0392b; }
    .cancel-footer { display: flex; gap: 10px; margin-top: 6px; }
    .btn-cancel-confirm { flex: 1; height: 38px; background: #c0392b; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-cancel-confirm:disabled { opacity: .5; cursor: default; }
    .btn-cancel-back { flex: 1; height: 38px; background: #f5f5f5; color: #555; border: none; border-radius: 9px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }

    /* Review modal */
    .review-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9000; align-items: center; justify-content: center; }
    .review-overlay.open { display: flex; }
    .review-box { background: #fff; border-radius: 16px; padding: 28px 28px 24px; width: 460px; max-width: 95vw; box-shadow: 0 16px 48px rgba(0,0,0,.18); }
    .review-title { font-size: 17px; font-weight: 600; color: #0a4d7c; margin-bottom: 4px; }
    .review-sub { font-size: 13px; color: #7a9bb0; margin-bottom: 18px; }
    .star-row { display: flex; gap: 8px; margin-bottom: 16px; font-size: 32px; cursor: pointer; }
    .star-row span { color: #ddd; transition: color .1s; }
    .star-row span.lit { color: #ffc107; }
    .review-textarea { width: 100%; box-sizing: border-box; border: 1px solid #d4e8f5; border-radius: 9px; padding: 10px 12px; font-size: 13px; font-family: 'DM Sans', sans-serif; resize: vertical; min-height: 90px; }
    .review-footer { display: flex; gap: 10px; margin-top: 14px; }
    .btn-review-submit { flex: 2; height: 38px; background: #0a4d7c; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-review-cancel { flex: 1; height: 38px; background: #f5f5f5; color: #555; border: none; border-radius: 9px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .review-ok { display: none; color: #2d7a52; background: #f0faf4; border-radius: 8px; padding: 8px 12px; font-size: 13px; margin-top: 10px; }
    .review-err { display: none; color: #c0392b; background: #fdecea; border-radius: 8px; padding: 8px 12px; font-size: 13px; margin-top: 10px; }
</style>

<div class="apt-wrap">
    <div class="apt-header">
        <div class="apt-title">Lịch khám của tôi</div>
        <a asp-controller="Booking" asp-action="Index" class="btn-new">+ Đặt lịch mới</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#2d7a52;font-size:13px;">
            ✅ @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background:#fdecea;border:1px solid #f5c6c6;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#c0392b;font-size:13px;">
            ❌ @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📅</div>
            <div class="empty-title">Chưa có lịch khám nào</div>
            <div class="empty-sub">Bạn chưa đặt lịch khám nào. Hãy đặt lịch ngay!</div>
            <a asp-controller="Booking" asp-action="Index" class="btn-new" style="display:inline-flex;margin:0 auto;">Đặt lịch khám ngay</a>
        </div>
    }
    else
    {
        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterStatus('all', this)">Tất cả (@Model.Count)</button>
            <button class="filter-btn" onclick="filterStatus('upcoming', this)">Sắp tới</button>
            <button class="filter-btn" onclick="filterStatus('HoanThanh', this)">Đã hoàn thành</button>
            <button class="filter-btn" onclick="filterStatus('DaHuy', this)">Đã huỷ</button>
        </div>

        @foreach (var apt in Model)
        {
            var badgeClass = apt.Status switch
            {
                "ChoXacNhan" => "badge-cho",
                "DaXacNhan"  => "badge-xacnhan",
                "DaDen"      => "badge-den",
                "DangKham"   => "badge-kham",
                "HoanThanh"  => "badge-hoan",
                "DaHuy"      => "badge-huy",
                "VangMat"    => "badge-vang",
                _            => "badge-cho"
            };
            var isUpcoming = apt.WorkDate.Date >= DateTime.Today
                          && apt.Status != "DaHuy" && apt.Status != "HoanThanh" && apt.Status != "VangMat";

            <div class="apt-card" data-status="@apt.Status" data-upcoming="@isUpcoming.ToString().ToLower()">
                <div class="apt-date-col">
                    <div style="font-size:10px;color:#7a9bb0;margin-bottom:2px;text-transform:uppercase;letter-spacing:.04em;">
                        @apt.WorkDate.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"))
                    </div>
                    <div class="apt-day">@apt.WorkDate.Day</div>
                    <div class="apt-month">Th@(apt.WorkDate.Month)/@apt.WorkDate.Year</div>
                </div>

                <div class="apt-body">
                    <div class="apt-doctor">@apt.DoctorName</div>
                    <div class="apt-spec">@apt.Specialty</div>
                    <div class="apt-meta">
                        <span>🕐 @apt.StartTime – @apt.EndTime</span>
                        <span>👤 @apt.PatientName</span>
                        <span class="apt-code">@apt.BookingCode</span>
                        @if (apt.IsReturn)
                        {
                            <span style="background:#fff3cd;color:#856404;border:1px solid #ffc107;border-radius:4px;padding:1px 6px;font-size:10px;font-weight:600;">Tái khám</span>
                        }
                        else
                        {
                            <span style="background:#d4edda;color:#155724;border:1px solid #c3e6cb;border-radius:4px;padding:1px 6px;font-size:10px;font-weight:600;">Khám mới</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(apt.Note))
                    {
                        <div class="apt-note">📝 @apt.Note</div>
                    }
                    @if (!string.IsNullOrEmpty(apt.Diagnosis))
                    {
                        <div class="apt-diag">🩺 Chuẩn đoán: @apt.Diagnosis</div>
                    }
                    @if (apt.Status == "DaHuy" && !string.IsNullOrEmpty(apt.CancellationReason))
                    {
                        <div class="apt-cancel-reason">❌ Lý do huỷ: @apt.CancellationReason</div>
                    }
                </div>

                <div class="apt-actions">
                    <span class="badge @badgeClass">@apt.StatusDisplay</span>

                    @if (isUpcoming && (apt.Status == "ChoXacNhan" || apt.Status == "DaXacNhan"))
                    {
                        <button class="btn-cancel" onclick="openCancelModal(@apt.Id, '@apt.DoctorName', '@apt.WorkDate.ToString("dd/MM/yyyy")', @apt.DoctorId)">Huỷ lịch</button>
                    }

                    @if (apt.Status == "HoanThanh")
                    {
                        if (apt.HasReview)
                        {
                            <span class="btn-reviewed">⭐ Đã đánh giá</span>
                        }
                        else
                        {
                            <button class="btn-review" onclick="openReviewModal(@apt.Id, '@apt.DoctorName')">⭐ Đánh giá</button>
                        }
                    }

                    @if (apt.Status == "DaHuy" || apt.Status == "HoanThanh")
                    {
                        <a asp-controller="Booking" asp-action="Index" asp-route-doctorId="@apt.DoctorId" class="btn-book-again">Đặt lại</a>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Modal huỷ lịch — chọn lý do -->
<div class="cancel-overlay" id="cancelModal">
    <div class="cancel-box">
        <div class="cancel-title">Huỷ lịch khám</div>
        <div class="cancel-sub" id="cancelSubText">Vui lòng cho chúng tôi biết lý do huỷ lịch</div>
        <div class="reason-list">
            <label class="reason-item" onclick="selectReason(this, 'cancel')">
                <input type="radio" name="cancelReason" value="Không có nhu cầu khám" />
                <div>
                    <div style="font-weight:500;">Không có nhu cầu khám</div>
                    <div style="font-size:11px;color:#7a9bb0;margin-top:2px;">Tôi không cần khám nữa</div>
                </div>
            </label>
            <label class="reason-item" onclick="selectReason(this, 'rebook')">
                <input type="radio" name="cancelReason" value="Muốn đổi lịch khám" />
                <div>
                    <div style="font-weight:500;">🔄 Muốn đổi lịch khám</div>
                    <div style="font-size:11px;color:#7a9bb0;margin-top:2px;">Tôi muốn đặt lại lịch với thời gian khác</div>
                </div>
            </label>
        </div>
        <div id="cancelErr" style="display:none;color:#c0392b;font-size:12px;margin-bottom:8px;"></div>
        <div class="cancel-footer">
            <button class="btn-cancel-back" onclick="closeCancelModal()">Quay lại</button>
            <button class="btn-cancel-confirm" id="confirmCancelBtn" onclick="submitCancel()" disabled>Xác nhận huỷ</button>
        </div>
    </div>
</div>

<!-- Modal đánh giá bác sĩ -->
<div class="review-overlay" id="reviewModal">
    <div class="review-box">
        <div class="review-title">Đánh giá bác sĩ</div>
        <div class="review-sub" id="reviewSubText">Chia sẻ trải nghiệm của bạn</div>
        <div class="star-row" id="starRow">
            <span data-v="1" onclick="setRating(1)">★</span>
            <span data-v="2" onclick="setRating(2)">★</span>
            <span data-v="3" onclick="setRating(3)">★</span>
            <span data-v="4" onclick="setRating(4)">★</span>
            <span data-v="5" onclick="setRating(5)">★</span>
        </div>
        <textarea id="reviewComment" class="review-textarea" placeholder="Nhận xét về bác sĩ, thái độ, chuyên môn... (không bắt buộc)"></textarea>
        <div class="review-ok" id="reviewOk">✅ Đánh giá đã được ghi nhận. Cảm ơn bạn!</div>
        <div class="review-err" id="reviewErr"></div>
        <div class="review-footer" id="reviewFooter">
            <button class="btn-review-cancel" onclick="closeReviewModal()">Huỷ</button>
            <button class="btn-review-submit" onclick="submitReview()">Gửi đánh giá</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    function filterStatus(status, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.apt-card').forEach(card => {
            if (status === 'all') card.style.display = '';
            else if (status === 'upcoming') card.style.display = card.dataset.upcoming === 'true' ? '' : 'none';
            else card.style.display = card.dataset.status === status ? '' : 'none';
        });
    }

    /* ── Huỷ lịch ────────────────────────────────── */
    var _cancelId = null;
    var _cancelDoctorId = 0;
    var _cancelAction = 'cancel';

    function openCancelModal(id, doctor, date, doctorId) {
        _cancelId = id;
        _cancelDoctorId = doctorId || 0;
        _cancelAction = 'cancel';
        document.getElementById('cancelSubText').textContent = 'Huỷ lịch với ' + doctor + ' ngày ' + date + '. Vui lòng cho chúng tôi biết lý do:';
        document.querySelectorAll('.reason-item').forEach(el => el.classList.remove('selected'));
        document.querySelectorAll('input[name=cancelReason]').forEach(r => r.checked = false);
        var btn = document.getElementById('confirmCancelBtn');
        btn.disabled = true; btn.textContent = 'Xác nhận huỷ';
        btn.style.background = '#c0392b';
        document.getElementById('cancelErr').style.display = 'none';
        document.getElementById('cancelModal').classList.add('open');
    }
    function closeCancelModal() { document.getElementById('cancelModal').classList.remove('open'); }

    function selectReason(label, action) {
        _cancelAction = action || 'cancel';
        document.querySelectorAll('.reason-item').forEach(el => el.classList.remove('selected'));
        label.classList.add('selected');
        var btn = document.getElementById('confirmCancelBtn');
        btn.disabled = false;
        if (action === 'rebook') {
            btn.textContent = '🔄 Đổi lịch →';
            btn.style.background = '#0a4d7c';
        } else {
            btn.textContent = 'Xác nhận huỷ';
            btn.style.background = '#c0392b';
        }
    }

    function submitCancel() {
        var selected = document.querySelector('input[name=cancelReason]:checked');
        if (!selected) return;
        var reason = selected.value;
        var btn = document.getElementById('confirmCancelBtn');
        btn.disabled = true; btn.textContent = 'Đang xử lý...';
        var csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Booking/CancelAjax/' + _cancelId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify({ cancellationReason: reason })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                if (_cancelAction === 'rebook') {
                    window.location.href = '/Booking' + (_cancelDoctorId > 0 ? '?doctorId=' + _cancelDoctorId : '');
                } else {
                    location.reload();
                }
            } else {
                document.getElementById('cancelErr').textContent = d.message || 'Có lỗi xảy ra.';
                document.getElementById('cancelErr').style.display = 'block';
                btn.disabled = false;
                btn.textContent = _cancelAction === 'rebook' ? '🔄 Đổi lịch →' : 'Xác nhận huỷ';
            }
        })
        .catch(() => {
            document.getElementById('cancelErr').textContent = 'Không kết nối được đến máy chủ.';
            document.getElementById('cancelErr').style.display = 'block';
            btn.disabled = false;
            btn.textContent = _cancelAction === 'rebook' ? '🔄 Đổi lịch →' : 'Xác nhận huỷ';
        });
    }

    /* ── Đánh giá ────────────────────────────────── */
    var _reviewId = null, _rating = 0;
    function openReviewModal(aptId, doctor) {
        _reviewId = aptId; _rating = 0;
        document.getElementById('reviewSubText').textContent = 'Đánh giá ca khám với ' + doctor;
        document.querySelectorAll('#starRow span').forEach(s => s.classList.remove('lit'));
        document.getElementById('reviewComment').value = '';
        document.getElementById('reviewOk').style.display = 'none';
        document.getElementById('reviewErr').style.display = 'none';
        document.getElementById('reviewFooter').style.display = 'flex';
        document.getElementById('reviewModal').classList.add('open');
    }
    function closeReviewModal() { document.getElementById('reviewModal').classList.remove('open'); }

    function setRating(v) {
        _rating = v;
        document.querySelectorAll('#starRow span').forEach(s => {
            s.classList.toggle('lit', parseInt(s.dataset.v) <= v);
        });
    }

    function submitReview() {
        if (_rating === 0) {
            document.getElementById('reviewErr').textContent = 'Vui lòng chọn số sao trước khi gửi.';
            document.getElementById('reviewErr').style.display = 'block'; return;
        }
        document.getElementById('reviewErr').style.display = 'none';
        var comment = document.getElementById('reviewComment').value.trim();
        var csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Booking/SubmitReview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify({ appointmentId: _reviewId, rating: _rating, comment: comment })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                document.getElementById('reviewOk').style.display = 'block';
                document.getElementById('reviewFooter').style.display = 'none';
                setTimeout(() => { location.reload(); }, 1500);
            } else {
                document.getElementById('reviewErr').textContent = d.message || 'Có lỗi xảy ra.';
                document.getElementById('reviewErr').style.display = 'block';
            }
        })
        .catch(() => {
            document.getElementById('reviewErr').textContent = 'Không kết nối được đến máy chủ.';
            document.getElementById('reviewErr').style.display = 'block';
        });
    }
</script>
