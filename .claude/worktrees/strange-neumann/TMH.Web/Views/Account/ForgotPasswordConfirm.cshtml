@{
    ViewBag.Title = "Kiểm tra email — Phòng Khám Tai Mũi Họng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
.auth-wrap{display:flex;min-height:calc(100vh - 64px);align-items:center;justify-content:center;background:linear-gradient(135deg,#f0f8ff 0%,#fff 60%);padding:40px 20px;}
.auth-card{width:100%;max-width:460px;border-radius:16px;border:1px solid #d4e8f5;background:#fff;box-shadow:0 8px 40px rgba(10,77,124,0.08);padding:44px 40px;text-align:center;}
.icon-box{width:64px;height:64px;border-radius:16px;background:#e8f8f0;border:1px solid #b2e4c8;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;}
.form-heading{font-family:'Crimson Pro',serif;font-size:24px;font-weight:600;color:#0a4d7c;margin-bottom:12px;}
.form-sub{font-size:13px;color:#555;margin-bottom:28px;line-height:1.7;}
.tip-box{background:#f0f8ff;border:1px solid #d4e8f5;border-radius:10px;padding:14px 16px;margin-bottom:24px;font-size:12px;color:#3a5a72;text-align:left;line-height:1.7;}
.tip-box ul{margin:8px 0 0;padding-left:18px;}
.btn-back{display:inline-block;height:44px;line-height:44px;padding:0 28px;background:#0a4d7c;color:#fff;border-radius:10px;font-size:14px;font-weight:500;text-decoration:none;transition:background .15s;}
.btn-back:hover{background:#1a6fa8;color:#fff;}
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="icon-box">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="4" width="20" height="16" rx="3" stroke="#22a06b" stroke-width="1.8"/>
                <path d="M2 7l10 7 10-7" stroke="#22a06b" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M9 13l2 2 4-4" stroke="#22a06b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <div class="form-heading">Kiểm tra email của bạn</div>
        <div class="form-sub">
            Nếu địa chỉ email bạn nhập tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu.<br>
            Liên kết có hiệu lực trong <strong>1 giờ</strong>.
        </div>

        <div class="tip-box">
            <strong>Không nhận được email?</strong>
            <ul>
                <li>Kiểm tra thư mục <strong>Spam / Junk</strong></li>
                <li>Đảm bảo bạn nhập đúng địa chỉ email đã đăng ký</li>
                <li>Đợi vài phút rồi thử lại</li>
            </ul>
        </div>

        <a asp-controller="Account" asp-action="ForgotPassword" class="btn-back">Gửi lại email</a>
    </div>
</div>
