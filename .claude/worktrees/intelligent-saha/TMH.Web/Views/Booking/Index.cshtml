@model List<TMH.Shared.DTOs.DoctorScheduleDto>
@{
    ViewBag.Title = "Đặt lịch khám";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patients = ViewBag.Patients as List<TMH.Shared.DTOs.PatientDto> ?? new List<TMH.Shared.DTOs.PatientDto>();
    var preselectedDoctorId = Context.Request.Query["doctorId"].ToString();
}
<style>
    @@keyframes pulse-green {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0.5);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(34,197,94,0);
        }
    }

    @@keyframes dot-blink {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.4;
            transform: scale(0.75);
        }
    }

    .book-wrap {
        max-width: 860px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .book-title {
        font-family: 'Crimson Pro',serif;
        font-size: 28px;
        font-weight: 600;
        color: #0a4d7c;
        margin-bottom: 6px;
    }

    .book-sub {
        font-size: 13px;
        color: #7a9bb0;
        margin-bottom: 28px;
    }

    .step-bar {
        display: flex;
        gap: 0;
        margin-bottom: 28px;
    }

    .step-item {
        flex: 1;
        text-align: center;
        padding: 10px;
        font-size: 12px;
        font-weight: 500;
        color: #7a9bb0;
        border-bottom: 2px solid #d4e8f5;
    }

        .step-item.active {
            color: #0a4d7c;
            border-color: #0a4d7c;
        }

        .step-item.done {
            color: #2d7a52;
            border-color: #2d7a52;
        }

    /* Loại hình khám cards */
    .exam-type-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 8px;
    }
    .exam-type-card {
        border: 2px solid #d4e8f5;
        border-radius: 14px;
        padding: 24px 16px;
        cursor: pointer;
        text-align: center;
        transition: all .18s;
        background: #fff;
    }
    .exam-type-card:hover {
        border-color: #1a6fa8;
        background: #f0f8ff;
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(10,77,124,.1);
    }
    .exam-type-card.selected {
        border-color: #0a4d7c;
        background: #e8f4fd;
    }
    .exam-type-icon { font-size: 36px; margin-bottom: 10px; }
    .exam-type-name { font-size: 15px; font-weight: 600; color: #0a4d7c; margin-bottom: 4px; }
    .exam-type-desc { font-size: 11.5px; color: #7a9bb0; line-height: 1.5; }

    .doctor-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .doc-card {
        border: 1.5px solid #d4e8f5;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: border-color .15s,background .15s;
    }

        .doc-card:hover {
            border-color: #1a6fa8;
            background: #f0f8ff;
        }

        .doc-card.selected {
            border-color: #0a4d7c;
            background: #e8f4fd;
        }

    .doc-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #0a4d7c;
        color: #fff;
        font-family: 'Crimson Pro',serif;
        font-size: 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

    .doc-name {
        font-size: 13px;
        font-weight: 500;
        color: #0a4d7c;
        margin-bottom: 3px;
    }

    .doc-spec {
        font-size: 11px;
        color: #c9a227;
        font-weight: 500;
        margin-bottom: 6px;
    }

    .doc-slots {
        font-size: 11px;
        color: #7a9bb0;
    }

    /* Slot */
    .slot-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 10px;
        margin-bottom: 24px;
    }

    .slot-btn {
        position: relative;
        border: 1.5px solid #bbf7d0;
        border-radius: 10px;
        padding: 12px 8px;
        font-size: 12px;
        font-weight: 500;
        color: #3a5a72;
        cursor: pointer;
        text-align: center;
        background: #f0fdf4;
        transition: all .15s;
        font-family: 'DM Sans',sans-serif;
        animation: pulse-green 2.4s ease-in-out infinite;
    }

        .slot-btn:hover {
            border-color: #1a6fa8;
            background: #f0f8ff;
            color: #0a4d7c;
            animation: none;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(26,111,168,0.12);
        }

        .slot-btn.selected {
            border-color: #0a4d7c;
            background: #0a4d7c;
            color: #fff;
            animation: none;
        }

            .slot-btn.selected .slot-dot {
                background: #fff;
            }

            .slot-btn.selected .slot-available {
                color: rgba(255,255,255,0.8);
                border-color: rgba(255,255,255,0.3);
                background: rgba(255,255,255,0.1);
            }

    /* Chấm xanh nhấp nháy */
    .slot-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: #22c55e;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
        animation: dot-blink 1.6s ease-in-out infinite;
    }
    /* Badge "Còn X chỗ" */
    .slot-available {
        display: inline-flex;
        align-items: center;
        margin-top: 6px;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 10px;
        font-weight: 500;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .form-section {
        background: #fff;
        border: 1px solid #d4e8f5;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 500;
        color: #0a4d7c;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #d4e8f5;
    }

    .form-label {
        font-size: 11px;
        font-weight: 500;
        color: #3a5a72;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        width: 100%;
        height: 40px;
        border: 1px solid #d4e8f5;
        border-radius: 9px;
        padding: 0 12px;
        font-size: 13px;
        color: #0d2d44;
        background: #fff;
        outline: none;
        font-family: 'DM Sans',sans-serif;
        margin-bottom: 14px;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 3px rgba(26,111,168,.09);
        }

    .form-textarea {
        width: 100%;
        height: 80px;
        border: 1px solid #d4e8f5;
        border-radius: 9px;
        padding: 10px 12px;
        font-size: 13px;
        color: #0d2d44;
        background: #fff;
        outline: none;
        font-family: 'DM Sans',sans-serif;
        resize: none;
        box-sizing: border-box;
    }

        .form-textarea:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 3px rgba(26,111,168,.09);
        }

    .summary-box {
        background: #f0f8ff;
        border: 1px solid #d4e8f5;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 20px;
        display: none;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: 4px 0;
    }

        .summary-row .lbl {
            color: #7a9bb0;
        }

        .summary-row .val {
            font-weight: 500;
            color: #0a4d7c;
        }

    .btn-submit {
        width: 100%;
        height: 44px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
        transition: background .15s;
    }

        .btn-submit:hover {
            background: #1a6fa8;
        }

        .btn-submit:disabled {
            background: #9bb5c8;
            cursor: not-allowed;
        }

    .no-slots {
        text-align: center;
        padding: 20px;
        color: #7a9bb0;
        font-size: 13px;
    }

    .btn-group-payment {
        display: flex;
        gap: 12px;
        margin-top: 0;
    }

    .payment-note {
        font-size: 11px;
        color: #7a9bb0;
        text-align: center;
        margin-top: 10px;
    }

    .patient-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 14px;
    }

        .patient-row select {
            flex: 1;
            margin-bottom: 0;
        }

    .btn-add-profile {
        height: 40px;
        padding: 0 14px;
        background: #fff;
        border: 1px solid #0a4d7c;
        color: #0a4d7c;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'DM Sans',sans-serif;
        transition: all .15s;
        flex-shrink: 0;
    }

        .btn-add-profile:hover {
            background: #0a4d7c;
            color: #fff;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 420px;
        max-width: 90vw;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 600;
        color: #0a4d7c;
        margin-bottom: 20px;
    }

    .modal-footer {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-modal-cancel {
        flex: 1;
        height: 40px;
        background: #f5f5f5;
        color: #555;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

    .btn-modal-save {
        flex: 2;
        height: 40px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

        .btn-modal-save:hover {
            background: #1a6fa8;
        }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .msg-err {
        background: #fdecea;
        border: 1px solid #f5c6c6;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 14px;
        color: #c0392b;
        font-size: 12px;
        display: none;
    }
</style>

<div class="book-wrap">
    <div class="book-title">Đặt lịch khám Tai Mũi Họng</div>
    <div class="book-sub">Chọn bác sĩ, khung giờ và điền thông tin để hoàn tất đặt lịch</div>

    <div class="step-bar">
        <div class="step-item active" id="step0-bar">1. Loại hình khám</div>
        <div class="step-item" id="step1-bar">2. Chọn bác sĩ</div>
        <div class="step-item" id="step2-bar">3. Chọn khung giờ</div>
        <div class="step-item" id="step3-bar">4. Xác nhận</div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#2d7a52;font-size:13px;">
            ✅ @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background:#fdecea;border:1px solid #f5c6c6;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#c0392b;font-size:13px;">
            ❌ @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="no-slots">Hiện chưa có lịch làm việc nào. Vui lòng quay lại sau.</div>
    }
    else
    {
        <!-- Bước 0: Chọn loại hình khám -->
        <div class="form-section" id="sec0">
            <div class="form-section-title">Bạn muốn khám vấn đề gì?</div>
            <div class="exam-type-grid">
                <div class="exam-type-card" onclick="selectExamType('tai', this)">
                    <div class="exam-type-icon">👂</div>
                    <div class="exam-type-name">Tai</div>
                    <div class="exam-type-desc">Ù tai, nghe kém, viêm tai giữa, điếc, chảy dịch tai</div>
                </div>
                <div class="exam-type-card" onclick="selectExamType('mui', this)">
                    <div class="exam-type-icon">👃</div>
                    <div class="exam-type-name">Mũi</div>
                    <div class="exam-type-desc">Viêm xoang, nghẹt mũi, chảy nước mũi, polyp mũi</div>
                </div>
                <div class="exam-type-card" onclick="selectExamType('hong', this)">
                    <div class="exam-type-icon">🗣️</div>
                    <div class="exam-type-name">Họng</div>
                    <div class="exam-type-desc">Viêm họng, amidan, khàn tiếng, khó nuốt, ho kéo dài</div>
                </div>
            </div>
            <p style="text-align:center;font-size:12px;color:#94a3b8;margin-top:12px;">
                Hoặc <a href="#" style="color:#1a6fa8;" onclick="selectExamType('all',null);return false;">xem tất cả bác sĩ</a>
            </p>
        </div>

        <form asp-action="Book" asp-controller="Booking" method="post" id="bookForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" id="hPatientId" value="" />
            <input type="hidden" name="scheduleId" id="hScheduleId" value="" />
            <input type="hidden" name="examType" id="hExamType" value="" />

            <!-- Bước 1: Chọn bác sĩ -->
            <div class="form-section" id="sec1" style="display:none">
                <div class="form-section-title" style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        Chọn bác sĩ
                        <span id="examTypeLabel" style="font-size:12px;color:#7a9bb0;font-weight:400;margin-left:8px;"></span>
                    </div>
                    <button type="button" onclick="backToExamType()" style="height:32px;padding:0 14px;background:#fff;border:1.5px solid #d4e8f5;border-radius:8px;font-size:12px;color:#7a9bb0;cursor:pointer;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:5px;transition:all .15s;" onmouseover="this.style.borderColor='#0a4d7c';this.style.color='#0a4d7c'" onmouseout="this.style.borderColor='#d4e8f5';this.style.color='#7a9bb0'">
                        ← Chọn lại loại khám
                    </button>
                </div>
                <div class="doctor-grid" id="doctorGrid">
                    @foreach (var doc in Model)
                    {
                        var initials = string.Join("", doc.FullName.Split(' ').TakeLast(2).Select(w => w[0]));
                        <div class="doc-card" onclick="selectDoctor(@doc.DoctorId, '@doc.FullName', '@doc.Specialty', this)"
                             data-docid="@doc.DoctorId">
                            <div class="doc-avatar">@initials</div>
                            <div class="doc-name">@doc.FullName</div>
                            <div class="doc-spec">@doc.Specialty</div>
                            <div class="doc-slots">@doc.AvailableSlots.Count khung giờ còn trống</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bước 2: Chọn ngày + khung giờ -->
            <div class="form-section" id="sec2" style="display:none">
                <div class="form-section-title">
                    Chọn ca khám —
                    <span id="selDoctorName" style="color:#c9a227"></span>
                    <span style="font-size:11px;color:#7a9bb0;font-weight:400;margin-left:8px;">
                        <span style="display:inline-block;width:7px;height:7px;background:#22c55e;border-radius:50%;margin-right:3px;vertical-align:middle;"></span>
                        Ô xanh = còn chỗ trống
                    </span>
                </div>

                <!-- Date picker -->
                <div style="margin-bottom:20px;">
                    <label class="form-label">Chọn ngày khám</label>
                    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                        <input type="date" id="datePicker" class="form-control"
                               style="max-width:200px;margin-bottom:0;"
                               onchange="onDateChange()" />
                        <div id="dateLoadingSpinner" style="display:none;font-size:12px;color:#7a9bb0;">
                            <span style="display:inline-block;width:14px;height:14px;border:2px solid #d4e8f5;border-top-color:#0a4d7c;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;"></span>
                            Đang tải ca khám...
                        </div>
                    </div>
                    <div id="dateHint" style="font-size:12px;color:#7a9bb0;margin-top:6px;">
                        📅 Vui lòng chọn ngày để xem các ca khám còn trống
                    </div>
                </div>

                <div class="slot-grid" id="slotGrid">
                    <p style="color:#7a9bb0;font-size:13px;grid-column:1/-1;">Chọn ngày để xem ca khám</p>
                </div>
            </div>

            <!-- Bước 3: Hồ sơ + ghi chú -->
            <div class="form-section" id="sec3" style="display:none">
                <div class="form-section-title">Thông tin bổ sung</div>
                <label class="form-label">Hồ sơ khám bệnh</label>
                <div class="patient-row">
                    <select class="form-control" id="selPatient"
                            onchange="document.getElementById('hPatientId').value=this.value">
                        <option value="">-- Chọn hồ sơ --</option>
                        @foreach (var p in patients)
                        {
                            <option value="@p.Id">@p.DisplayLabel</option>
                        }
                    </select>
                    <button type="button" class="btn-add-profile" onclick="openModal()">+ Hồ sơ mới</button>
                </div>
                <label class="form-label">Ghi chú cho bác sĩ (tuỳ chọn)</label>
                <textarea class="form-textarea" name="note"
                      placeholder="Mô tả triệu chứng, tiền sử bệnh liên quan..."></textarea>
            </div>

            <!-- Tóm tắt -->
            <div class="summary-box" id="summaryBox">
                <div class="form-section-title" style="border:none;padding:0;margin-bottom:12px">Tóm tắt lịch khám</div>
                <div class="summary-row" id="sumExamRow" style="display:none"><span class="lbl">Loại khám</span><span class="val" id="sumExam"></span></div>
                <div class="summary-row"><span class="lbl">Bác sĩ</span><span class="val" id="sumDoctor"></span></div>
                <div class="summary-row"><span class="lbl">Chuyên khoa</span><span class="val" id="sumSpec"></span></div>
                <div class="summary-row"><span class="lbl">Ngày khám</span><span class="val" id="sumDate"></span></div>
                <div class="summary-row"><span class="lbl">Ca khám</span><span class="val" id="sumTime"></span></div>
                <div class="summary-row"><span class="lbl">Phí khám</span><span class="val" style="color:#e0292a">100.000 VNĐ</span></div>
            </div>

            <div class="btn-group-payment">
                <button type="submit" class="btn-submit" id="btnSubmit" disabled
                        onclick="return validateForm()" style="flex:1">
                    Xác nhận đặt lịch →
                </button>
                <!--
                <button type="button" class="btn-vnpay" id="btnVnPay" disabled onclick="return payWithVnPay()">
                    Thanh toán VNPay
                </button>
                -->
            </div>
            <p class="payment-note">💡 Chọn <strong>Xác nhận đặt lịch</strong> để đặt trước, hoặc <strong>Thanh toán VNPay</strong> để đặt lịch và thanh toán ngay</p>
        </form>
    }
</div>

<!-- Modal tạo hồ sơ mới -->
<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
        <div class="modal-title">Thêm hồ sơ khám bệnh</div>
        <div class="msg-err" id="modalErr"></div>
        <label class="form-label">Họ và tên *</label>
        <input type="text" class="form-control" id="mName" placeholder="Nguyễn Văn A" />
        <label class="form-label">Ngày sinh *</label>
        <input type="date" class="form-control" id="mDob" />
        <label class="form-label">Giới tính *</label>
        <select class="form-control" id="mGender">
            <option value="">-- Chọn --</option>
            <option value="Nam">Nam</option>
            <option value="Nữ">Nữ</option>
            <option value="Khác">Khác</option>
        </select>
        <label class="form-label">Tiền sử bệnh (tuỳ chọn)</label>
        <textarea class="form-textarea" id="mHistory" placeholder="Dị ứng, bệnh mãn tính..."></textarea>
        <div class="modal-footer">
            <button type="button" class="btn-modal-cancel" onclick="closeModal()">Huỷ</button>
            <button type="button" class="btn-modal-save" id="btnSave" onclick="savePatient()">Lưu hồ sơ</button>
        </div>
    </div>
</div>

<script type="application/json" id="_doctorData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))</script>
<script>
    var doctorData = JSON.parse(document.getElementById('_doctorData').textContent || '[]');
    var selectedDoctor = null;
    var selectedSlot   = null;
    var selectedExamType = null;
    var preselectedDoctorId = @Html.Raw(string.IsNullOrEmpty(preselectedDoctorId) ? "0" : preselectedDoctorId);
    var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

    // Map loại hình khám → từ khóa khớp với sub-specialty thực tế trong DB
    // Specialty format: "Tai Mũi Họng — <sub-specialty>"
    // Lọc theo toàn bộ chuỗi specialty (case-insensitive, bỏ dấu)
    var EXAM_TYPE_MAP = {
        tai:  { label: '👂 Tai',   keywords: ['thính', 'ốc tai', 'tai giữa', 'thính học', 'nghe', 'điếc', 'cấy ốc'] },
        mui:  { label: '👃 Mũi',   keywords: ['xoang', 'nội soi xoang', 'polyp', 'mũi', 'viêm mũi'] },
        hong: { label: '🗣️ Họng', keywords: ['họng', 'amidan', 'thanh quản', 'khàn tiếng', 'nuốt'] },
        all:  { label: '',          keywords: [] }
    };

    function normalizeStr(s) {
        return (s || '').toLowerCase()
            .replace(/à|á|ả|ã|ạ|ă|ắ|ặ|ằ|ẳ|ẵ|â|ấ|ầ|ẩ|ẫ|ậ/g, 'a')
            .replace(/è|é|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ/g, 'e')
            .replace(/ì|í|ỉ|ĩ|ị/g, 'i')
            .replace(/ò|ó|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ/g, 'o')
            .replace(/ù|ú|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự/g, 'u')
            .replace(/ỳ|ý|ỷ|ỹ|ỵ/g, 'y')
            .replace(/đ/g, 'd');
    }

    function selectExamType(type, el) {
        selectedExamType = type;
        document.getElementById('hExamType').value = type;

        // Highlight card đã chọn
        document.querySelectorAll('.exam-type-card').forEach(function(c){ c.classList.remove('selected'); });
        if (el) el.classList.add('selected');

        // Ẩn sec0, hiện sec1
        document.getElementById('sec0').style.display = 'none';
        document.getElementById('sec1').style.display = 'block';
        document.getElementById('step0-bar').classList.remove('active');
        document.getElementById('step0-bar').classList.add('done');
        document.getElementById('step1-bar').classList.add('active');

        // Label loại khám
        var info = EXAM_TYPE_MAP[type] || EXAM_TYPE_MAP.all;
        document.getElementById('examTypeLabel').textContent = info.label ? '— ' + info.label : '';

        // Lọc & render danh sách bác sĩ
        var grid = document.getElementById('doctorGrid');
        grid.innerHTML = '';
        var filtered;
        if (type === 'all' || !info.keywords.length) {
            filtered = doctorData;
        } else {
            filtered = doctorData.filter(function(doc) {
                var spec = normalizeStr(doc.Specialty || doc.specialty || '');
                var desc = normalizeStr(doc.Description || doc.description || '');
                var combined = spec + ' ' + desc;
                return info.keywords.some(function(kw){
                    return combined.includes(normalizeStr(kw));
                });
            });
        }
        // Nếu không có bác sĩ phù hợp → hiển thị tất cả
        if (!filtered.length) filtered = doctorData;

        filtered.forEach(function(doc) {
            var name = doc.FullName || doc.fullName || '';
            var spec = doc.Specialty || doc.specialty || '';
            var slots = (doc.AvailableSlots || doc.availableSlots || []).length;
            var parts = name.split(' ');
            var initials = parts.slice(-2).map(function(w){ return w[0]; }).join('');
            var card = document.createElement('div');
            card.className = 'doc-card';
            card.setAttribute('data-docid', doc.DoctorId || doc.doctorId);
            card.onclick = (function(d, n, s, c){ return function(){ selectDoctor(d, n, s, c); }; })(doc.DoctorId || doc.doctorId, name, spec, card);
            card.innerHTML = '<div class="doc-avatar">' + initials + '</div>' +
                '<div class="doc-name">' + name + '</div>' +
                '<div class="doc-spec">' + spec + '</div>' +
                '<div class="doc-slots">' + slots + ' khung giờ còn trống</div>';
            grid.appendChild(card);
        });

        document.getElementById('sec1').scrollIntoView({ behavior: 'smooth', block: 'start' });

        // Nếu có preselectedDoctorId thì auto-chọn bác sĩ
        if (preselectedDoctorId > 0) {
            var card = grid.querySelector('[data-docid="' + preselectedDoctorId + '"]');
            if (card) {
                var doc = filtered.find(function(d){ return (d.DoctorId || d.doctorId) === preselectedDoctorId; });
                if (doc) selectDoctor(doc.DoctorId || doc.doctorId, doc.FullName || doc.fullName, doc.Specialty || doc.specialty, card);
            }
        }
    }

    window.addEventListener('DOMContentLoaded', function () {
        // Nếu có preselectedDoctorId, tự động chọn "Tất cả" để bỏ qua bước 0
        if (preselectedDoctorId > 0) {
            selectExamType('all', null);
        }
    });

    function backToExamType() {
        // Ẩn sec1, hiện lại sec0
        document.getElementById('sec1').style.display = 'none';
        document.getElementById('sec2').style.display = 'none';
        document.getElementById('sec3').style.display = 'none';
        document.getElementById('summaryBox').style.display = 'none';
        document.getElementById('sec0').style.display = 'block';
        // Reset step bar
        document.getElementById('step0-bar').classList.add('active');
        document.getElementById('step0-bar').classList.remove('done');
        document.getElementById('step1-bar').classList.remove('active');
        document.getElementById('step1-bar').classList.remove('done');
        document.getElementById('step2-bar').classList.remove('active');
        document.getElementById('step2-bar').classList.remove('done');
        document.getElementById('step3-bar').classList.remove('active');
        // Reset selection
        selectedDoctor = null;
        selectedSlot   = null;
        selectedExamType = null;
        document.getElementById('hScheduleId').value = '';
        document.getElementById('hExamType').value = '';
        document.getElementById('btnSubmit').disabled = true;
        document.querySelectorAll('.exam-type-card').forEach(function(c){ c.classList.remove('selected'); });
        document.getElementById('sec0').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function selectDoctor(docId, name, spec, el) {
        document.querySelectorAll('.doc-card').forEach(c => c.classList.remove('selected'));
        el.classList.add('selected');
        selectedDoctor = doctorData.find(d => d.DoctorId === docId);
        document.getElementById('selDoctorName').textContent = name;

        // Hiện bước 2 (khung giờ), reset slot + date
        document.getElementById('sec2').style.display = 'block';
        document.getElementById('step1-bar').classList.add('done');
        document.getElementById('step2-bar').classList.add('active');
        selectedSlot = null;
        document.getElementById('hScheduleId').value = '';
        document.getElementById('sec3').style.display = 'none';
        document.getElementById('summaryBox').style.display = 'none';
        document.getElementById('step3-bar').classList.remove('active');

        // Set min date = hôm nay
        var today = new Date();
        var yyyy = today.getFullYear();
        var mm   = String(today.getMonth()+1).padStart(2,'0');
        var dd   = String(today.getDate()).padStart(2,'0');
        var todayStr = yyyy+'-'+mm+'-'+dd;
        var picker = document.getElementById('datePicker');
        picker.min = todayStr;
        // Giữ ngày đã chọn nếu hợp lệ, không thì reset
        if (!picker.value || picker.value < todayStr) {
            picker.value = '';
            document.getElementById('slotGrid').innerHTML =
                '<p style="color:#7a9bb0;font-size:13px;grid-column:1/-1;">Chọn ngày để xem ca khám</p>';
            document.getElementById('dateHint').style.display = 'block';
        } else {
            onDateChange();
        }
        checkReady();
        document.getElementById('sec2').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function onDateChange() {
        var picker = document.getElementById('datePicker');
        var dateVal = picker.value;
        if (!dateVal || !selectedDoctor) return;

        document.getElementById('dateHint').style.display = 'none';
        document.getElementById('dateLoadingSpinner').style.display = 'flex';
        document.getElementById('slotGrid').innerHTML = '';

        // Reset slot đang chọn
        selectedSlot = null;
        document.getElementById('hScheduleId').value = '';
        document.getElementById('sec3').style.display = 'none';
        document.getElementById('summaryBox').style.display = 'none';
        document.getElementById('step3-bar').classList.remove('active');
        checkReady();

        fetch('/Booking/GetSlotsByDate?doctorId=' + selectedDoctor.DoctorId + '&date=' + dateVal)
            .then(r => r.json())
            .then(function(data) {
                document.getElementById('dateLoadingSpinner').style.display = 'none';
                if (!data.success) {
                    document.getElementById('slotGrid').innerHTML =
                        '<p style="color:#c0392b;font-size:13px;grid-column:1/-1;">Có lỗi khi tải ca khám.</p>';
                    return;
                }
                renderSlotsFromApi(data.slots, selectedDoctor.FullName, selectedDoctor.Specialty, dateVal);
            })
            .catch(function() {
                document.getElementById('dateLoadingSpinner').style.display = 'none';
                document.getElementById('slotGrid').innerHTML =
                    '<p style="color:#c0392b;font-size:13px;grid-column:1/-1;">Không kết nối được máy chủ.</p>';
            });
    }

    function renderSlotsFromApi(slots, docName, spec, dateVal) {
        var grid = document.getElementById('slotGrid');
        grid.innerHTML = '';

        if (!slots || !slots.length) {
            var d = new Date(dateVal + 'T00:00:00');
            var dateDisplay = d.toLocaleDateString('vi-VN', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            grid.innerHTML = '<p style="color:#7a9bb0;font-size:13px;grid-column:1/-1;">Không có ca khám trống vào ' + dateDisplay + '. Vui lòng chọn ngày khác.</p>';
            return;
        }

        // Map từng ca cố định → WorkSchedule phù hợp (overlap)
        // Mỗi ca lấy remaining từ chính schedule của ca đó, không cộng dồn
        FIXED_CA.forEach(function(ca) {
            // Tìm schedule nào bao phủ ca này
            var match = slots.find(function(s) {
                var ss = toMin(s.startTime || s.StartTime);
                var se = toMin(s.endTime   || s.EndTime);
                return ca.start >= ss && ca.end <= se;
            });
            if (!match) return; // Ca này không nằm trong lịch làm việc → bỏ qua

            var rem     = match.remainingSlots  || match.RemainingSlots  || 0;
            var maxPat  = match.maxPatients      || match.MaxPatients      || 5;
            var curPat  = match.currentPatients  || match.CurrentPatients  || (maxPat - rem);
            var slotObj = {
                ScheduleId:  match.scheduleId  || match.ScheduleId,
                WorkDate:    match.workDate    || match.WorkDate,
                startLabel:  toTime(ca.start),
                endLabel:    toTime(ca.end),
                remaining:   rem,
                maxPatients: maxPat,
                currentPatients: curPat
            };

            var btn = document.createElement('div');
            btn.className = 'slot-btn' + (rem === 0 ? ' full' : '');
            btn.innerHTML =
                '<div style="font-size:14px;font-weight:600;margin-bottom:6px;">' + slotObj.startLabel + ' – ' + slotObj.endLabel + '</div>' +
                '<div class="slot-available"><span class="slot-dot"></span>' + curPat + ' / ' + maxPat + ' đã đặt — còn ' + rem + ' chỗ</div>';
            if (rem > 0) {
                (function(so) { btn.onclick = function() { selectSlot(so, docName, spec, btn); }; })(slotObj);
            } else {
                btn.title = 'Ca này đã đầy';
                btn.style.opacity = '0.45';
                btn.style.cursor  = 'not-allowed';
                btn.style.animation = 'none';
            }
            grid.appendChild(btn);
        });

        if (!grid.children.length) {
            var d = new Date(dateVal + 'T00:00:00');
            var dateDisplay = d.toLocaleDateString('vi-VN', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            grid.innerHTML = '<p style="color:#7a9bb0;font-size:13px;grid-column:1/-1;">Không có ca khám trống vào ' + dateDisplay + '.</p>';
        }
    }

    // Ca cố định: 07-09, 09-11, 13-15, 15-17
    var FIXED_CA = [
        { start: 7*60,  end: 9*60  },
        { start: 9*60,  end: 11*60 },
        { start: 13*60, end: 15*60 },
        { start: 15*60, end: 17*60 }
    ];

    function splitToCa(s) {
        var result     = [];
        var schedStart = toMin(s.startTime || s.StartTime);
        var schedEnd   = toMin(s.endTime   || s.EndTime);
        var remaining  = s.remainingSlots || s.RemainingSlots || 1;
        var maxPat     = s.maxPatients || 5;

        // Lọc các ca cố định nằm trong khung giờ làm việc của bác sĩ
        var matched = FIXED_CA.filter(function(ca) {
            return ca.start >= schedStart && ca.end <= schedEnd;
        });

        // Nếu không khớp ca nào (lịch lẻ), fallback 1 ca bằng cả slot
        if (!matched.length) {
            matched = [{ start: schedStart, end: schedEnd }];
        }

        var perSlot = Math.max(1, Math.floor(remaining / matched.length));

        matched.forEach(function(ca) {
            result.push({
                ScheduleId:  s.scheduleId  || s.ScheduleId,
                WorkDate:    s.workDate    || s.WorkDate,
                startLabel:  toTime(ca.start),
                endLabel:    toTime(ca.end),
                remaining:   perSlot,
                maxPatients: maxPat
            });
        });

        return result;
    }

    function toMin(t) { var p = (t || '00:00:00').split(':'); return +p[0] * 60 + +p[1]; }
    function toTime(m) { var h = Math.floor(m/60), mn = m%60; return (h<10?'0':'')+h+':'+(mn<10?'0':'')+mn; }

    function selectSlot(slot, docName, spec, el) {
        document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
        el.classList.add('selected');
        selectedSlot = slot;
        document.getElementById('hScheduleId').value = slot.ScheduleId;
        document.getElementById('sec3').style.display = 'block';
        document.getElementById('step2-bar').classList.add('done');
        document.getElementById('step3-bar').classList.add('active');
        var d = new Date(slot.WorkDate);
        // Hiện loại khám trong summary nếu đã chọn
        var examInfo = selectedExamType && EXAM_TYPE_MAP[selectedExamType];
        if (examInfo && examInfo.label) {
            document.getElementById('sumExam').textContent = examInfo.label;
            document.getElementById('sumExamRow').style.display = '';
        }
        document.getElementById('sumDoctor').textContent = docName;
        document.getElementById('sumSpec').textContent   = spec;
        document.getElementById('sumDate').textContent   = d.toLocaleDateString('vi-VN', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
        document.getElementById('sumTime').textContent   = slot.startLabel + ' – ' + slot.endLabel;
        document.getElementById('summaryBox').style.display = 'block';
        checkReady();
    }

    function checkReady() {
        document.getElementById('btnSubmit').disabled = !(selectedDoctor && selectedSlot);
    }

    function validateForm() {
        if (!document.getElementById('hPatientId').value)  { alert('Vui lòng chọn hồ sơ bệnh nhân'); return false; }
        if (!document.getElementById('hScheduleId').value) { alert('Vui lòng chọn ca khám');          return false; }
        return true;
    }

    // Modal
    function openModal() {
        ['mName','mDob','mGender','mHistory'].forEach(function(id){ document.getElementById(id).value=''; });
        document.getElementById('modalErr').style.display = 'none';
        document.getElementById('modalOverlay').classList.add('open');
    }
    function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }

    function savePatient() {
        var name    = document.getElementById('mName').value.trim();
        var dob     = document.getElementById('mDob').value;
        var gender  = document.getElementById('mGender').value;
        var history = document.getElementById('mHistory').value.trim();
        var errEl   = document.getElementById('modalErr');
        if (!name)   { errEl.textContent='Vui lòng nhập họ tên.';    errEl.style.display='block'; return; }
        if (!dob)    { errEl.textContent='Vui lòng chọn ngày sinh.'; errEl.style.display='block'; return; }
        if (!gender) { errEl.textContent='Vui lòng chọn giới tính.'; errEl.style.display='block'; return; }
        errEl.style.display = 'none';
        var btn = document.getElementById('btnSave');
        btn.disabled=true; btn.textContent='Đang lưu...';
        fetch('/Booking/CreatePatient', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify({ fullName:name, dateOfBirth:dob, gender:gender, medicalHistory:history||null })
        })
        .then(r => r.json())
        .then(function(data) {
            if (data.success && data.patient) {
                var p = data.patient;
                var age = Math.floor((new Date()-new Date(p.dateOfBirth))/(365.25*24*3600*1000));
                var sel = document.getElementById('selPatient');
                var opt = new Option(p.fullName+' ('+p.gender+', '+age+' tuổi) — '+p.recordCode, p.id);
                sel.appendChild(opt); sel.value=p.id;
                document.getElementById('hPatientId').value=p.id;
                closeModal();
            } else { errEl.textContent=data.message||'Có lỗi xảy ra.'; errEl.style.display='block'; }
        })
        .catch(function(){ errEl.textContent='Không kết nối được máy chủ.'; errEl.style.display='block'; })
        .finally(function(){ btn.disabled=false; btn.textContent='Lưu hồ sơ'; });
    }
</script>
