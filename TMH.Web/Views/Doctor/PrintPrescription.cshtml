@{
    Layout = null; // Không dùng layout — trang in độc lập
    var json = ViewBag.PrescriptionJson as string ?? "{}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đơn Thuốc</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Times New Roman', serif; font-size: 13px; color: #000; background: #fff; }
        .page { width: 210mm; min-height: 148mm; margin: 0 auto; padding: 16mm 20mm; }

        /* Header phòng khám */
        .clinic-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #003366; padding-bottom: 10px; margin-bottom: 14px; }
        .clinic-name { font-size: 16px; font-weight: bold; color: #003366; }
        .clinic-sub  { font-size: 11px; color: #555; margin-top: 3px; }
        .clinic-right { text-align: right; font-size: 11px; color: #555; }
        .doc-code { font-size: 11px; color: #888; }

        /* Tiêu đề đơn thuốc */
        .prescription-title { text-align: center; margin: 10px 0 14px; }
        .prescription-title h1 { font-size: 18px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; color: #003366; }
        .prescription-title p  { font-size: 11px; color: #666; margin-top: 3px; }

        /* Thông tin bệnh nhân */
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; background: #f4f8ff; border: 1px solid #ccd9ef; border-radius: 6px; padding: 10px 14px; margin-bottom: 14px; }
        .info-row  { display: flex; gap: 6px; font-size: 12px; }
        .info-label{ color: #555; min-width: 120px; }
        .info-val  { font-weight: 600; color: #000; }

        /* Chẩn đoán */
        .diagnosis-box { border-left: 4px solid #003366; padding: 6px 12px; margin-bottom: 14px; background: #fafcff; }
        .diagnosis-box .label { font-size: 11px; color: #555; margin-bottom: 2px; }
        .diagnosis-box .value { font-weight: 700; font-size: 13px; }

        /* Bảng thuốc */
        table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        thead { background: #003366; color: #fff; }
        thead th { padding: 7px 8px; font-size: 12px; text-align: left; font-weight: 600; }
        tbody tr:nth-child(even) { background: #f4f8ff; }
        tbody td { padding: 7px 8px; font-size: 12px; border-bottom: 1px solid #e0e8f4; vertical-align: top; }
        .medicine-name { font-weight: 700; }
        .medicine-inst { font-size: 11px; color: #666; font-style: italic; margin-top: 2px; }

        /* Ghi chú + chữ ký */
        .notes-row { display: flex; gap: 20px; margin-bottom: 20px; }
        .notes-box { flex: 1; }
        .notes-box .label { font-size: 11px; color: #555; margin-bottom: 4px; }
        .notes-box .value { font-size: 12px; font-style: italic; color: #333; border: 1px dashed #ccc; border-radius: 4px; padding: 6px 10px; min-height: 40px; }

        .signature-box { width: 160px; text-align: center; }
        .signature-box .label { font-size: 11px; color: #555; margin-bottom: 2px; }
        .signature-box .date  { font-size: 11px; color: #888; margin-bottom: 30px; }
        .signature-box .name  { font-weight: 700; border-top: 1px solid #333; padding-top: 4px; font-size: 12px; }

        /* Footer */
        .footer { border-top: 1px solid #ccc; padding-top: 8px; text-align: center; font-size: 10px; color: #888; }

        /* In */
        @@media print {
            body { background: white; }
            .page { padding: 10mm 15mm; }
            .no-print { display: none !important; }
        }

        /* Nút in */
        .print-toolbar { position: fixed; top: 16px; right: 16px; display: flex; gap: 8px; z-index: 999; }
        .btn-print { background: #003366; color: #fff; border: none; padding: 9px 20px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
        .btn-close { background: #e5e7eb; color: #333; border: none; padding: 9px 16px; border-radius: 6px; cursor: pointer; font-size: 13px; }
    </style>
</head>
<body>

<!-- Toolbar chỉ hiện trên màn hình, ẩn khi in -->
<div class="print-toolbar no-print">
    <button class="btn-print" onclick="window.print()">🖨 In đơn thuốc</button>
    <button class="btn-close" onclick="window.close()">✕ Đóng</button>
</div>

<div class="page" id="prescriptionPage">

    <!-- Header -->
    <div class="clinic-header">
        <div>
            <div class="clinic-name">PHÒNG KHÁM TAI MŨI HỌNG</div>
            <div class="clinic-sub">Chuyên khoa Tai – Mũi – Họng | Nội soi – Phẫu thuật</div>
            <div class="clinic-sub">📍 Hà Nội &nbsp;|&nbsp; ☎ 1900-xxxx &nbsp;|&nbsp; 🌐 pktatmuihong.vn</div>
        </div>
        <div class="clinic-right">
            <div id="docCode" class="doc-code"></div>
            <div id="issuedDate" style="margin-top:4px;"></div>
        </div>
    </div>

    <!-- Tiêu đề -->
    <div class="prescription-title">
        <h1>Đơn Thuốc</h1>
        <p id="bookingCode"></p>
    </div>

    <!-- Thông tin bệnh nhân -->
    <div class="info-grid">
        <div class="info-row"><span class="info-label">Họ và tên:</span><span class="info-val" id="patientName"></span></div>
        <div class="info-row"><span class="info-label">Mã bệnh nhân:</span><span class="info-val" id="recordCode"></span></div>
        <div class="info-row"><span class="info-label">Ngày sinh:</span><span class="info-val" id="dob"></span></div>
        <div class="info-row"><span class="info-label">Giới tính:</span><span class="info-val" id="gender"></span></div>
        <div class="info-row"><span class="info-label">Ngày khám:</span><span class="info-val" id="workDate"></span></div>
        <div class="info-row"><span class="info-label">Bác sĩ kê đơn:</span><span class="info-val" id="doctorName"></span></div>
    </div>

    <!-- Chẩn đoán -->
    <div class="diagnosis-box">
        <div class="label">CHẨN ĐOÁN</div>
        <div class="value" id="diagnosis">—</div>
    </div>

    <!-- Bảng thuốc -->
    <table>
        <thead>
            <tr>
                <th style="width:28px">STT</th>
                <th>Tên thuốc</th>
                <th style="width:90px">Liều lượng</th>
                <th style="width:110px">Tần suất</th>
                <th style="width:70px">Số ngày</th>
                <th style="width:70px">Số lượng</th>
            </tr>
        </thead>
        <tbody id="medicineRows"></tbody>
    </table>

    <!-- Ghi chú + chữ ký -->
    <div class="notes-row">
        <div class="notes-box">
            <div class="label">LỜI DẶN / GHI CHÚ</div>
            <div class="value" id="notes">—</div>
        </div>
        <div class="signature-box">
            <div class="label">Bác sĩ kê đơn</div>
            <div class="date" id="signDate"></div>
            <div class="name" id="signDoctor"></div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        Đơn thuốc có giá trị trong vòng 30 ngày kể từ ngày kê đơn. Vui lòng đọc kỹ hướng dẫn sử dụng thuốc.
    </div>
</div>

<script>
    // Đọc JSON từ Razor rồi điền vào DOM
    var raw = @Html.Raw(json);
    var d   = raw.data || raw.Data || {};

    function fmtDate(str) {
        if (!str) return '—';
        var dt = new Date(str);
        return dt.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    document.getElementById('docCode').textContent    = 'Mã ĐT: DT-' + String(d.id || '').padStart(6, '0');
    document.getElementById('issuedDate').textContent = 'Ngày kê: ' + fmtDate(d.issuedAt);
    document.getElementById('bookingCode').textContent = 'Lịch khám: ' + (d.bookingCode || '');
    document.getElementById('patientName').textContent = d.patientName || '—';
    document.getElementById('recordCode').textContent  = d.patientRecordCode || '—';
    document.getElementById('dob').textContent         = fmtDate(d.patientDateOfBirth);
    document.getElementById('gender').textContent      = d.patientGender || '—';
    document.getElementById('workDate').textContent    = fmtDate(d.workDate);
    var doctorDisplay = (d.doctorDegree ? d.doctorDegree + '. ' : '') + (d.doctorName || '—');
    document.getElementById('doctorName').textContent  = doctorDisplay;
    document.getElementById('diagnosis').textContent   = d.diagnosis || '—';
    document.getElementById('notes').textContent       = d.notes || '—';
    document.getElementById('signDate').textContent    = 'Ngày ' + fmtDate(d.issuedAt);
    document.getElementById('signDoctor').textContent  = doctorDisplay;

    // Điền bảng thuốc
    var items = d.items || d.Items || [];
    var tbody = document.getElementById('medicineRows');
    if (items.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;font-style:italic;">Không có thuốc trong đơn</td></tr>';
    } else {
        tbody.innerHTML = items.map(function(item, idx) {
            return '<tr>'
                + '<td style="text-align:center">' + (idx + 1) + '</td>'
                + '<td><div class="medicine-name">' + (item.medicineName || item.MedicineName) + '</div>'
                + (item.instructions || item.Instructions
                    ? '<div class="medicine-inst">↳ ' + (item.instructions || item.Instructions) + '</div>'
                    : '')
                + '</td>'
                + '<td>' + (item.dosage || item.Dosage) + '</td>'
                + '<td>' + (item.frequency || item.Frequency) + '</td>'
                + '<td style="text-align:center">' + (item.durationDays || item.DurationDays) + ' ngày</td>'
                + '<td style="text-align:center">' + (item.quantity || item.Quantity) + '</td>'
                + '</tr>';
        }).join('');
    }
</script>
</body>
</html>
