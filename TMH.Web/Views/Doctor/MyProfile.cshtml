@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mp-wrap {
        max-width: 860px;
        margin: 38px auto;
        padding: 0 16px 60px;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .mp-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 32px;
    }

    .mp-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        color: #fff;
        font-size: 2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 16px rgba(15,118,110,.25);
    }

    .mp-header-info h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 4px;
    }

    .mp-header-info p {
        margin: 0;
        color: #64748b;
        font-size: .9rem;
    }

    .mp-badge {
        display: inline-block;
        background: #f0fdfa;
        color: #0f766e;
        border: 1px solid #99f6e4;
        font-size: .72rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 20px;
        margin-right: 6px;
    }

    .mp-badge-avail {
        display: inline-block;
        font-size: .72rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 20px;
    }

        .mp-badge-avail.on {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #86efac;
        }

        .mp-badge-avail.off {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
        }

    .mp-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .mp-card-header {
        padding: 18px 24px 16px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .mp-card-header h2 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
        }

    .mp-card-body {
        padding: 24px;
    }

    .mp-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .mp-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .mp-field.full {
            grid-column: 1 / -1;
        }

        .mp-field label {
            font-size: .8rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .mp-field input, .mp-field select, .mp-field textarea {
            padding: 10px 13px;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: .95rem;
            color: #1e293b;
            background: #f8fafc;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
            font-family: inherit;
        }

        .mp-field textarea {
            resize: vertical;
            min-height: 80px;
        }

            .mp-field input:focus, .mp-field select:focus, .mp-field textarea:focus {
                border-color: #0f766e;
                box-shadow: 0 0 0 3px rgba(15,118,110,.12);
                background: #fff;
            }

        .mp-field input[readonly] {
            background: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
        }

        .mp-field .mp-hint {
            font-size: .75rem;
            color: #94a3b8;
            margin-top: 2px;
        }

    .mp-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        padding: 0 24px 24px;
    }

    .btn-save {
        padding: 10px 28px;
        background: #0f766e;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s, transform .1s;
    }

        .btn-save:hover {
            background: #0d9488;
            transform: translateY(-1px);
        }

        .btn-save:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            transform: none;
        }

    .mp-toast {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        padding: 14px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: .9rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.15);
        display: none;
        animation: slideIn .25s ease;
    }

        .mp-toast.success {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #6ee7b7;
        }

        .mp-toast.error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
        }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@media (max-width: 600px) {
        .mp-grid {
            grid-template-columns: 1fr;
        }

        .mp-field.full {
            grid-column: 1;
        }
    }
</style>

<div class="mp-wrap">
    <div class="mp-header">
        <div class="mp-avatar" id="mpAvatar">BS</div>
        <div class="mp-header-info">
            <h1 id="mpFullName">Bác sĩ</h1>
            <div style="margin-top:4px;">
                <span class="mp-badge">🩺 Bác sĩ</span>
                <span class="mp-badge-avail" id="mpAvailBadge">●</span>
            </div>
            <p id="mpSpecialty" style="margin-top:6px;"></p>
        </div>
    </div>

    <div class="mp-card">
        <div class="mp-card-header">
            <span>🔐</span>
            <h2>Thông tin tài khoản</h2>
        </div>
        <div class="mp-card-body">
            <div class="mp-grid">
                <div class="mp-field">
                    <label>Tên đăng nhập</label>
                    <input type="text" id="fUsername" readonly />
                    <span class="mp-hint">Không thể thay đổi tên đăng nhập</span>
                </div>
                <div class="mp-field">
                    <label>Email</label>
                    <input type="text" id="fEmail" readonly />
                    <span class="mp-hint">Liên hệ quản trị viên để thay đổi</span>
                </div>
                <div class="mp-field">
                    <label>Số điện thoại</label>
                    <input type="text" id="fPhone" readonly />
                    <span class="mp-hint">Liên hệ quản trị viên để thay đổi</span>
                </div>
                <div class="mp-field">
                    <label>Vai trò</label>
                    <input type="text" value="Bác sĩ" readonly />
                </div>
            </div>
        </div>
    </div>

    <div class="mp-card">
        <div class="mp-card-header">
            <span>👤</span>
            <h2>Thông tin cá nhân</h2>
        </div>
        <div class="mp-card-body">
            <div class="mp-grid">
                <div class="mp-field">
                    <label>Họ và tên đệm</label>
                    <input type="text" id="fHoTenDem" placeholder="VD: Nguyễn Văn" />
                </div>
                <div class="mp-field">
                    <label>Tên</label>
                    <input type="text" id="fTen" placeholder="VD: Minh" />
                </div>
                <div class="mp-field">
                    <label>Ngày sinh</label>
                    <input type="date" id="fNgaySinh" />
                </div>
                <div class="mp-field">
                    <label>Giới tính</label>
                    <select id="fGioiTinh">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="mp-field">
                    <label>Nhóm máu</label>
                    <select id="fNhomMau">
                        <option value="">-- Chọn nhóm máu --</option>
                        <option>A+</option>
                        <option>A-</option>
                        <option>B+</option>
                        <option>B-</option>
                        <option>AB+</option>
                        <option>AB-</option>
                        <option>O+</option>
                        <option>O-</option>
                    </select>
                </div>
                <div class="mp-field">
                    <label>Số CCCD</label>
                    <input type="text" id="fSoCCCD" maxlength="12" placeholder="12 chữ số" />
                </div>
                <div class="mp-field full">
                    <label>Địa chỉ</label>
                    <input type="text" id="fDiaChi" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                </div>
            </div>
        </div>
        <div class="mp-actions">
            <button class="btn-save" id="btnSavePersonal" onclick="savePersonalProfile()">💾 Lưu thông tin cá nhân</button>
        </div>
    </div>

    <div class="mp-card">
        <div class="mp-card-header">
            <span>🏥</span>
            <h2>Thông tin chuyên môn</h2>
        </div>
        <div class="mp-card-body">
            <div class="mp-grid">
                <div class="mp-field">
                    <label>Chuyên khoa</label>
                    <input type="text" id="dSpecialty" placeholder="VD: Tai Mũi Họng" />
                </div>
                <div class="mp-field">
                    <label>Học hàm / Học vị</label>
                    <input type="text" id="dDegree" placeholder="VD: Thạc sĩ, Tiến sĩ, PGS.TS" />
                </div>
                <div class="mp-field full">
                    <label>Giới thiệu bản thân</label>
                    <textarea id="dDescription" rows="4" placeholder="Mô tả kinh nghiệm..."></textarea>
                    <span class="mp-hint">Thông tin này sẽ được hiển thị trên trang Bác sĩ cho bệnh nhân tham khảo.</span>
                </div>
            </div>
        </div>
        <div class="mp-actions">
            <button class="btn-save" id="btnSaveDoctor" onclick="saveDoctorInfo()">🏥 Lưu thông tin chuyên môn</button>
        </div>
    </div>
    <div class="mp-card">
        <div class="mp-card-header">
            <span>🔑</span>
            <h2>Đổi mật khẩu</h2>
        </div>
        <div class="mp-card-body">
            <div class="mp-grid">
                <div class="mp-field full">
                    <label>Mật khẩu hiện tại</label>
                    <input type="password" id="oldPassword" placeholder="Nhập mật khẩu hiện tại" />
                </div>
                <div class="mp-field">
                    <label>Mật khẩu mới</label>
                    <input type="password" id="newPassword" placeholder="Nhập mật khẩu mới" />
                </div>
                <div class="mp-field">
                    <label>Xác nhận mật khẩu mới</label>
                    <input type="password" id="confirmPassword" placeholder="Nhập lại mật khẩu mới" />
                </div>
            </div>
        </div>
        <div class="mp-actions">
            <button class="btn-save" id="btnChangePass" onclick="changePassword()">🔑 Cập nhật mật khẩu</button>
        </div>
    </div>
</div>

<div class="mp-toast" id="mpToast"></div>

@section Scripts {
    <script>
        const __profile    = @Html.Raw(ViewBag.ProfileJson ?? "{}");
        const __doctorInfo = @Html.Raw(ViewBag.DoctorInfoJson ?? "{}");
        const __csrf       = '@Antiforgery.GetAndStoreTokens(Context).RequestToken';

        (function () {
            const p = __profile;
            const d = __doctorInfo;

            const name = (p.fullName || ((p.hoTenDem || '') + ' ' + (p.ten || ''))).trim();
            const words = name.split(' ').filter(Boolean);
            const initials = words.length >= 2
                ? (words[0][0] + words[words.length - 1][0]).toUpperCase()
                : (name.slice(0, 2).toUpperCase() || 'BS');

            document.getElementById('mpAvatar').textContent = initials;
            document.getElementById('mpFullName').textContent = name || 'Bác sĩ';

            const badge = document.getElementById('mpAvailBadge');
            if (d.isAvailable === true) {
                badge.textContent = '● Đang nhận bệnh';
                badge.className = 'mp-badge-avail on';
            } else {
                badge.textContent = '● Tạm ngừng nhận bệnh';
                badge.className = 'mp-badge-avail off';
            }

            const spec = [d.degree, d.specialty].filter(Boolean).join(' — ');
            document.getElementById('mpSpecialty').textContent = spec;

            const set = (id, val) => {
                const el = document.getElementById(id);
                if (el && val != null) el.value = val;
            };

            set('fUsername',  p.username);
            set('fEmail',     p.email);
            set('fPhone',     p.phone);
            set('fHoTenDem',  p.hoTenDem);
            set('fTen',       p.ten);
            set('fNgaySinh',  p.ngaySinh ? p.ngaySinh.slice(0, 10) : null);
            set('fGioiTinh',  p.gioiTinh);
            set('fNhomMau',   p.nhomMau);
            set('fSoCCCD',    p.soCCCD);
            set('fDiaChi',    p.diaChi);
            set('dSpecialty',    d.specialty);
            set('dDegree',       d.degree);
            set('dDescription',  d.description);
        })();

        function showToast(msg, type) {
            const t = document.getElementById('mpToast');
            t.textContent = msg;
            t.className = 'mp-toast ' + type;
            t.style.display = 'block';
            setTimeout(() => { t.style.display = 'none'; }, 3500);
        }

        async function savePersonalProfile() {
            const btn = document.getElementById('btnSavePersonal');
            btn.disabled = true; btn.textContent = '⏳ Đang lưu...';
            try {
                const payload = {
                    hoTenDem: document.getElementById('fHoTenDem').value.trim(),
                    ten:      document.getElementById('fTen').value.trim(),
                    ngaySinh: document.getElementById('fNgaySinh').value || null,
                    gioiTinh: document.getElementById('fGioiTinh').value || null,
                    nhomMau:  document.getElementById('fNhomMau').value || null,
                    soCCCD:   document.getElementById('fSoCCCD').value.trim() || null,
                    diaChi:   document.getElementById('fDiaChi').value.trim() || null
                };
                const res  = await fetch('/Doctor/UpdateMyProfile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': __csrf },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    const fullName = (payload.hoTenDem + ' ' + payload.ten).trim();
                    document.getElementById('mpFullName').textContent = fullName;
                    const words = fullName.split(' ').filter(Boolean);
                    document.getElementById('mpAvatar').textContent = words.length >= 2
                        ? (words[0][0] + words[words.length-1][0]).toUpperCase()
                        : fullName.slice(0,2).toUpperCase();
                    showToast('✅ Cập nhật thông cá nhân thành công!', 'success');
                } else {
                    showToast('❌ ' + (data.message || 'Có lỗi xảy ra.'), 'error');
                }
            } catch (e) {
                showToast('❌ Không thể kết nối đến máy chủ.', 'error');
            } finally {
                btn.disabled = false; btn.textContent = '💾 Lưu thông tin cá nhân';
            }
        }

        async function saveDoctorInfo() {
            const btn = document.getElementById('btnSaveDoctor');
            btn.disabled = true; btn.textContent = '⏳ Đang lưu...';
            try {
                const payload = {
                    specialty:   document.getElementById('dSpecialty').value.trim() || null,
                    degree:      document.getElementById('dDegree').value.trim() || null,
                    description: document.getElementById('dDescription').value.trim() || null
                };
                const res  = await fetch('/Doctor/UpdateDoctorInfo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': __csrf },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    const spec = [payload.degree, payload.specialty].filter(Boolean).join(' — ');
                    document.getElementById('mpSpecialty').textContent = spec;
                    showToast('✅ Cập nhật thông tin chuyên môn thành công!', 'success');
                } else {
                    showToast('❌ ' + (data.message || 'Có lỗi xảy ra.'), 'error');
                }
            } catch (e) {
                showToast('❌ Không thể kết nối đến máy chủ.', 'error');
            } finally {
                btn.disabled = false; btn.textContent = '🏥 Lưu thông tin chuyên môn';
            }
        }
            async function changePassword() {
            const oldP = document.getElementById('oldPassword').value;
            const newP = document.getElementById('newPassword').value;
            const conf = document.getElementById('confirmPassword').value;

            if (!oldP || !newP || !conf) { showToast('❌ Vui lòng điền đầy đủ thông tin mật khẩu.', 'error'); return; }
            if (newP !== conf) { showToast('❌ Mật khẩu mới không khớp.', 'error'); return; }

            const btn = document.getElementById('btnChangePass');
            btn.disabled = true; btn.textContent = '⏳ Đang lưu...';

            try {
                const res = await fetch('/Doctor/ChangePassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': __csrf },
                    body: JSON.stringify({ oldPassword: oldP, newPassword: newP })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('✅ Đổi mật khẩu thành công!', 'success');
                    document.getElementById('oldPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';
                } else {
                    showToast('❌ ' + (data.message || 'Có lỗi xảy ra.'), 'error');
                }
            } catch (e) {
                showToast('❌ Không thể kết nối đến máy chủ.', 'error');
            } finally {
                btn.disabled = false; btn.textContent = '🔑 Cập nhật mật khẩu';
            }
        }
    </script>
}