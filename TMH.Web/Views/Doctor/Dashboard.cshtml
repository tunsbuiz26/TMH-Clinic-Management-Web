@Html.AntiForgeryToken()

@section Scripts {
<script>
    var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // Khởi tạo allCards từ server-side model (dùng cho openDiag trên static cards)
    var allCards = {};
    (function() {
        var _init = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Select(a => new {
                id            = a.Id,
                patientId     = a.PatientId,
                patientName   = a.PatientName,
                doctorId      = a.DoctorId,
                doctorName    = a.DoctorName,
                bookingCode   = a.BookingCode,
                workDate      = a.WorkDate,
                startTime     = a.StartTime,
                endTime       = a.EndTime,
                status        = a.Status,
                statusDisplay = a.StatusDisplay,
                note          = a.Note,
                diagnosis     = a.Diagnosis,
                isReturn      = a.IsReturn
            }).ToList()
        ));
        _init.forEach(function(a) { allCards[a.id] = a; });
    })();

    // ── Sub-tab switching ─────────────────────────────────────────────
    var schViewLoaded = false;
    function showDocTab(name, btn) {
        document.getElementById('panelSchedule').style.display   = name === 'schedule'    ? '' : 'none';
        document.getElementById('panelMySchedules').style.display = name === 'mySchedules' ? '' : 'none';
        document.getElementById('panelArticles').style.display   = name === 'articles'    ? '' : 'none';
        document.querySelectorAll('.sub-tab-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        if (name === 'articles'    && !articlesLoaded) { articlesLoaded = true; loadMyArticles(); }
        if (name === 'mySchedules') { initSchView(); }
    }

    // ── Lịch làm việc: khởi tạo view ─────────────────────────────────
    function initSchView() {
        var today = new Date();
        var endOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);
        document.getElementById('schViewFrom').value = today.toISOString().split('T')[0];
        document.getElementById('schViewTo').value   = endOfMonth.toISOString().split('T')[0];
        loadMySchedules();
    }

    function loadMySchedules() {
        var from = document.getElementById('schViewFrom').value;
        var to   = document.getElementById('schViewTo').value;
        var url  = '/Doctor/GetMySchedules?';
        if (from) url += 'from=' + from + '&';
        if (to)   url += 'to=' + to + '&';
        document.getElementById('mySchTable').innerHTML = '<div class="empty-state">Đang tải...</div>';
        fetch(url.replace(/[?&]$/, ''))
            .then(function(r) { return r.json(); })
            .then(function(data) { renderMySchedules(data); })
            .catch(function() { document.getElementById('mySchTable').innerHTML = '<div class="empty-state">Lỗi kết nối. Vui lòng thử lại.</div>'; });
    }

    function renderMySchedules(data) {
        if (!Array.isArray(data) || !data.length) {
            document.getElementById('mySchTable').innerHTML = '<div class="empty-state" style="padding:40px;">Chưa có lịch làm việc nào trong khoảng thời gian này. Bấm <strong>+ Thêm lịch</strong> để tạo.</div>';
            return;
        }
        var statusMap = {
            'DaDuyet':  '<span style="display:inline-flex;align-items:center;gap:4px;background:#e8f5e9;color:#1b5e20;border:1px solid #a5d6a7;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:600;">✅ Đã duyệt</span>',
            'ChoDuyet': '<span style="display:inline-flex;align-items:center;gap:4px;background:#fff8e1;color:#b8860b;border:1px solid #ffe082;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:600;">⏳ Chờ duyệt</span>',
            'DaHuy':    '<span style="display:inline-flex;align-items:center;gap:4px;background:#fdecea;color:#c0392b;border:1px solid #f5c6c6;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:600;">❌ Đã hủy</span>'
        };
        var html = '<table class="sch-table"><thead><tr>'
            + '<th>Ngày làm việc</th><th>Giờ làm</th><th>Đã đặt / Tối đa</th><th>Còn trống</th><th>Trạng thái</th><th></th>'
            + '</tr></thead><tbody>'
            + data.map(function(s) {
                var cur = s.currentPatients || 0;
                var max = s.maxPatients || 1;
                var rem = s.remainingSlots !== undefined ? s.remainingSlots : (max - cur);
                var pct = Math.round(cur / max * 100);
                var col = pct >= 100 ? '#c0392b' : pct >= 70 ? '#c9a227' : '#2d7a52';
                var bar = '<div style="background:#e8f0f7;border-radius:5px;height:8px;width:80px;display:inline-block;vertical-align:middle;">'
                        + '<div style="background:' + col + ';height:8px;border-radius:5px;width:' + Math.min(pct,100) + '%;"></div></div>';
                var wdate = new Date(s.workDate || s.WorkDate);
                var dateStr = wdate.toLocaleDateString('vi-VN', {weekday:'short', day:'2-digit', month:'2-digit', year:'numeric'});
                var statusHtml = statusMap[s.status || s.Status] || ('<span class="badge badge-cho">' + (s.status || '—') + '</span>');
                var sid = s.id || s.Id;
                var canDel = cur === 0;
                var delBtn = '<button onclick="deleteMySchedule(' + sid + ')" '
                    + (canDel ? '' : 'disabled title="Đã có bệnh nhân đặt lịch"')
                    + ' style="height:28px;padding:0 12px;border-radius:6px;border:1px solid ' + (canDel ? '#f5c6c6' : '#e0e0e0') + ';background:' + (canDel ? '#fdecea' : '#f5f5f5') + ';color:' + (canDel ? '#c0392b' : '#bbb') + ';font-size:12px;cursor:' + (canDel ? 'pointer' : 'not-allowed') + ';">Xóa</button>';
                return '<tr>'
                    + '<td><strong>' + dateStr + '</strong></td>'
                    + '<td>' + (s.startTime || s.StartTime) + ' – ' + (s.endTime || s.EndTime) + '</td>'
                    + '<td>' + bar + ' <span style="font-size:12px;color:#7a9bb0;margin-left:8px;">' + cur + ' / ' + max + '</span></td>'
                    + '<td><strong style="color:' + col + '">' + rem + '</strong></td>'
                    + '<td>' + statusHtml + '</td>'
                    + '<td>' + delBtn + '</td>'
                    + '</tr>';
            }).join('')
            + '</tbody></table>';
        document.getElementById('mySchTable').innerHTML = html;
    }

    // ── Modal Thêm lịch làm việc ──────────────────────────────────────
    var docSelWeekdays = new Set([1,2,3,4,5]);
    var docShifts = [];
    var docShiftCnt = 0;

    function openDocAddSchedule() {
        docSelWeekdays = new Set([1,2,3,4,5]);
        docShifts = []; docShiftCnt = 0;
        document.getElementById('docSchErr').style.display = 'none';
        document.getElementById('docSchOk').style.display  = 'none';
        document.getElementById('docSchPreview').style.display = 'none';
        var today = new Date();
        var d6 = new Date(today); d6.setDate(today.getDate() + 6);
        document.getElementById('docSchFrom').value = today.toISOString().split('T')[0];
        document.getElementById('docSchTo').value   = d6.toISOString().split('T')[0];
        docRenderWDChips();
        docAddShift('07:00', '11:00');
        docAddShift('13:00', '17:00');
        document.getElementById('docSchModal').classList.add('open');
        docUpdatePreview();
    }
    function closeDocAddSchedule() { document.getElementById('docSchModal').classList.remove('open'); }

    function docRenderWDChips() {
        var days = [{v:1,l:'T2'},{v:2,l:'T3'},{v:3,l:'T4'},{v:4,l:'T5'},{v:5,l:'T6'},{v:6,l:'T7'},{v:0,l:'CN'}];
        document.getElementById('docWdContainer').innerHTML = days.map(function(d) {
            return '<div class="sch-wd-chip ' + (docSelWeekdays.has(d.v) ? 'selected' : '') + '" id="dwd-' + d.v + '" onclick="docToggleWD(' + d.v + ')">' + d.l + '</div>';
        }).join('');
    }
    function docToggleWD(v) {
        if (docSelWeekdays.has(v)) docSelWeekdays.delete(v); else docSelWeekdays.add(v);
        var el = document.getElementById('dwd-' + v);
        if (el) el.className = 'sch-wd-chip' + (docSelWeekdays.has(v) ? ' selected' : '');
        docUpdatePreview();
    }
    function docSelectWD(arr) { docSelWeekdays = new Set(arr); docRenderWDChips(); docUpdatePreview(); }

    function docAddShift(s, e) {
        var id = ++docShiftCnt;
        docShifts.push({id:id, start: s||'07:00', end: e||'11:00'});
        docRenderShifts();
        docUpdatePreview();
    }
    function docRemoveShift(id) { docShifts = docShifts.filter(function(s){return s.id!==id;}); docRenderShifts(); docUpdatePreview(); }
    function docRenderShifts() {
        if (!docShifts.length) {
            document.getElementById('docShiftList').innerHTML = '<div style="font-size:12px;color:#7a9bb0;padding:8px 0">Chưa có ca nào.</div>';
            return;
        }
        document.getElementById('docShiftList').innerHTML = docShifts.map(function(s) {
            return '<div class="sch-shift-row" id="dsr-' + s.id + '">'
                + '<input type="time" class="sch-time-inp" value="' + s.start + '" onchange="docUpdShift(' + s.id + ',\'start\',this.value)" />'
                + '<span style="color:#7a9bb0;font-size:13px">–</span>'
                + '<input type="time" class="sch-time-inp" value="' + s.end + '" onchange="docUpdShift(' + s.id + ',\'end\',this.value)" />'
                + '<button onclick="docRemoveShift(' + s.id + ')" style="width:30px;height:30px;border-radius:6px;border:1px solid #f5c6c6;background:#fdecea;color:#c0392b;cursor:pointer;font-size:16px;flex-shrink:0;">×</button>'
                + '</div>';
        }).join('');
    }
    function docUpdShift(id, field, val) { var s = docShifts.find(function(x){return x.id===id;}); if(s) s[field]=val; docUpdatePreview(); }

    function docUpdatePreview() {
        var from = document.getElementById('docSchFrom').value;
        var to   = document.getElementById('docSchTo').value;
        var el   = document.getElementById('docSchPreview');
        if (!from || !to || !docShifts.length || !docSelWeekdays.size) { el.style.display='none'; return; }
        var days = 0, d = new Date(from), tod = new Date(to);
        while (d <= tod) { if (docSelWeekdays.has(d.getDay())) days++; d.setDate(d.getDate()+1); }
        var total = days * docShifts.length;
        el.style.display = 'block';
        el.innerHTML = 'Sẽ tạo tối đa <strong>' + total + ' lịch</strong> — ' + days + ' ngày × ' + docShifts.length + ' ca.';
    }

    function deleteMySchedule(id) {
        if (!confirm('Xác nhận xóa lịch làm việc này?')) return;
        fetch('/Doctor/DeleteMySchedule?id=' + id, {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrfToken }
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success || d.Success) { loadMySchedules(); }
            else alert(d.message || d.Message || 'Không thể xóa.');
        })
        .catch(function() { alert('Lỗi kết nối.'); });
    }

    function saveDocSchedule() {
        var from  = document.getElementById('docSchFrom').value;
        var to    = document.getElementById('docSchTo').value;
        var max   = parseInt(document.getElementById('docSchMax').value) || 10;
        var errEl = document.getElementById('docSchErr');
        errEl.style.display = 'none';

        if (!from || !to)         { errEl.textContent = 'Vui lòng chọn khoảng ngày.';       errEl.style.display='block'; return; }
        if (!docSelWeekdays.size) { errEl.textContent = 'Vui lòng chọn ít nhất 1 thứ.';    errEl.style.display='block'; return; }
        if (!docShifts.length)    { errEl.textContent = 'Vui lòng thêm ít nhất 1 ca.';      errEl.style.display='block'; return; }
        for (var i = 0; i < docShifts.length; i++) {
            if (docShifts[i].start >= docShifts[i].end) {
                errEl.textContent = 'Ca ' + (i+1) + ': giờ kết thúc phải sau giờ bắt đầu.';
                errEl.style.display = 'block'; return;
            }
        }

        var btn = document.getElementById('docSchSave');
        btn.disabled = true; btn.textContent = 'Đang tạo...';

        fetch('/Doctor/CreateMySchedule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify({
                fromDate:    from,
                toDate:      to,
                weekdays:    Array.from(docSelWeekdays),
                maxPatients: max,
                shifts:      docShifts.map(function(s) { return { startTime: s.start + ':00', endTime: s.end + ':00' }; })
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            btn.disabled = false; btn.textContent = '✅ Tạo lịch';
            if (d.success || d.Success) {
                document.getElementById('docSchOk').textContent = d.message || d.Message || 'Tạo lịch thành công!';
                document.getElementById('docSchOk').style.display = 'block';
                setTimeout(function() { closeDocAddSchedule(); loadMySchedules(); }, 1800);
            } else {
                errEl.textContent = d.message || d.Message || 'Có lỗi xảy ra.';
                errEl.style.display = 'block';
            }
        })
        .catch(function() {
            btn.disabled = false; btn.textContent = '✅ Tạo lịch';
            errEl.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
            errEl.style.display = 'block';
        });
    }

    // ── Lịch khám: load theo ngày ────────────────────────────────────
    function loadSchedule() {
        var date = document.getElementById('filterDate').value;
        if (!date) return;
        fetch('/Doctor/GetAppointments?date=' + date)
            .then(function(r) { return r.json(); })
            .then(function(data) { renderCards(data); updateStats(data); })
            .catch(function() { alert('Lỗi kết nối'); });
    }

    // Build patient initials from Vietnamese full name (Họ [Đệm] Tên → HT)
    function ptInitials(name) {
        var parts = (name || '?').trim().split(/\s+/).filter(Boolean);
        if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        return parts.length === 1 ? parts[0][0].toUpperCase() : '?';
    }

    function renderCards(data) {
        var list = document.getElementById('patientList');
        if (!data.length) {
            list.innerHTML = '<div class="empty-state">Không có lịch khám nào trong ngày này</div>';
            return;
        }

        // Ưu tiên: DaDen > DangKham > DaXacNhan > ChoXacNhan > HoanThanh > VangMat > DaHuy > còn lại
        // Trong cùng nhóm: BookedAt mới hơn lên đầu (ai xác nhận/đến sau thì lên trên)
        var statusPriority = {
            'DaDen': 0, 'DangKham': 1, 'DaXacNhan': 2, 'ChoXacNhan': 3,
            'HoanThanh': 4, 'VangMat': 5, 'DaHuy': 6
        };
        data = data.slice().sort(function(a, b) {
            var pa = statusPriority[a.status] !== undefined ? statusPriority[a.status] : 7;
            var pb = statusPriority[b.status] !== undefined ? statusPriority[b.status] : 7;
            if (pa !== pb) return pa - pb;
            // Cùng nhóm: bookedAt mới hơn lên trước
            var ta = a.bookedAt ? new Date(a.bookedAt).getTime() : 0;
            var tb = b.bookedAt ? new Date(b.bookedAt).getTime() : 0;
            return tb - ta;
        });

        var badgeMap = {
            'DaDen': 'badge-den', 'DangKham': 'badge-kham', 'HoanThanh': 'badge-hoan',
            'VangMat': 'badge-vang', 'DaHuy': 'badge-huy',
            'ChoXacNhan': 'badge-cho', 'DaXacNhan': 'badge-cho'
        };
        var cardMap = {
            'DaDen': 'card-waiting', 'DangKham': 'card-started',
            'HoanThanh': 'card-done', 'DaHuy': 'card-inactive', 'VangMat': 'card-inactive'
        };
        var avatarMap = {
            'DaDen': 'pc-av-den', 'DangKham': 'pc-av-kham', 'HoanThanh': 'pc-av-hoan',
            'DaHuy': 'pc-av-huy', 'VangMat': 'pc-av-huy',
            'ChoXacNhan': 'pc-av-cho', 'DaXacNhan': 'pc-av-cho'
        };

        list.innerHTML = data.map(function(a) {
            var bc  = badgeMap[a.status]  || 'badge-cho';
            var cc  = cardMap[a.status]   || '';
            var av  = avatarMap[a.status] || 'pc-av-cho';
            var ini = ptInitials(a.patientName);

            var visitBadge = a.isReturn
                ? '<span class="badge-taikham">♻ Tái khám</span>'
                : '<span class="badge-khamoi">🆕 Khám mới</span>';
            var histBtn = a.isReturn
                ? '<div style="margin-bottom:8px;"><button class="btn-history" onclick="openHistory(' + a.patientId + ',' + a.doctorId + ',\'' + escHtml(a.patientName).replace(/'/g, "\\'") + '\')">📂 Xem lịch sử khám trước</button></div>'
                : '';
            var noteHtml = a.note
                ? '<div class="patient-note">📋 ' + escHtml(a.note) + '</div>'
                : '';
            var diagExisting = a.diagnosis
                ? '<div class="diag-existing" id="diagExisting-' + a.id + '">🩺 <strong>Chuẩn đoán:</strong> ' + escHtml(a.diagnosis) + '</div>'
                : '<div class="diag-existing" id="diagExisting-' + a.id + '" style="display:none;"></div>';

            var actionBtns = buildDoctorActionsAndStore(a);

            return '<div class="patient-card ' + cc + '" id="card-' + a.id + '">' +
                '<div class="pc-avatar ' + av + '">' + ini + '</div>' +
                '<div class="patient-info">' +
                    '<div class="pc-header">' +
                        '<div class="patient-name">' + escHtml(a.patientName) + '</div>' +
                        '<span class="badge ' + bc + '" id="badge-' + a.id + '">' + escHtml(a.statusDisplay) + '</span>' +
                    '</div>' +
                    '<div class="patient-meta">' +
                        '<span class="pc-time-pill">⏰ ' + escHtml(a.startTime) + ' – ' + escHtml(a.endTime) + '</span>' +
                        '<span class="booking-code">' + escHtml(a.bookingCode) + '</span>' +
                        visitBadge +
                    '</div>' +
                    histBtn + noteHtml + diagExisting +
                '</div>' +
                '<div class="patient-actions">' + actionBtns + '</div>' +
                '</div>';
        }).join('');
    }

    // ── Thao tác bác sĩ theo đúng vòng đời ──────────────────────────
    // ChoXacNhan / DaXacNhan → chờ lễ tân check-in, bác sĩ không thao tác
    // DaDen                  → [Bắt đầu khám] → DangKham
    // DangKham               → [Ghi chuẩn đoán] + [Hoàn thành] → HoanThanh
    // HoanThanh              → [Sửa chuẩn đoán] (chỉ cập nhật diagnosis, không đổi status)
    // DaHuy / VangMat        → không thao tác
    function buildDoctorActions(a) {
        var s = a.status;
        if (s === 'ChoXacNhan' || s === 'DaXacNhan')
            return '<span class="lbl-staff">⏳ Chờ lễ tân check-in</span>';
        if (s === 'DaDen')
            return '<button class="btn-action btn-start" onclick="startExam(' + a.id + ')">▶ Bắt đầu khám</button>';
        if (s === 'DangKham')
            return '<button class="btn-action btn-diag" onclick="openDiag(' + a.id + ')">📋 Ghi chuẩn đoán</button>' +
                   '<button class="btn-action btn-prescription" onclick="openRx(' + a.id + ')">💊 Kê đơn thuốc</button>' +
                   '<button class="btn-action btn-done" onclick="finishExam(' + a.id + ')">✅ Hoàn thành</button>';
        if (s === 'HoanThanh')
            return '<button class="btn-action" style="background:#e8f4fd;color:#0a4d7c;border-color:#b8d8f0;" onclick="openDiag(' + a.id + ')">📋 Sửa chuẩn đoán</button>' +
                   '<button class="btn-action btn-prescription" onclick="openRx(' + a.id + ')">💊 Đơn thuốc</button>' +
                   '<button class="btn-action btn-print-phieu" onclick="openDonThuoc(' + a.id + ')">🖨 In đơn thuốc</button>';
        if (s === 'DaHuy')
            return '<span style="font-size:11px;color:#721c24;background:#f8d7da;padding:4px 10px;border-radius:10px;border:1px solid #f5c6c6;font-weight:500;">❌ Đã hủy</span>';
        if (s === 'VangMat')
            return '<span style="font-size:11px;color:#a32d2d;background:#fdecea;padding:4px 10px;border-radius:10px;border:1px solid #f5c6c6;font-weight:500;">🚫 Vắng mặt</span>';
        return '<span style="font-size:11px;color:#bbb;">—</span>';
    }

    // ── Actions bác sĩ ───────────────────────────────────────────────
    function startExam(id) {
        // DaDen → DangKham: không cần confirm vì lễ tân đã xác nhận bệnh nhân có mặt
        postStatus(id, 'DangKham', null, function(ok, msg) {
            if (ok) loadSchedule();
            else alert(msg);
        });
    }

    function finishExam(id) {
        if (!confirm('Xác nhận hoàn thành khám cho bệnh nhân này?')) return;
        postStatus(id, 'HoanThanh', null, function(ok, msg) {
            if (ok) loadSchedule();
            else alert(msg);
        });
    }

    // ── Modal ghi chuẩn đoán ─────────────────────────────────────
    var _diagCurrentId     = 0;
    var _diagCurrentStatus = '';

    function openDiag(id) {
        var a = allCards[id];
        if (!a) return;

        _diagCurrentId     = id;
        _diagCurrentStatus = a.status;

        // Tiêu đề modal
        document.getElementById('diagModalSub').textContent = a.patientName || a.PatientName || '';

        // Điền thông tin cơ bản
        document.getElementById('dModalPatient').textContent = a.patientName || a.PatientName || '—';
        var wd = a.workDate || a.WorkDate;
        if (wd) {
            var d = new Date(wd);
            document.getElementById('dModalDate').textContent = d.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
        } else { document.getElementById('dModalDate').textContent = '—'; }
        document.getElementById('dModalTime').textContent  = (a.startTime || a.StartTime || '') + ' – ' + (a.endTime || a.EndTime || '');
        document.getElementById('dModalCode').textContent  = a.bookingCode || a.BookingCode || '—';

        // Triệu chứng
        var note = a.note || a.Note || '';
        var symWrap = document.getElementById('dModalSymptomWrap');
        if (note) {
            document.getElementById('dModalSymptom').textContent = note;
            symWrap.style.display = '';
        } else { symWrap.style.display = 'none'; }

        // Nội dung đã có
        document.getElementById('dModalDiag').value  = a.diagnosis  || a.Diagnosis  || '';
        document.getElementById('dModalMsg').textContent = '';
        document.getElementById('dModalMsg').className   = 'diag-msg';

        // Ẩn/hiện nút Hoàn thành tuỳ trạng thái
        var btnDone = document.getElementById('dModalBtnDone');
        var btnSave = document.getElementById('dModalBtnSave');
        if (a.status === 'HoanThanh') {
            btnDone.style.display = 'none';
            btnSave.textContent   = '💾 Lưu cập nhật';
        } else {
            btnDone.style.display = '';
            btnSave.textContent   = '💾 Lưu tạm';
        }

        document.getElementById('diagOverlay').classList.add('open');
        setTimeout(function(){ document.getElementById('dModalDiag').focus(); }, 100);
    }

    function closeDiagModal() {
        document.getElementById('diagOverlay').classList.remove('open');
    }

    // Giữ tương thích với các onclick cũ trên static card
    function closeDiag(id) { closeDiagModal(); }

    function saveDiagModal(action) {
        var id        = _diagCurrentId;
        var diagnosis = document.getElementById('dModalDiag').value.trim();
        var msgEl     = document.getElementById('dModalMsg');
        var newStatus = (action === 'done') ? 'HoanThanh' : _diagCurrentStatus;

        msgEl.textContent  = '⏳ Đang lưu...';
        msgEl.className    = 'diag-msg';

        var body = { appointmentId: id, newStatus: newStatus, diagnosis: diagnosis };
        fetch('/Doctor/SaveDiagnosis', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                msgEl.textContent = '✅ ' + (data.message || 'Lưu thành công');
                msgEl.className   = 'diag-msg ok';
                // Cập nhật nhanh card mà không reload
                var diagEl = document.getElementById('diagExisting-' + id);
                if (diagEl) { diagEl.innerHTML = '🩺 <strong>Chuẩn đoán:</strong> ' + escHtml(diagnosis); diagEl.style.display = diagnosis ? '' : 'none'; }
                setTimeout(function() {
                    closeDiagModal();
                    if (action === 'done') loadSchedule();
                }, 900);
            } else {
                msgEl.textContent = '❌ ' + (data.message || 'Lỗi lưu');
                msgEl.className   = 'diag-msg err';
            }
        })
        .catch(function() {
            msgEl.textContent = '❌ Lỗi kết nối';
            msgEl.className   = 'diag-msg err';
        });
    }

    // Tương thích cũ (static cards dùng onclick="saveDiag(id,'HoanThanh')")
    function saveDiag(id, newStatus) {
        _diagCurrentId     = id;
        _diagCurrentStatus = newStatus;
        saveDiagModal(newStatus === 'HoanThanh' ? 'done' : 'keep');
    }

    function postStatus(id, status, diagnosis, cb) {
        var body = { appointmentId: id, newStatus: status };
        if (diagnosis) body.diagnosis = diagnosis;
        fetch('/Doctor/SaveDiagnosis', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) { cb(data.success, data.message); })
        .catch(function() { cb(false, 'Lỗi kết nối'); });
    }

    function updateStats(data) {
        document.getElementById('statTotal').textContent = data.length;
        document.getElementById('statDen').textContent   = data.filter(function(a) { return a.status === 'DaDen'; }).length;
        document.getElementById('statKham').textContent  = data.filter(function(a) { return a.status === 'DangKham'; }).length;
        document.getElementById('statHoan').textContent  = data.filter(function(a) { return a.status === 'HoanThanh'; }).length;
    }

    // ── Lịch sử khám trước (tái khám) ──────────────────────────────
    var _histData = [];

    function openHistory(patientId, doctorId, patientName) {
        _histData = [];
        document.getElementById('histSub').textContent = 'Bệnh nhân: ' + patientName + ' — các lần khám đã hoàn thành';
        document.getElementById('histBody').innerHTML = '<div class="hist-loading">⏳ Đang tải lịch sử...</div>';
        document.getElementById('histModal').classList.add('open');

        fetch('/Doctor/PatientHistory?patientId=' + patientId + '&doctorId=' + doctorId)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data || !data.length) {
                    document.getElementById('histBody').innerHTML = '<div class="hist-empty">Không có lịch sử khám nào.</div>';
                    return;
                }
                _histData = data;
                var html = data.map(function(h, idx) {
                    var d = new Date(h.workDate);
                    var dateStr = d.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
                    var diagHtml = h.diagnosis
                        ? '<div class="hist-diag">🩺 <strong>Chuẩn đoán:</strong> ' + escHtml(h.diagnosis) + '</div>'
                        : '<div class="hist-diag" style="color:#aaa;font-style:italic;">Chưa có chuẩn đoán</div>';
                    var noteHtml = h.note
                        ? '<div class="hist-note">📋 ' + escHtml(h.note) + '</div>'
                        : '';
                    return '<div class="hist-item">' +
                        '<div class="hist-item-header">' +
                            '<span class="hist-date">📅 ' + dateStr + ' &nbsp; ' + escHtml(h.startTime) + ' – ' + escHtml(h.endTime) + '</span>' +
                            '<div style="display:flex;align-items:center;gap:6px;">' +
                                '<span class="hist-code">' + escHtml(h.bookingCode) + '</span>' +
                                '<button class="btn-eye-hist" onclick="openHistDetail(' + idx + ')">👁 Xem</button>' +
                            '</div>' +
                        '</div>' +
                        diagHtml + noteHtml +
                    '</div>';
                }).join('');
                document.getElementById('histBody').innerHTML = html;
            })
            .catch(function() {
                document.getElementById('histBody').innerHTML = '<div class="hist-empty">Lỗi kết nối, vui lòng thử lại.</div>';
            });
    }

    function closeHistory() {
        document.getElementById('histModal').classList.remove('open');
    }

    function openHistDetail(idx) {
        var h = _histData[idx];
        if (!h) return;
        var d = new Date(h.workDate);
        var dateStr = d.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
        var today = new Date();
        var todayStr = 'Hà Nội, ngày ' + today.getDate().toString().padStart(2,'0') +
                       ' tháng ' + (today.getMonth()+1).toString().padStart(2,'0') +
                       ' năm ' + today.getFullYear();

        document.getElementById('hd_code').textContent      = 'Mã phiếu: ' + (h.bookingCode || '');
        document.getElementById('hd_patient').textContent   = h.patientName  || '';
        document.getElementById('hd_date').textContent      = dateStr;
        document.getElementById('hd_time').textContent      = (h.startTime || '') + ' – ' + (h.endTime || '');
        document.getElementById('hd_booking').textContent   = h.bookingCode  || '';
        document.getElementById('hd_doctor').textContent    = h.doctorName   || '';
        document.getElementById('hd_specialty').textContent = h.specialty    || 'Tai Mũi Họng';

        var noteSection = document.getElementById('hd_note_section');
        if (h.note) {
            document.getElementById('hd_note').textContent = h.note;
            noteSection.style.display = '';
        } else {
            noteSection.style.display = 'none';
        }

        document.getElementById('hd_diagnosis').textContent    = h.diagnosis   || 'Chưa có kết quả chẩn đoán.';
        document.getElementById('hd_patient_sign').textContent = h.patientName || '';
        document.getElementById('hd_doctor_sign').textContent  = h.doctorName  || '';
        document.getElementById('hd_sign_date').textContent    = todayStr;

        document.getElementById('histDetailOverlay').classList.add('open');
    }

    function closeHistDetail() {
        document.getElementById('histDetailOverlay').classList.remove('open');
    }

    // Escape HTML để tránh XSS khi render dữ liệu từ server vào innerHTML
    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Bài viết ─────────────────────────────────────────────────────
    var articlesLoaded = false;
    var currentArticleId = null;

    function loadMyArticles() {
        document.getElementById('articleList').innerHTML = '<div class="empty-state">Đang tải...</div>';
        fetch('/Doctor/GetMyArticles')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.length) {
                    document.getElementById('articleList').innerHTML =
                        '<div class="empty-state">Chưa có bài viết nào. Bấm "+ Viết bài mới" để bắt đầu.</div>';
                    return;
                }
                document.getElementById('articleList').innerHTML = data.map(function(a) {
                    var badge = a.statusDisplay === 'Đã đăng'
                        ? '<span class="badge-pub">Đã đăng</span>'
                        : '<span class="badge-draft">Nháp</span>';
                    var date = a.publishedAt
                        ? new Date(a.publishedAt).toLocaleDateString('vi-VN')
                        : new Date(a.createdAt).toLocaleDateString('vi-VN');
                    return '<div class="article-card">' +
                        '<div style="flex:1">' +
                            '<div class="article-card-title">' + escHtml(a.title) + '</div>' +
                            '<div class="article-card-meta">' + escHtml(a.category) + ' · ' + date + ' · ' + badge + '</div>' +
                        '</div>' +
                        '<div style="display:flex;gap:6px;flex-shrink:0;">' +
                            '<button class="btn-action btn-diag" onclick="openEditor(' + a.id + ')">Sửa</button>' +
                            '<button class="btn-action btn-vang" style="background:#fdecea;color:#a32d2d;border-color:#f5c6c6;" onclick="deleteArticle(' + a.id + ')">Xóa</button>' +
                        '</div></div>';
                }).join('');
            })
            .catch(function() { document.getElementById('articleList').innerHTML = '<div class="empty-state">Lỗi kết nối</div>'; });
    }

    function openEditor(id) {
        currentArticleId = id;
        document.getElementById('editorErr').style.display = 'none';
        document.getElementById('editorOk').style.display  = 'none';
        document.getElementById('editorTitleLabel').textContent = id ? 'Sửa bài viết' : 'Viết bài mới';
        ['artTitle','artCategory','artThumbnail','artSummary','artContent'].forEach(function(f) {
            document.getElementById(f).value = '';
        });
        document.getElementById('artImageFile').value = '';
        document.getElementById('thumbPreview').style.display    = 'none';
        document.getElementById('thumbPlaceholder').style.display = 'block';
        document.getElementById('uploadErr').style.display        = 'none';

        if (id) {
            fetch('/Doctor/GetArticleDetail?id=' + id)
                .then(function(r) { return r.json(); })
                .then(function(a) {
                    document.getElementById('artTitle').value     = a.title     || '';
                    document.getElementById('artCategory').value  = a.category  || '';
                    document.getElementById('artThumbnail').value = a.thumbnail || '';
                    document.getElementById('artSummary').value   = a.summary   || '';
                    document.getElementById('artContent').value   = a.content   || '';
                    if (a.thumbnail) {
                        document.getElementById('thumbPreview').src           = a.thumbnail;
                        document.getElementById('thumbPreview').style.display    = 'block';
                        document.getElementById('thumbPlaceholder').style.display = 'none';
                    }
                });
        }
        document.getElementById('editorModal').classList.add('open');
    }

    function previewAndUpload(input) {
        var file = input.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('thumbPreview').src = e.target.result;
            document.getElementById('thumbPreview').style.display    = 'block';
            document.getElementById('thumbPlaceholder').style.display = 'none';
        };
        reader.readAsDataURL(file);

        document.getElementById('uploadProgress').style.display = 'block';
        document.getElementById('uploadErr').style.display = 'none';
        var formData = new FormData();
        formData.append('file', file);
        fetch('/Doctor/UploadArticleImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrfToken },
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            document.getElementById('uploadProgress').style.display = 'none';
            if (data.success) {
                document.getElementById('artThumbnail').value = data.url;
            } else {
                document.getElementById('uploadErr').textContent = data.message;
                document.getElementById('uploadErr').style.display = 'block';
                document.getElementById('thumbPreview').style.display    = 'none';
                document.getElementById('thumbPlaceholder').style.display = 'block';
            }
        })
        .catch(function() {
            document.getElementById('uploadProgress').style.display = 'none';
            document.getElementById('uploadErr').textContent = 'Lỗi kết nối khi tải ảnh.';
            document.getElementById('uploadErr').style.display = 'block';
        });
    }

    function closeEditor() { document.getElementById('editorModal').classList.remove('open'); }

    function saveArticle(publish) {
        var title    = document.getElementById('artTitle').value.trim();
        var category = document.getElementById('artCategory').value;
        var summary  = document.getElementById('artSummary').value.trim();
        var content  = document.getElementById('artContent').value.trim();
        var errEl    = document.getElementById('editorErr');
        errEl.style.display = 'none';

        if (!title)    { errEl.textContent = 'Vui lòng nhập tiêu đề.';  errEl.style.display = 'block'; return; }
        if (!category) { errEl.textContent = 'Vui lòng chọn chủ đề.';   errEl.style.display = 'block'; return; }
        if (!summary)  { errEl.textContent = 'Vui lòng nhập tóm tắt.';  errEl.style.display = 'block'; return; }
        if (!content)  { errEl.textContent = 'Vui lòng nhập nội dung.'; errEl.style.display = 'block'; return; }

        var url = currentArticleId ? '/Doctor/UpdateArticle?id=' + currentArticleId : '/Doctor/CreateArticle';
        var btn = publish ? document.getElementById('savePublishBtn') : document.getElementById('saveDraftBtn');
        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify({
                title: title, category: category, summary: summary, content: content, publish: publish,
                thumbnail: document.getElementById('artThumbnail').value.trim() || null
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById('editorOk').textContent = data.message;
                document.getElementById('editorOk').style.display = 'block';
                setTimeout(function() { closeEditor(); loadMyArticles(); }, 1200);
            } else {
                errEl.textContent = data.message || 'Có lỗi xảy ra.';
                errEl.style.display = 'block';
            }
        })
        .catch(function() { errEl.textContent = 'Lỗi kết nối.'; errEl.style.display = 'block'; })
        .finally(function() { btn.disabled = false; });
    }

    function deleteArticle(id) {
        if (!confirm('Xác nhận xóa bài viết này?')) return;
        fetch('/Doctor/DeleteArticle?id=' + id, {
            method: 'POST', headers: { 'RequestVerificationToken': csrfToken }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) { if (data.success) loadMyArticles(); else alert(data.message); });
    }
