@model List<TMH.Shared.DTOs.AppointmentDetailDto>
@{
    ViewBag.Title = "Dashboard Bác sĩ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    .doc-wrap { max-width: 1000px; margin: 32px auto; padding: 0 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
    .page-title { font-family: 'Crimson Pro', serif; font-size: 26px; font-weight: 600; color: #0a4d7c; }
    .page-sub   { font-size: 13px; color: #7a9bb0; margin-top: 2px; }

    /* Sub-tabs */
    .sub-tab-bar { display: flex; border-bottom: 2px solid #d4e8f5; margin-bottom: 20px; }
    .sub-tab-btn { padding: 10px 20px; font-size: 13px; font-weight: 500; color: #7a9bb0; background: none; border: none; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; font-family: 'DM Sans', sans-serif; transition: all .15s; }
    .sub-tab-btn:hover { color: #0a4d7c; }
    .sub-tab-btn.active { color: #0a4d7c; border-bottom-color: #0a4d7c; }

    /* Toolbar */
    .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; background: #fff; border: 1px solid #d4e8f5; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; }
    .toolbar label { font-size: 12px; font-weight: 500; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; }
    .toolbar input[type=date] { height: 36px; border: 1px solid #d4e8f5; border-radius: 8px; padding: 0 10px; font-size: 13px; color: #0d2d44; outline: none; font-family: 'DM Sans', sans-serif; }
    .btn-load { height: 36px; padding: 0 18px; background: #0a4d7c; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-load:hover { background: #1a6fa8; }

    /* Stats */
    .stats-bar { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .stat-card { flex: 1; min-width: 110px; background: #fff; border: 1px solid #d4e8f5; border-radius: 10px; padding: 12px 16px; text-align: center; }
    .stat-num { font-size: 24px; font-weight: 700; color: #0a4d7c; }
    .stat-lbl { font-size: 11px; color: #7a9bb0; margin-top: 2px; }
    .stat-card.den  .stat-num { color: #004085; }
    .stat-card.kham .stat-num { color: #155724; }
    .stat-card.hoan .stat-num { color: #383d41; }

    /* Patient cards */
    .patient-list { display: flex; flex-direction: column; gap: 14px; }
    .patient-card { background: #fff; border: 1px solid #d4e8f5; border-radius: 16px; padding: 18px 20px; display: flex; gap: 16px; align-items: flex-start; transition: all .2s ease; }
    .patient-card:hover { border-color: #1a6fa8; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(10,77,124,.12); }
    .patient-card.card-waiting  { border-left: 4px solid #1a6fa8; }
    .patient-card.card-started  { border-left: 4px solid #2d7a52; }
    .patient-card.card-done     { border-left: 4px solid #aab8c2; opacity: .85; }
    .patient-card.card-inactive { border-left: 4px solid #e74c3c; opacity: .7; }

    /* Patient avatar with initials */
    .pc-avatar { width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; color: #fff; flex-shrink: 0; margin-top: 2px; letter-spacing: .03em; box-shadow: 0 2px 8px rgba(0,0,0,.15); }
    .pc-av-den  { background: linear-gradient(135deg, #1a6fa8, #0a4d7c); }
    .pc-av-kham { background: linear-gradient(135deg, #2d9e6b, #1e6b48); }
    .pc-av-hoan { background: linear-gradient(135deg, #868e96, #5a6268); }
    .pc-av-huy  { background: linear-gradient(135deg, #e74c3c, #c0392b); }
    .pc-av-cho  { background: linear-gradient(135deg, #c9a227, #a67c00); }

    .patient-info { flex: 1; min-width: 0; }
    /* Card header: name left, status badge right */
    .pc-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
    .patient-name { font-size: 15px; font-weight: 600; color: #0a4d7c; line-height: 1.35; }
    .patient-meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; color: #7a9bb0; margin-bottom: 10px; align-items: center; }

    /* Time pill */
    .pc-time-pill { display: inline-flex; align-items: center; gap: 4px; background: #e8f4fd; color: #0a4d7c; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; white-space: nowrap; }

    .booking-code { font-family: monospace; font-size: 11px; background: #f0f8ff; padding: 2px 8px; border-radius: 4px; color: #1a6fa8; border: 1px solid #d4e8f5; }

    /* Symptom / note — amber callout */
    .patient-note { font-size: 12px; color: #6d4c00; background: #fffbeb; border-left: 3px solid #f0a500; padding: 7px 12px; border-radius: 0 8px 8px 0; margin-bottom: 8px; line-height: 1.55; }

    .badge { display: inline-block; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }
    .badge-den  { background: #cce5ff; color: #004085; }
    .badge-kham { background: #d4edda; color: #155724; }
    .badge-hoan { background: #e2e3e5; color: #383d41; }
    .badge-cho  { background: #fff3cd; color: #856404; }
    .badge-vang { background: #fdecea; color: #a32d2d; }
    .badge-huy  { background: #f8d7da; color: #721c24; }

    /* Actions — bác sĩ */
    .patient-actions { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; min-width: 150px; flex-shrink: 0; }
    .btn-action { height: 32px; padding: 0 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; border: 1px solid; font-family: 'DM Sans', sans-serif; white-space: nowrap; transition: all .15s; }

    /* Bắt đầu khám: DaDen → DangKham */
    .btn-start { background: #cce5ff; color: #004085; border-color: #99caef; }
    .btn-start:hover { background: #004085; color: #fff; }

    /* Hoàn thành: DangKham → HoanThanh */
    .btn-done  { background: #d4edda; color: #155724; border-color: #b8ddc4; }
    .btn-done:hover { background: #155724; color: #fff; }

    /* Ghi chuẩn đoán (mở panel) */
    .btn-diag  { background: #0a4d7c; color: #fff; border-color: #0a4d7c; }
    .btn-diag:hover { background: #1a6fa8; }

    .lbl-staff { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #856404; background: #fff3cd; border: 1px solid #ffc107; border-radius: 12px; padding: 4px 10px; font-weight: 500; }

    /* Diagnosis existing (inline display on card) */
    .diag-existing { font-size: 12px; color: #2d7a52; background: #f0faf4; border-left: 3px solid #2d7a52; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-bottom: 6px; }

    /* ── Modal ghi chuẩn đoán ─────────────────────────────────── */
    .diag-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.52); z-index: 9998; align-items: center; justify-content: center; padding: 20px; overflow-y: auto; backdrop-filter: blur(2px); }
    .diag-overlay.open { display: flex; }
    .diag-modal { background: #fff; border-radius: 18px; padding: 0; width: 580px; max-width: 96vw; box-shadow: 0 24px 64px rgba(0,0,0,.22); overflow: hidden; }
    .diag-modal-head { background: linear-gradient(135deg, #0a4d7c, #1a6fa8); padding: 20px 24px; display: flex; align-items: center; gap: 12px; }
    .diag-modal-icon { width: 40px; height: 40px; background: rgba(255,255,255,.18); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .diag-modal-title { color: #fff; font-size: 16px; font-weight: 700; margin: 0; }
    .diag-modal-sub   { color: rgba(255,255,255,.75); font-size: 12px; margin-top: 2px; }
    .diag-modal-body  { padding: 22px 24px; }
    .diag-info-grid   { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; background: #f5faff; border: 1px solid #d4e8f5; border-radius: 10px; padding: 14px 16px; margin-bottom: 18px; }
    .diag-info-item   { font-size: 12px; }
    .diag-info-label  { color: #7a9bb0; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .04em; display: block; margin-bottom: 2px; }
    .diag-info-value  { color: #0d2d44; font-weight: 500; }
    .diag-symptom-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 10px 14px; margin-bottom: 18px; font-size: 13px; color: #6d4c00; line-height: 1.6; }
    .diag-symptom-lbl { font-size: 11px; font-weight: 600; color: #a67c00; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px; display: block; }
    .diag-field-label { font-size: 12px; font-weight: 600; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; display: block; }
    .diag-field-wrap  { margin-bottom: 16px; }
    .diag-textarea    { width: 100%; border: 1.5px solid #d4e8f5; border-radius: 10px; padding: 10px 14px; font-size: 13px; outline: none; font-family: 'DM Sans', sans-serif; resize: vertical; min-height: 80px; box-sizing: border-box; color: #0d2d44; transition: border-color .15s; }
    .diag-textarea:focus { border-color: #1a6fa8; box-shadow: 0 0 0 3px rgba(26,111,168,.1); }
    .diag-modal-footer { padding: 16px 24px; border-top: 1px solid #eef3f8; display: flex; gap: 10px; justify-content: flex-end; align-items: center; background: #fafcff; }
    .diag-msg { font-size: 12px; margin-right: auto; }
    .diag-msg.ok  { color: #2d7a52; }
    .diag-msg.err { color: #c0392b; }
    .btn-diag-cancel { height: 38px; padding: 0 18px; background: #f0f0f0; color: #555; border: none; border-radius: 9px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-diag-save   { height: 38px; padding: 0 18px; background: #0a4d7c; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-diag-save:hover   { background: #1a6fa8; }
    .btn-diag-done   { height: 38px; padding: 0 18px; background: #2d7a52; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .btn-diag-done:hover   { background: #1e5c3a; }
    .empty-state { text-align: center; padding: 48px 20px; color: #7a9bb0; font-size: 13px; background: #fff; border: 1px solid #d4e8f5; border-radius: 14px; }

    /* ── Loại khám badge ───────────────────────────────────────── */
    .badge-taikham { background: #e8f5e9; color: #2d7a52; border: 1px solid #b2dfdb; font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 20px; white-space: nowrap; }
    .badge-khamoi  { background: #e3f2fd; color: #1565c0; border: 1px solid #bbdefb; font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 20px; white-space: nowrap; }

    /* ── Nút xem lịch sử (tái khám) ───────────────────────────── */
    .btn-history { height: 30px; padding: 0 12px; background: #e8f5e9; color: #2d7a52; border: 1px solid #b2dfdb; border-radius: 7px; font-size: 12px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; white-space: nowrap; transition: all .15s; }
    .btn-history:hover { background: #2d7a52; color: #fff; }

    /* ── Modal lịch sử khám ────────────────────────────────────── */
    .hist-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9995; align-items: flex-start; justify-content: center; padding: 24px 16px; overflow-y: auto; }
    .hist-overlay.open { display: flex; }
    .hist-box { background: #fff; border-radius: 16px; padding: 28px; width: 640px; max-width: 96vw; margin: auto; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    .hist-title { font-size: 16px; font-weight: 700; color: #0a4d7c; margin-bottom: 4px; }
    .hist-sub   { font-size: 12px; color: #7a9bb0; margin-bottom: 20px; }
    .hist-item  { border: 1px solid #d4e8f5; border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; background: #f8fbff; }
    .hist-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .hist-date  { font-size: 13px; font-weight: 600; color: #0a4d7c; }
    .hist-code  { font-family: monospace; font-size: 11px; background: #f0f8ff; padding: 2px 8px; border-radius: 4px; color: #1a6fa8; border: 1px solid #d4e8f5; }
    .hist-diag  { font-size: 13px; color: #0d2d44; background: #fff; border-left: 3px solid #2d7a52; padding: 7px 12px; border-radius: 0 8px 8px 0; margin-bottom: 6px; line-height: 1.55; }
    .hist-note  { font-size: 12px; color: #6d4c00; background: #fffbeb; border-left: 3px solid #f0a500; padding: 6px 10px; border-radius: 0 7px 7px 0; line-height: 1.5; }
    .hist-empty { text-align: center; color: #7a9bb0; font-size: 13px; padding: 24px; }
    .hist-footer { text-align: right; margin-top: 16px; }
    .btn-hist-close { height: 36px; padding: 0 20px; background: #f0f0f0; color: #555; border: none; border-radius: 9px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .hist-loading { text-align: center; color: #7a9bb0; font-size: 13px; padding: 24px; }

    /* ── Nút mắt xem chi tiết (trong hist-item) ──────────────── */
    .btn-eye-hist { height: 26px; padding: 0 9px; background: #e8f4fd; color: #0a4d7c; border: 1px solid #b8d8f0; border-radius: 6px; font-size: 11px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; white-space: nowrap; transition: all .15s; }
    .btn-eye-hist:hover { background: #0a4d7c; color: #fff; }

    /* ── Overlay chi tiết lịch sử (z-index cao hơn histModal) ─── */
    .hd-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.62); z-index: 10000; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 24px 16px; backdrop-filter: blur(3px); }
    .hd-overlay.open { display: flex; }
    .hd-ctrl { display: flex; gap: 10px; justify-content: flex-end; max-width: 720px; margin: 0 auto 12px; }
    .hd-ctrl-btn { height: 38px; padding: 0 18px; background: rgba(255,255,255,.9); color: #555; border: none; border-radius: 9px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .hd-sheet { background: #fff; width: 720px; max-width: 100%; border-radius: 12px; padding: 44px 48px; font-family: 'Times New Roman', serif; margin: 0 auto; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    .hd-top { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0a4d7c; padding-bottom: 18px; margin-bottom: 22px; }
    .hd-clinic-name { font-size: 15px; font-weight: bold; color: #0a4d7c; text-transform: uppercase; letter-spacing: .03em; }
    .hd-clinic-addr { font-size: 11px; color: #666; margin-top: 4px; line-height: 1.5; font-family: 'DM Sans', sans-serif; }
    .hd-logo-box { width: 52px; height: 52px; background: #0a4d7c; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; flex-shrink: 0; }
    .hd-title-main { text-align: center; font-size: 20px; font-weight: bold; color: #0a2d4a; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
    .hd-code-line { text-align: center; font-family: 'DM Sans', sans-serif; font-size: 12px; color: #7a9bb0; margin-bottom: 24px; }
    .hd-section { margin-bottom: 20px; }
    .hd-section-hd { font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #0a4d7c; background: #f0f8ff; padding: 5px 10px; border-radius: 4px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
    .hd-row { display: flex; gap: 8px; margin-bottom: 7px; font-size: 13px; padding: 0 6px; font-family: 'DM Sans', sans-serif; }
    .hd-lbl { color: #555; min-width: 170px; flex-shrink: 0; }
    .hd-val { color: #111; font-weight: 500; flex: 1; }
    .hd-diag-box { border: 1.5px solid #0a4d7c; border-radius: 8px; padding: 14px 16px; font-size: 14px; color: #0a2d4a; line-height: 1.7; min-height: 70px; margin: 4px 0; background: #fafcff; }
    .hd-note-box { border: 1px solid #d4e8f5; border-radius: 8px; padding: 12px 14px; font-size: 13px; color: #333; min-height: 50px; background: #fffbeb; border-color: #fde68a; line-height: 1.6; margin: 4px 0; font-family: 'DM Sans', sans-serif; }
    .hd-footer { margin-top: 36px; display: flex; justify-content: space-between; border-top: 1px dashed #d4e8f5; padding-top: 20px; }
    .hd-sign { text-align: center; min-width: 160px; }
    .hd-sign-title { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 700; color: #0a2d4a; }
    .hd-sign-note { font-family: 'DM Sans', sans-serif; font-size: 11px; color: #7a9bb0; margin-top: 2px; }
    .hd-sign-space { height: 56px; }
    .hd-sign-name { font-size: 13px; font-weight: 600; border-top: 1px solid #333; padding-top: 4px; display: inline-block; min-width: 120px; }

    /* ── Card border (bao ngoài dashboard) ────────────────────── */
    .doc-card-wrap { background: #f5faff; border: 1px solid #c8dff0; border-radius: 18px; box-shadow: 0 4px 24px rgba(10,77,124,.08); padding: 28px 28px 24px; }

    /* ── Lịch làm việc ─────────────────────────────────────────── */
    .sch-toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; background: #fff; border: 1px solid #d4e8f5; border-radius: 12px; padding: 14px 18px; margin-bottom: 18px; }
    .sch-label { font-size: 11px; font-weight: 600; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
    .sch-date { height: 36px; border: 1px solid #d4e8f5; border-radius: 8px; padding: 0 10px; font-size: 13px; color: #0d2d44; outline: none; font-family: 'DM Sans', sans-serif; }
    .sch-date:focus { border-color: #1a6fa8; }

    .sch-tbl-wrap { background: #fff; border: 1px solid #d4e8f5; border-radius: 14px; overflow: hidden; }
    .sch-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sch-table thead { background: #f0f8ff; }
    .sch-table th { padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid #d4e8f5; white-space: nowrap; }
    .sch-table td { padding: 11px 14px; border-bottom: 1px solid #f0f4f8; color: #0d2d44; vertical-align: middle; }
    .sch-table tr:last-child td { border-bottom: none; }
    .sch-table tr:hover td { background: #f8fbff; }

    /* Schedule add modal */
    .sch-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9990; align-items: center; justify-content: center; overflow-y: auto; }
    .sch-overlay.open { display: flex; }
    .sch-modal-box { background: #fff; border-radius: 18px; padding: 28px; width: 560px; max-width: 96vw; margin: 20px auto; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    .sch-modal-title { font-size: 16px; font-weight: 700; color: #0a4d7c; margin-bottom: 4px; }
    .sch-modal-sub   { font-size: 12px; color: #7a9bb0; margin-bottom: 22px; }
    .sch-form-section { margin-bottom: 20px; }
    .sch-section-title { font-size: 11px; font-weight: 700; color: #3a5a72; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #eef3f8; }
    .sch-form-inp { width: 100%; border: 1.5px solid #d4e8f5; border-radius: 9px; padding: 9px 12px; font-size: 13px; font-family: 'DM Sans', sans-serif; box-sizing: border-box; outline: none; }
    .sch-form-inp:focus { border-color: #1a6fa8; box-shadow: 0 0 0 3px rgba(26,111,168,.1); }
    .sch-alert { border-radius: 9px; padding: 10px 14px; font-size: 12px; margin-bottom: 14px; display: none; }
    .sch-alert-err { background: #fdecea; border: 1px solid #f5c6c6; color: #c0392b; }
    .sch-alert-ok  { background: #d4edda; border: 1px solid #b8ddc4; color: #155724; }
    .sch-wd-chip { font-size: 12px; cursor: pointer; border: 1.5px solid #d4e8f5; border-radius: 8px; padding: 5px 11px; user-select: none; transition: all .15s; background: #fff; display: inline-flex; align-items: center; gap: 5px; }
    .sch-wd-chip.selected { background: #e8f4fd; border-color: #0a4d7c; color: #0a4d7c; font-weight: 600; }
    .sch-shift-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; background: #f8fbff; border-radius: 8px; padding: 8px 12px; }
    .sch-time-inp { height: 34px; border: 1.5px solid #d4e8f5; border-radius: 7px; padding: 0 10px; font-size: 13px; outline: none; font-family: 'DM Sans', sans-serif; }
    .sch-time-inp:focus { border-color: #1a6fa8; }
    .sch-preview-box { background: #f0f8ff; border: 1px solid #d4e8f5; border-radius: 9px; padding: 12px 16px; font-size: 13px; color: #0a4d7c; display: none; }
    .sch-modal-footer { display: flex; gap: 10px; margin-top: 22px; }
    .sch-btn-save   { flex: 2; height: 42px; background: #0a4d7c; color: #fff; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .sch-btn-save:hover { background: #1a6fa8; }
    .sch-btn-cancel { flex: 1; height: 42px; background: #f0f0f0; color: #555; border: none; border-radius: 10px; font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; }

    /* Articles */
    .article-card { background: #fff; border: 1px solid #d4e8f5; border-radius: 12px; padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
    .article-card:hover { border-color: #1a6fa8; }
    .article-card-title { font-size: 14px; font-weight: 500; color: #0a4d7c; margin-bottom: 4px; }
    .article-card-meta  { font-size: 11px; color: #7a9bb0; }
    .badge-pub   { background: #d4edda; color: #155724; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 500; }
    .badge-draft { background: #e2e3e5; color: #383d41; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 500; }

    /* Editor modal */
    .editor-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9999; align-items: flex-start; justify-content: center; padding: 20px; overflow-y: auto; }
    .editor-overlay.open { display: flex; }
    .editor-box { background: #fff; border-radius: 16px; padding: 28px; width: 720px; max-width: 95vw; margin: auto; }
    .editor-title-lbl { font-size: 16px; font-weight: 600; color: #0a4d7c; margin-bottom: 20px; }
    .editor-form-row { display: flex; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
    .editor-form-group { flex: 1; min-width: 200px; }
    .editor-label { font-size: 11px; font-weight: 500; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; display: block; margin-bottom: 5px; }
    .editor-input { width: 100%; border: 1px solid #d4e8f5; border-radius: 8px; padding: 8px 12px; font-size: 13px; outline: none; font-family: 'DM Sans', sans-serif; box-sizing: border-box; height: 38px; }
    .editor-input:focus { border-color: #1a6fa8; }
    textarea.editor-input { height: auto; min-height: 80px; resize: vertical; }
    #artContent { min-height: 200px; }
    .editor-footer { display: flex; gap: 10px; margin-top: 20px; }

    /* ── Nút kê đơn thuốc ──────────────────────────────────────── */
    .btn-prescription {
        height: 32px; padding: 0 14px;
        background: #e8f5e9; color: #1b5e20;
        border: 1px solid #a5d6a7; border-radius: 8px;
        font-size: 12px; font-weight: 500; cursor: pointer;
        font-family: 'DM Sans', sans-serif; white-space: nowrap; transition: all .15s;
    }
    .btn-prescription:hover { background: #2d7a52; color: #fff; border-color: #2d7a52; }

    /* ── Modal đơn thuốc ────────────────────────────────────────── */
    .rx-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 9998; align-items: flex-start; justify-content: center; padding: 20px 16px; overflow-y: auto; backdrop-filter: blur(2px); }
    .rx-overlay.open { display: flex; }
    .rx-box { background: #fff; border-radius: 18px; width: 680px; max-width: 96vw; margin: auto; box-shadow: 0 24px 64px rgba(0,0,0,.22); overflow: hidden; }
    .rx-head { background: linear-gradient(135deg, #1b5e20, #2d7a52); padding: 20px 24px; display: flex; align-items: center; gap: 12px; }
    .rx-head-icon { width: 40px; height: 40px; background: rgba(255,255,255,.18); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .rx-head-title { color: #fff; font-size: 16px; font-weight: 700; }
    .rx-head-sub { color: rgba(255,255,255,.75); font-size: 12px; margin-top: 2px; }
    .rx-body { padding: 20px 24px; }
    .rx-patient-info { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; background: #f5faff; border: 1px solid #d4e8f5; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; }
    .rx-info-lbl { font-size: 11px; color: #7a9bb0; text-transform: uppercase; letter-spacing: .04em; font-weight: 500; display: block; margin-bottom: 2px; }
    .rx-info-val { font-size: 12px; font-weight: 600; color: #0d2d44; }
    .rx-diag-box { background: #f0faf4; border-left: 3px solid #2d7a52; padding: 8px 12px; border-radius: 0 8px 8px 0; font-size: 12px; color: #1b5e20; margin-bottom: 16px; }
    .rx-section-lbl { font-size: 11px; font-weight: 700; color: #3a5a72; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
    .rx-items-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 12px; }
    .rx-items-table thead { background: #f0f8ff; }
    .rx-items-table th { padding: 7px 8px; text-align: left; font-size: 11px; font-weight: 600; color: #3a5a72; border-bottom: 1px solid #d4e8f5; }
    .rx-items-table td { padding: 6px 8px; border-bottom: 1px solid #f0f4f8; vertical-align: top; }
    .rx-items-table tr:last-child td { border-bottom: none; }
    .rx-item-inp { width: 100%; border: 1px solid #d4e8f5; border-radius: 6px; padding: 5px 8px; font-size: 12px; font-family: 'DM Sans', sans-serif; outline: none; box-sizing: border-box; }
    .rx-item-inp:focus { border-color: #2d7a52; }
    .rx-item-num { width: 100%; border: 1px solid #d4e8f5; border-radius: 6px; padding: 5px 8px; font-size: 12px; font-family: 'DM Sans', sans-serif; outline: none; box-sizing: border-box; text-align: center; }
    .rx-item-num:focus { border-color: #2d7a52; }
    .rx-del-btn { background: #fdecea; color: #c0392b; border: 1px solid #f5c6c6; border-radius: 5px; width: 26px; height: 26px; cursor: pointer; font-size: 14px; }
    .rx-notes-inp { width: 100%; border: 1.5px solid #d4e8f5; border-radius: 8px; padding: 8px 12px; font-size: 12px; font-family: 'DM Sans', sans-serif; outline: none; resize: vertical; min-height: 60px; box-sizing: border-box; }
    .rx-notes-inp:focus { border-color: #2d7a52; }
    .rx-footer { padding: 14px 24px; border-top: 1px solid #eef3f8; display: flex; gap: 8px; justify-content: flex-end; background: #fafcff; flex-wrap: wrap; }
    .rx-msg { font-size: 12px; margin-right: auto; align-self: center; }
    .rx-msg.ok  { color: #2d7a52; }
    .rx-msg.err { color: #c0392b; }
    .rx-btn-cancel { height: 36px; padding: 0 16px; background: #f0f0f0; color: #555; border: none; border-radius: 8px; font-size: 12px; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .rx-btn-save   { height: 36px; padding: 0 18px; background: #2d7a52; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .rx-btn-save:hover { background: #1b5e20; }
    .rx-btn-print  { height: 36px; padding: 0 18px; background: #c9a227; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .rx-btn-print:hover { background: #a8841e; }

    /* ── Nút in phiếu (bác sĩ) ────────────────────────────────── */
    .btn-print-phieu {
        height: 30px; padding: 0 12px;
        background: #c9a227; color: #fff;
        border: none; border-radius: 7px; font-size: 12px;
        font-weight: 500; cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        white-space: nowrap; transition: background .15s;
    }
    .btn-print-phieu:hover { background: #a8841e; }

    /* ── Modal phiếu khám bệnh ─────────────────────────────────── */
    .phieu-modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.55); z-index: 9999;
        align-items: flex-start; justify-content: center;
        overflow-y: auto; padding: 24px 16px;
        backdrop-filter: blur(3px);
    }
    .phieu-modal-overlay.open { display: flex; }

    .phieu-controls {
        display: flex; gap: 10px; justify-content: flex-end;
        max-width: 680px; margin: 0 auto 12px;
    }
    .phieu-btn-print {
        height: 38px; padding: 0 20px;
        background: #0a4d7c; color: #fff;
        border: none; border-radius: 9px; font-size: 13px;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        display: flex; align-items: center; gap: 6px;
    }
    .phieu-btn-close {
        height: 38px; padding: 0 18px;
        background: rgba(255,255,255,.9); color: #555;
        border: none; border-radius: 9px; font-size: 13px;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
    }

    /* Tờ phiếu kiểu giấy tờ y tế */
    .phieu-sheet {
        background: #fff;
        width: 680px; max-width: 100%;
        border-radius: 4px;
        padding: 36px 44px;
        font-family: 'Times New Roman', Times, serif;
        margin: 0 auto;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
        border: 1px solid #ccc;
        position: relative;
    }

    /* Quốc hiệu */
    .phieu-quochieu {
        text-align: center;
        margin-bottom: 18px;
    }
    .phieu-quochieu-top {
        font-size: 13px; font-weight: bold;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .phieu-quochieu-sub {
        font-size: 13px; font-weight: bold;
        margin-top: 2px;
    }
    .phieu-quochieu-doc {
        font-size: 12px; font-style: italic;
        border-bottom: 1px solid #333;
        display: inline-block;
        padding-bottom: 2px;
        margin-top: 2px;
    }

    /* Header 2 cột */
    .phieu-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1.5px solid #333;
        padding-bottom: 14px;
        margin-bottom: 18px;
    }
    .phieu-benh-vien {
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        line-height: 1.5;
    }
    .phieu-benh-vien-sub {
        font-size: 11px;
        font-weight: normal;
        text-transform: none;
        color: #333;
        margin-top: 3px;
        line-height: 1.5;
    }

    /* Tên phiếu */
    .phieu-ten {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 20px;
    }

    /* Các dòng thông tin kiểu gạch chân */
    .phieu-line {
        font-size: 13px;
        margin-bottom: 10px;
        display: flex;
        align-items: baseline;
        gap: 0;
        line-height: 1.8;
    }
    .phieu-line-label {
        flex-shrink: 0;
        font-weight: normal;
    }
    .phieu-line-value {
        flex: 1;
        border-bottom: 1px solid #333;
        min-width: 60px;
        padding: 0 4px;
        font-weight: 500;
    }
    .phieu-line-unit {
        flex-shrink: 0;
        margin-left: 6px;
    }

    /* Dòng inline (cùng hàng nhiều field) */
    .phieu-line-inline {
        font-size: 13px;
        margin-bottom: 10px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        line-height: 1.8;
    }
    .phieu-inline-seg {
        display: flex;
        align-items: baseline;
        gap: 0;
        flex: 1;
        min-width: 120px;
    }

    /* Phần chuẩn đoán */
    .phieu-chandoan-box {
        border: 1.5px solid #333;
        border-radius: 2px;
        min-height: 60px;
        padding: 8px 12px;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 4px;
        margin-bottom: 14px;
        color: #0a2d4a;
        font-weight: 500;
    }

    /* Chữ ký */
    .phieu-chukybottom {
        display: flex;
        justify-content: space-between;
        margin-top: 28px;
    }
    .phieu-chuky-col {
        text-align: center;
        min-width: 150px;
    }
    .phieu-chuky-title {
        font-size: 13px; font-weight: bold;
        text-transform: uppercase;
    }
    .phieu-chuky-note {
        font-size: 11px; font-style: italic;
        color: #555; margin-top: 2px;
    }
    .phieu-chuky-space { height: 64px; }
    .phieu-chuky-name {
        font-size: 13px; font-weight: bold;
        border-top: 1px solid #333;
        padding-top: 4px;
        display: inline-block;
        min-width: 130px;
    }

    /* Ngày tháng bên phải */
    .phieu-ngay {
        text-align: right;
        font-size: 12px;
        font-style: italic;
        margin-bottom: 4px;
    }

    @@media print {
        body * { visibility: hidden; }
        .phieu-sheet, .phieu-sheet * { visibility: visible; }
        .phieu-sheet {
            position: fixed; left: 0; top: 0;
            width: 100%; padding: 20px 32px;
            border-radius: 0; box-shadow: none; border: none;
        }
        .phieu-controls { display: none !important; }
    }
</style>
}

<div class="doc-wrap">
  <div class="doc-card-wrap">
    <div class="page-header">
        <div>
            <div class="page-title">🩺 Dashboard bác sĩ</div>
            <div class="page-sub">BS. @ViewBag.UserName — Phòng khám Tai Mũi Họng</div>
        </div>
    </div>

    <!-- Sub-tabs -->
    <div class="sub-tab-bar">
        <button class="sub-tab-btn active" onclick="showDocTab('schedule', this)">📅 Lịch khám</button>
        <button class="sub-tab-btn" onclick="showDocTab('mySchedules', this)">🗓 Lịch làm việc</button>
        @* <button class="sub-tab-btn" onclick="showDocTab('articles', this)">📝 Bài viết y tế</button> *@
    </div>

    <!-- ── Panel: Lịch khám ─────────────────────────────────────── -->
    <div id="panelSchedule">
        <div class="toolbar">
            <label>Ngày khám</label>
            <input type="date" id="filterDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <button class="btn-load" onclick="loadSchedule()">Xem lịch</button>
            <span style="margin-left:auto;font-size:13px;color:#7a9bb0;">@ViewBag.TodayDate</span>
        </div>

        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-num" id="statTotal">@Model.Count</div>
                <div class="stat-lbl">Tổng lịch</div>
            </div>
            <div class="stat-card den">
                <div class="stat-num" id="statDen">@Model.Count(a => a.Status == "DaDen")</div>
                <div class="stat-lbl">Đã đến — chờ khám</div>
            </div>
            <div class="stat-card kham">
                <div class="stat-num" id="statKham">@Model.Count(a => a.Status == "DangKham")</div>
                <div class="stat-lbl">Đang khám</div>
            </div>
            <div class="stat-card hoan">
                <div class="stat-num" id="statHoan">@Model.Count(a => a.Status == "HoanThanh")</div>
                <div class="stat-lbl">Hoàn thành</div>
            </div>
        </div>

        <div class="patient-list" id="patientList">
            @if (!Model.Any())
            {
                <div class="empty-state">Không có lịch khám nào hôm nay</div>
            }
            else
            {
                @for (int i = 0; i < Model.Count; i++)
                {
                    var a = Model[i];
                    var badgeClass = a.Status switch {
                        "DaDen"     => "badge-den",
                        "DangKham"  => "badge-kham",
                        "HoanThanh" => "badge-hoan",
                        "VangMat"   => "badge-vang",
                        "DaHuy"     => "badge-huy",
                        _           => "badge-cho"
                    };
                    var cardClass = a.Status switch {
                        "DaDen"     => "card-waiting",
                        "DangKham"  => "card-started",
                        "HoanThanh" => "card-done",
                        "DaHuy" or "VangMat" => "card-inactive",
                        _           => ""
                    };
                    var avatarClass = a.Status switch {
                        "DaDen"     => "pc-av-den",
                        "DangKham"  => "pc-av-kham",
                        "HoanThanh" => "pc-av-hoan",
                        "DaHuy" or "VangMat" => "pc-av-huy",
                        _           => "pc-av-cho"
                    };
                    var nameParts = (a.PatientName ?? "?").Trim().Split(new char[]{' '}, StringSplitOptions.RemoveEmptyEntries);
                    var initials = nameParts.Length >= 2
                        ? $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[nameParts.Length - 1][0])}"
                        : (nameParts.Length == 1 && nameParts[0].Length > 0 ? $"{char.ToUpper(nameParts[0][0])}" : "?");

                    <div class="patient-card @cardClass" id="card-@a.Id">
                        <div class="pc-avatar @avatarClass">@initials</div>
                        <div class="patient-info">
                            <div class="pc-header">
                                <div class="patient-name">@a.PatientName</div>
                                <span class="badge @badgeClass" id="badge-@a.Id">@a.StatusDisplay</span>
                            </div>
                            <div class="patient-meta">
                                <span class="pc-time-pill">⏰ @a.StartTime – @a.EndTime</span>
                                <span class="booking-code">@a.BookingCode</span>
                                @if (a.IsReturn)
                                {
                                    <span class="badge-taikham">♻ Tái khám</span>
                                }
                                else
                                {
                                    <span class="badge-khamoi">🆕 Khám mới</span>
                                }
                            </div>
                            @if (a.IsReturn)
                            {
                                <div style="margin-bottom:8px;">
                                    <button class="btn-history"
                                        onclick="openHistory(@a.PatientId, @a.DoctorId, '@Html.Raw(a.PatientName)')">
                                        📂 Xem lịch sử khám trước
                                    </button>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(a.Note))
                            {
                                <div class="patient-note">📋 @a.Note</div>
                            }
                            @if (!string.IsNullOrEmpty(a.Diagnosis))
                            {
                                <div class="diag-existing" id="diagExisting-@a.Id">🩺 <strong>Chuẩn đoán:</strong> @a.Diagnosis</div>
                            }
                            else
                            {
                                <div class="diag-existing" id="diagExisting-@a.Id" style="display:none;"></div>
                            }
                        </div>

                        <!-- Thao tác bác sĩ theo đúng vòng đời -->
                        <div class="patient-actions">
                            @if (a.Status == "DaDen")
                            {
                                <button class="btn-action btn-start" onclick="startExam(@a.Id)">▶ Bắt đầu khám</button>
                            }
                            @if (a.Status == "DangKham")
                            {
                                <button class="btn-action btn-diag" onclick="openDiag(@a.Id)">📋 Ghi chuẩn đoán</button>
                                <button class="btn-action btn-prescription" onclick="openRx(@a.Id)">💊 Kê đơn thuốc</button>
                                <button class="btn-action btn-done" onclick="finishExam(@a.Id)">✅ Hoàn thành</button>
                            }
                            @if (a.Status == "ChoXacNhan" || a.Status == "DaXacNhan")
                            {
                                <span class="lbl-staff">⏳ Chờ lễ tân check-in</span>
                            }
                            @if (a.Status == "HoanThanh")
                            {
                                <button class="btn-action btn-diag" onclick="openDiag(@a.Id)" style="background:#e8f4fd;color:#0a4d7c;border-color:#b8d8f0;">📋 Sửa chuẩn đoán</button>
                                <button class="btn-action btn-prescription" onclick="openRx(@a.Id)">💊 Đơn thuốc</button>
                                <button class="btn-action btn-print-phieu" onclick='openDonThuoc(@a.Id)'>🖨 In đơn thuốc</button>
                            }
                            @if (a.Status == "DaHuy")
                            {
                                <span style="font-size:11px;color:#721c24;background:#f8d7da;padding:4px 10px;border-radius:10px;border:1px solid #f5c6c6;">❌ Đã hủy</span>
                            }
                            @if (a.Status == "VangMat")
                            {
                                <span style="font-size:11px;color:#a32d2d;background:#fdecea;padding:4px 10px;border-radius:10px;border:1px solid #f5c6c6;">🚫 Vắng mặt</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ── Panel: Lịch làm việc ─────────────────────────────────── -->
    <div id="panelMySchedules" style="display:none;">
        <div class="sch-toolbar">
            <span class="sch-label">Từ ngày</span>
            <input type="date" class="sch-date" id="schViewFrom" />
            <span class="sch-label">Đến ngày</span>
            <input type="date" class="sch-date" id="schViewTo" />
            <button class="btn-load" onclick="loadMySchedules()">Xem lịch</button>
             @* <button class="btn-load" onclick="openDocAddSchedule()" style="margin-left:auto;background:#2d7a52;">+ Thêm lịch</button> *@
        </div> 
        <div class="sch-tbl-wrap">
            <div id="mySchTable"><div class="empty-state">Đang tải...</div></div>
        </div>
    </div>

    <!-- ── Panel: Bài viết ─────────────────────────────────────── -->
@*     <div id="panelArticles" style="display:none;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div style="font-size:14px;font-weight:500;color:#0a4d7c;">Bài viết của tôi</div>
            <button onclick="openEditor(null)" class="btn-load">+ Viết bài mới</button>
        </div>
        <div id="articleList">
            <div class="empty-state">Đang tải...</div>
        </div>
    </div>
  </div><!-- /doc-card-wrap -->
</div> *@

<!-- ── Modal Thêm lịch làm việc (Bác sĩ) ──────────────────────── -->
<div class="sch-overlay" id="docSchModal" onclick="if(event.target===this)closeDocAddSchedule()">
    <div class="sch-modal-box">
        <div class="sch-modal-title">📅 Thêm lịch làm việc</div>
