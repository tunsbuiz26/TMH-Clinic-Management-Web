    }

    // ══════════════════════════════════════════════════════════
    // ĐƠN THUỐC
    // ══════════════════════════════════════════════════════════
    var _rxAppointmentId = 0;
    var _rxPrescriptionId = 0;  // 0 = chưa có đơn, >0 = đang sửa
    var _rxItems = [];
    var _rxItemCnt = 0;

    function openRx(appointmentId) {
        _rxAppointmentId  = appointmentId;
        _rxPrescriptionId = 0;
        _rxItems = [];
        _rxItemCnt = 0;

        var a = allCards[appointmentId];
        if (!a) return;

        // Điền thông tin bệnh nhân
        setText('rxPatientName',  a.patientName  || a.PatientName  || '—');
        setText('rxBookingCode',  a.bookingCode  || a.BookingCode  || '—');
        setText('rxWorkDate', a.workDate ? new Date(a.workDate).toLocaleDateString('vi-VN') : '—');
        setText('rxDiagnosis',    a.diagnosis    || a.Diagnosis    || 'Chưa có chuẩn đoán');

        document.getElementById('rxNotes').value = '';
        document.getElementById('rxMsg').textContent = '';
        document.getElementById('rxMsg').className = 'rx-msg';

        // Ẩn nút in đơn thuốc cho đến khi đã lưu
        document.getElementById('rxBtnPrint').style.display = 'none';

        // Tải đơn thuốc hiện có (nếu có)
        // document.getElementById('rxItemsBody').innerHTML =
            //'<tr><td colspan="7" style="text-align:center;color:#7a9bb0;padding:16px;">⏳ Đang tải...</td></tr>';
        document.getElementById('rxOverlay').classList.add('open');

        fetch('/Doctor/GetPrescription?appointmentId=' + appointmentId)
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success && res.data) {
                    _rxPrescriptionId = res.data.id;
                    document.getElementById('rxNotes').value = res.data.notes || '';
                    document.getElementById('rxBtnPrint').style.display = '';
                    // Load items
                    (res.data.items || []).forEach(function(item) {
                        rxAddRow(item.medicineName, item.dosage, item.frequency, item.durationDays, item.quantity, item.instructions);
                    });
                    if (!res.data.items || !res.data.items.length) rxAddRow();
                } else {
                    // Chưa có đơn — bắt đầu với 1 dòng trống
                    rxAddRow();
                }
            })
            .catch(function() { rxAddRow(); });
    }

    function closeRx() {
        document.getElementById('rxOverlay').classList.remove('open');
    }

    function rxAddRow(medicine, dosage, freq, days, qty, instr) {
        var id = ++_rxItemCnt;
        _rxItems.push(id);
        var tbody = document.getElementById('rxItemsBody');
        // Xoá placeholder nếu còn
        var placeholder = tbody.querySelector('tr[data-placeholder]');
        if (placeholder) placeholder.remove();

        var tr = document.createElement('tr');
        tr.id = 'rxRow-' + id;
        tr.innerHTML =
            '<td><input class="rx-item-inp" id="rxMed-'  + id + '" value="' + esc(medicine||'') + '" placeholder="VD: Amoxicillin 500mg" /></td>' +
            '<td><input class="rx-item-inp" id="rxDose-' + id + '" value="' + esc(dosage||'')   + '" placeholder="VD: 1 viên" style="width:80px;" /></td>' +
            '<td><input class="rx-item-inp" id="rxFreq-' + id + '" value="' + esc(freq||'')     + '" placeholder="VD: 3 lần/ngày" /></td>' +
            '<td><input class="rx-item-num" id="rxDays-' + id + '" type="number" min="1" max="365" value="' + (days||7) + '" style="width:54px;" /></td>' +
            '<td><input class="rx-item-num" id="rxQty-'  + id + '" type="number" min="1" value="'           + (qty||21)  + '" style="width:54px;" /></td>' +
            '<td><input class="rx-item-inp" id="rxInstr-'+ id + '" value="' + esc(instr||'')   + '" placeholder="Uống sau ăn..." /></td>' +
            '<td><button class="rx-del-btn" onclick="rxRemoveRow(' + id + ')">×</button></td>';
        tbody.appendChild(tr);
    }

    function rxRemoveRow(id) {
        var row = document.getElementById('rxRow-' + id);
        if (row) row.remove();
        _rxItems = _rxItems.filter(function(x) { return x !== id; });
        if (!_rxItems.length) {
            document.getElementById('rxItemsBody').innerHTML =
                '<tr data-placeholder><td colspan="7" style="text-align:center;color:#bbb;padding:14px;font-size:12px;">Chưa có thuốc nào. Bấm "+ Thêm thuốc" để thêm.</td></tr>';
        }
    }

    function rxCollectItems() {
        return _rxItems.map(function(id) {
            return {
                medicineName: (document.getElementById('rxMed-'   + id)?.value || '').trim(),
                dosage:       (document.getElementById('rxDose-'  + id)?.value || '').trim(),
                frequency:    (document.getElementById('rxFreq-'  + id)?.value || '').trim(),
                durationDays: parseInt(document.getElementById('rxDays-'  + id)?.value) || 7,
                quantity:     parseInt(document.getElementById('rxQty-'   + id)?.value) || 1,
                instructions: (document.getElementById('rxInstr-' + id)?.value || '').trim()
            };
        }).filter(function(i) { return i.medicineName; });
    }

    function saveRx() {
        var msgEl = document.getElementById('rxMsg');
        msgEl.textContent = ''; msgEl.className = 'rx-msg';
        var items = rxCollectItems();
        if (!items.length) {
            msgEl.textContent = '❌ Vui lòng thêm ít nhất 1 loại thuốc.';
            msgEl.className = 'rx-msg err'; return;
        }
        var notes = document.getElementById('rxNotes').value.trim();
        var payload, url, method;

        if (_rxPrescriptionId > 0) {
            // Cập nhật
            url    = '/Doctor/UpdatePrescription?id=' + _rxPrescriptionId;
            method = 'PUT';
            payload = { notes: notes, items: items };
        } else {
            // Tạo mới
            url    = '/Doctor/CreatePrescription';
            method = 'POST';
            payload = { appointmentId: _rxAppointmentId, notes: notes, items: items };
        }

        msgEl.textContent = '⏳ Đang lưu...'; msgEl.className = 'rx-msg';
        fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.success) {
                _rxPrescriptionId = res.data?.id || _rxPrescriptionId;
                msgEl.textContent = '✅ ' + (res.message || 'Lưu đơn thuốc thành công.');
                msgEl.className = 'rx-msg ok';
                document.getElementById('rxBtnPrint').style.display = '';
            } else {
                msgEl.textContent = '❌ ' + (res.message || 'Có lỗi xảy ra.');
                msgEl.className = 'rx-msg err';
            }
        })
        .catch(function() {
            msgEl.textContent = '❌ Lỗi kết nối.'; msgEl.className = 'rx-msg err';
        });
    }

