    function loadPending() {
        var keyword  = (document.getElementById('pendingKeyword').value  || '').trim();
        var fromDate = document.getElementById('pendingFrom').value || '';
        var toDate   = document.getElementById('pendingTo').value   || '';

        var url = '/Staff/GetPendingAssignments?';
        var qs  = [];
        if (keyword)  qs.push('keyword='  + encodeURIComponent(keyword));
        if (fromDate) qs.push('fromDate=' + encodeURIComponent(fromDate));
        if (toDate)   qs.push('toDate='   + encodeURIComponent(toDate));
        url += qs.join('&');

        document.getElementById('pendingList').innerHTML =
            '<p style="color:#7a9bb0;font-size:13px;">Đang tải...</p>';

        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) { renderPendingList(data); })
            .catch(function() {
                document.getElementById('pendingList').innerHTML =
                    '<p style="color:#c0392b;font-size:13px;">❌ Không tải được danh sách. Vui lòng thử lại.</p>';
            });
    }

    function renderPendingList(list) {
        var badge = document.getElementById('pendingBadge');
        if (list && list.length > 0) {
            badge.textContent = list.length;
            badge.style.display = 'inline';
        } else {
            badge.style.display = 'none';
        }

        if (!list || list.length === 0) {
            document.getElementById('pendingList').innerHTML =
                '<div style="text-align:center;padding:40px 0;color:#7a9bb0;font-size:13px;">✅ Không có lịch nào đang chờ phân công.</div>';
            return;
        }

        var html = '<div class="apt-table-wrap"><table class="apt-table"><thead><tr>' +
            '<th>Mã lịch</th><th>Bệnh nhân</th><th>Ngày mong muốn</th>' +
            '<th>Ghi chú</th><th>Đặt lúc</th><th></th>' +
            '</tr></thead><tbody>';

        list.forEach(function(apt) {
            var booked = apt.bookedAt ? new Date(apt.bookedAt).toLocaleString('vi-VN') : '';
            var preferred = apt.preferredDateDisplay || apt.preferredDate
                ? (apt.preferredDateDisplay || new Date(apt.preferredDate).toLocaleDateString('vi-VN'))
                : '<span style="color:#94a3b8">Chưa chỉ định</span>';
            var note = apt.note
                ? '<span title="' + escHtml(apt.note) + '">' + escHtml(apt.note.length > 30 ? apt.note.substring(0, 30) + '…' : apt.note) + '</span>'
                : '<span style="color:#94a3b8">—</span>';

            html += '<tr>' +
                '<td><span style="font-family:monospace;font-weight:600;color:#0a4d7c;">' + escHtml(apt.bookingCode) + '</span></td>' +
                '<td>' + escHtml(apt.patientName) + '</td>' +
                '<td>' + preferred + '</td>' +
                '<td>' + note + '</td>' +
                '<td style="color:#7a9bb0;font-size:12px;">' + booked + '</td>' +
                '<td><button class="btn-walkin" style="white-space:nowrap;" ' +
                    'onclick="openAssignModal(' + apt.id + ',\'' + escHtml(apt.bookingCode) + '\',\'' + escHtml(apt.patientName) + '\')">' +
                    '🩺 Phân công</button></td>' +
                '</tr>';
        });

        html += '</tbody></table></div>';
        document.getElementById('pendingList').innerHTML = html;
