    function loadWorkSchedules() {
        var doctorId = document.getElementById('wsDoctor').value;
        var from     = document.getElementById('wsFrom').value;
        var to       = document.getElementById('wsTo').value;
        var url = '/Staff/GetWorkSchedules?';
        if (doctorId) url += 'doctorId=' + doctorId + '&';
        if (from)     url += 'from=' + from + '&';
        if (to)       url += 'to=' + to + '&';

        document.getElementById('wsTable').innerHTML =
            '<div class="loading-row" style="padding:28px;text-align:center;color:#7a9bb0;">Đang tải...</div>';

        fetch(url.replace(/[?&]$/, ''))
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (!data || !data.length) {
                document.getElementById('wsTable').innerHTML =
                    '<div class="loading-row" style="padding:28px;text-align:center;color:#7a9bb0;">Không có lịch làm việc nào trong khoảng thời gian này</div>';
                return;
            }

            // Sắp xếp: mới nhất lên đầu, sau đó theo bác sĩ
            data.sort(function(a, b) {
                var dateA = new Date(a.workDate), dateB = new Date(b.workDate);
                if (dateB - dateA !== 0) return dateB - dateA; // ngày mới nhất lên đầu
                if (a.doctorName < b.doctorName) return -1;
                if (a.doctorName > b.doctorName) return 1;
                return (a.startTime || '').localeCompare(b.startTime || '');
            });

            // Nhóm theo bác sĩ
            var grouped = {};
            var doctorOrder = [];
            data.forEach(function(s) {
                if (!grouped[s.doctorName]) {
                    grouped[s.doctorName] = [];
                    doctorOrder.push(s.doctorName);
                }
                grouped[s.doctorName].push(s);
            });

            var html = '<table class="apt-table"><thead><tr>' +
                '<th>Bác sĩ</th><th>Ngày</th><th>Ca làm việc</th>' +
                '<th>Đã đặt / Tối đa</th><th>Còn trống</th><th>Trạng thái</th><th>Thao tác</th>' +
                '</tr></thead><tbody>';

            doctorOrder.forEach(function(doctorName) {
                var schedules = grouped[doctorName];
                schedules.forEach(function(s, idx) {
                    var pct   = s.maxPatients > 0 ? Math.round(s.currentPatients / s.maxPatients * 100) : 0;
                    var color = pct >= 100 ? '#c0392b' : pct >= 70 ? '#c9a227' : '#2d7a52';
                    var bar   = '<div style="background:#f0f4f8;border-radius:4px;height:6px;width:80px;display:inline-block;vertical-align:middle;">' +
                                '<div style="background:' + color + ';height:6px;border-radius:4px;width:' + Math.min(pct,100) + '%;"></div></div>';
                    var canDel = s.remainingSlots === s.maxPatients;
                    var delBtn = '<button class="btn-action btn-vang" onclick="wsDeleteSchedule(' + s.id + ')" ' +
                        (canDel ? '' : 'title="Đã có bệnh nhân đặt" style="opacity:.4;cursor:not-allowed;" disabled') +
                        '>Xóa</button>';

                    var statusBadge;
                    if (s.status === 'Approved' || s.status === 'DaDuyet')
                        statusBadge = '<span class="badge badge-kham">✓ Đã duyệt</span>';
                    else if (s.status === 'ChoDuyet' || s.status === 'PendingApproval')
                        statusBadge = '<span class="badge badge-cho">⏳ Chờ duyệt</span>';
                    else if (s.status === 'DaHuy' || s.status === 'Cancelled')
                        statusBadge = '<span class="badge badge-huy">✗ Đã hủy</span>';
                    else
                        statusBadge = '<span class="badge">' + esc(s.status || '—') + '</span>';

                    var dateStr = new Date(s.workDate).toLocaleDateString('vi-VN', {weekday:'short',day:'2-digit',month:'2-digit',year:'numeric'});

                    // Hiển thị tên bác sĩ chỉ ở dòng đầu của nhóm, các dòng sau để trống
                    var doctorCell = idx === 0
                        ? '<td rowspan="' + schedules.length + '" style="vertical-align:top;padding-top:10px;border-right:2px solid #e8f4fd;"><strong>' + esc(s.doctorName) + '</strong></td>'
                        : '';

                    html += '<tr' + (idx === 0 ? ' style="border-top:2px solid #d4e8f5;"' : '') + '>' +
                        doctorCell +
                        '<td>' + dateStr + '</td>' +
                        '<td>' + esc(s.startTime) + ' – ' + esc(s.endTime) + '</td>' +
                        '<td>' + bar + ' <span style="font-size:12px;color:#7a9bb0;margin-left:6px;">' + s.currentPatients + ' / ' + s.maxPatients + '</span></td>' +
                        '<td><strong style="color:' + color + '">' + s.remainingSlots + '</strong></td>' +
                        '<td>' + statusBadge + '</td>' +
                        '<td>' + delBtn + '</td></tr>';
                });
            });

            html += '</tbody></table>';
            document.getElementById('wsTable').innerHTML = html;
        })
        .catch(function() {
            document.getElementById('wsTable').innerHTML =
                '<div class="loading-row" style="padding:28px;text-align:center;color:#c0392b;">❌ Lỗi kết nối.</div>';
        });
    }

    function wsDeleteSchedule(id) {
        if (!confirm('Xác nhận xóa lịch làm việc này?')) return;
        fetch('/Staff/DeleteWorkSchedule?id=' + id, {
            method: 'POST', headers: { 'RequestVerificationToken': csrfToken }
        })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success) loadWorkSchedules();
            else alert(data.message || 'Không thể xóa lịch này.');
        })
        .catch(function(){ alert('Lỗi kết nối.'); });
    }

    // ── Modal thêm lịch làm việc ─────────────────────────────────────
    function openWsModal() {
        _wsSelectedDoctors.clear();
        _wsShifts = [];
        _wsShiftIdCounter = 0;
        _wsSelectedWeekdays = new Set([1,2,3,4,5]);

        document.getElementById('wsErr').style.display = 'none';
        document.getElementById('wsOk').style.display  = 'none';
        document.getElementById('wsShiftList').innerHTML = '';

        // Đặt khoảng ngày mặc định = tuần sau
        var nextMon = new Date();
        nextMon.setDate(nextMon.getDate() + (8 - nextMon.getDay()) % 7 || 7);
        var nextSun = new Date(nextMon);
        nextSun.setDate(nextMon.getDate() + 6);
        document.getElementById('wsMFrom').value = nextMon.toISOString().split('T')[0];
        document.getElementById('wsMTo').value   = nextSun.toISOString().split('T')[0];

        // Reset bác sĩ checkboxes
        document.querySelectorAll('#wsDoctorList input[type=checkbox]').forEach(function(cb) {
            cb.checked = false;
            var label = cb.closest('label');
            if (label) { label.style.background=''; label.style.borderColor='#d4e8f5'; label.style.color=''; }
        });

        // Render weekday chips
        wsRenderWeekdays();

        // Thêm 2 ca mặc định: Ca 1 (07:00–11:00) và Ca 2 (13:00–17:00)
        wsAddShift('07:00', '11:00');
        wsAddShift('13:00', '17:00');

        document.getElementById('wsModal').classList.add('open');
    }

    function closeWsModal() {
        document.getElementById('wsModal').classList.remove('open');
    }

    function wsToggleDoctor(id) {
        var cb = document.querySelector('#wsDocLabel-' + id + ' input');
        var label = document.getElementById('wsDocLabel-' + id);
        if (cb && cb.checked) {
            _wsSelectedDoctors.add(id);
            if (label) { label.style.background='#e8f4fd'; label.style.borderColor='#0a4d7c'; label.style.color='#0a4d7c'; }
        } else {
            _wsSelectedDoctors.delete(id);
            if (label) { label.style.background=''; label.style.borderColor='#d4e8f5'; label.style.color=''; }
        }
    }

    function wsRenderWeekdays() {
        var c = document.getElementById('wsWdContainer');
        c.innerHTML = [1,2,3,4,5,6,0].map(function(d) {
            var sel = _wsSelectedWeekdays.has(d);
            return '<label id="wsWdLabel-' + d + '" style="font-size:12px;cursor:pointer;border:1.5px solid ' +
                (sel ? '#0a4d7c' : '#d4e8f5') + ';border-radius:8px;padding:5px 11px;user-select:none;background:' +
                (sel ? '#e8f4fd' : '#fff') + ';color:' + (sel ? '#0a4d7c' : '#0d2d44') + ';font-weight:' +
                (sel ? '600' : '400') + ';display:inline-flex;align-items:center;gap:5px;">' +
                '<input type="checkbox" style="display:none;" ' + (sel ? 'checked' : '') + ' />' +
                _wsDayNames[d] + '</label>';
        }).join('');
        [1,2,3,4,5,6,0].forEach(function(d) {
            var lbl = document.getElementById('wsWdLabel-' + d);
            if (lbl) lbl.onclick = function() { wsToggleWeekday(d); };
        });
    }

    function wsToggleWeekday(d) {
        if (_wsSelectedWeekdays.has(d)) _wsSelectedWeekdays.delete(d);
        else _wsSelectedWeekdays.add(d);
        wsRenderWeekdays();
    }

    function wsSelectWD(arr) {
        _wsSelectedWeekdays = new Set(arr);
        wsRenderWeekdays();
    }

    function wsAddShift(defaultStart, defaultEnd) {
        var id = ++_wsShiftIdCounter;
        var start = defaultStart || '08:00';
        var end   = defaultEnd   || '12:00';
        _wsShifts.push({ id: id, start: start, end: end });
        var container = document.getElementById('wsShiftList');
        var row = document.createElement('div');
        row.id = 'wsShift-' + id;
        row.style.cssText = 'display:flex;align-items:center;gap:10px;margin-bottom:8px;background:#f8fbff;border-radius:8px;padding:8px 12px;';
        row.innerHTML =
            '<span style="font-size:12px;color:#7a9bb0;min-width:30px;">Ca ' + id + '</span>' +
            '<input type="time" value="' + start + '" onchange="wsUpdateShift(' + id + ',\'start\',this.value)" ' +
                'style="height:34px;border:1.5px solid #d4e8f5;border-radius:7px;padding:0 10px;font-size:13px;outline:none;" />' +
            '<span style="font-size:12px;color:#7a9bb0;">–</span>' +
            '<input type="time" value="' + end + '" onchange="wsUpdateShift(' + id + ',\'end\',this.value)" ' +
                'style="height:34px;border:1.5px solid #d4e8f5;border-radius:7px;padding:0 10px;font-size:13px;outline:none;" />' +
            '<button onclick="wsRemoveShift(' + id + ')" style="height:28px;padding:0 10px;background:#fdecea;color:#c0392b;border:1px solid #f5c6c6;border-radius:6px;font-size:11px;cursor:pointer;">Xóa</button>';
        container.appendChild(row);
    }

    function wsUpdateShift(id, field, val) {
        var s = _wsShifts.find(function(x){ return x.id===id; });
        if (s) s[field] = val;
    }

    function wsRemoveShift(id) {
        _wsShifts = _wsShifts.filter(function(s){ return s.id!==id; });
        var row = document.getElementById('wsShift-' + id);
        if (row) row.remove();
    }

    function saveWorkSchedule() {
        var from = document.getElementById('wsMFrom').value;
        var to   = document.getElementById('wsMTo').value;
        var max  = parseInt(document.getElementById('wsMMax').value) || 10;
        var errEl = document.getElementById('wsErr');
        errEl.style.display = 'none';
        document.getElementById('wsOk').style.display = 'none';

        if (!_wsSelectedDoctors.size) { errEl.textContent='Vui lòng chọn ít nhất 1 bác sĩ.'; errEl.style.display='block'; return; }
        if (!from || !to)             { errEl.textContent='Vui lòng chọn khoảng ngày.';       errEl.style.display='block'; return; }
        if (!_wsSelectedWeekdays.size){ errEl.textContent='Vui lòng chọn ít nhất 1 thứ.';    errEl.style.display='block'; return; }
        if (!_wsShifts.length)        { errEl.textContent='Vui lòng thêm ít nhất 1 ca.';     errEl.style.display='block'; return; }

        for (var i = 0; i < _wsShifts.length; i++) {
            if (_wsShifts[i].start >= _wsShifts[i].end) {
                errEl.textContent = 'Ca ' + (i+1) + ': giờ kết thúc phải sau giờ bắt đầu.';
                errEl.style.display = 'block'; return;
            }
        }

        var btn = document.getElementById('wsSaveBtn');
        btn.disabled = true; btn.textContent = 'Đang tạo...';

        fetch('/Staff/CreateWorkSchedule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
            body: JSON.stringify({
                doctorIds:   Array.from(_wsSelectedDoctors),
                fromDate:    from,
                toDate:      to,
                weekdays:    Array.from(_wsSelectedWeekdays),
                maxPatients: max,
                shifts: _wsShifts.map(function(s) {
                    return { startTime: s.start + ':00', endTime: s.end + ':00' };
                })
            })
        })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success) {
                closeWsModal();
                loadWorkSchedules();
                var toast = document.getElementById('wsSuccessToast');
                toast.textContent = '✅ ' + (data.message || 'Tạo lịch thành công!');
                toast.style.display = 'block';
                setTimeout(function() { toast.style.display = 'none'; }, 3000);
            } else {
                errEl.textContent = data.message || 'Có lỗi xảy ra.';
                errEl.style.display = 'block';
            }
        })
        .catch(function(){ errEl.textContent='Lỗi kết nối.'; errEl.style.display='block'; })
        .finally(function(){ btn.disabled=false; btn.textContent='✅ Tạo lịch hàng loạt'; });
    }

    // Load pending badge count on page load
    document.addEventListener('DOMContentLoaded', function() {
        fetch('/Staff/GetPendingAssignments')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.length > 0) {
                    var badge = document.getElementById('pendingBadge');
                    badge.textContent = data.length;
                    badge.style.display = 'inline';
                }
            })
            .catch(function() {});
    });
</script>
}
