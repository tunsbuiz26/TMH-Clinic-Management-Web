    function inboxOpenConv(conv) {
        inboxConvId = conv.id;
        // Đánh dấu active
        document.querySelectorAll('.inbox-conv-item').forEach(function(i){ i.classList.remove('active'); });
        document.querySelector('[data-conv-id="' + conv.id + '"]')?.classList.add('active');
        // Cập nhật header
        document.getElementById('inboxChatAv').textContent = conv.title ? conv.title[0].toUpperCase() : '?';
        document.getElementById('inboxChatName').textContent = conv.title;
        document.getElementById('inboxChatSub').textContent = conv.type === 'PatientStaff' ? 'Bệnh nhân' : 'Nội bộ';
        // Hiện chat area
        document.getElementById('inboxEmpty').style.display = 'none';
        var ca = document.getElementById('inboxChatArea');
        ca.style.display = 'flex';
        // Load messages
        inboxLoadMessages(conv.id);
        // Join SignalR room
        if (inboxHubConn && inboxHubConn.state === 'Connected')
            inboxHubConn.invoke('JoinConversation', conv.id).catch(function(){});
        // Đánh dấu đã đọc
        fetch('/api/msgs/conversations/' + conv.id + '/read', { method: 'PUT' });
    }

    function inboxLoadMessages(convId) {
        fetch('/api/msgs/conversations/' + convId + '/messages')
        .then(function(r){ return r.json(); })
        .then(function(msgs) {
            var box = document.getElementById('inboxMsgs');
            box.innerHTML = '';
            if (!msgs || !msgs.length) {
                box.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:#94a3b8;">Chưa có tin nhắn.</div>';
                return;
            }
            msgs.forEach(function(m){ inboxAppendMsg(m, false); });
            box.scrollTop = box.scrollHeight;
        });
    }

    function inboxAppendMsg(msg, scroll) {
        var box    = document.getElementById('inboxMsgs');
        var isMine = (msg.senderId === inboxMyId);
        var cls    = isMine ? 'mine' : 'other';
        var wrap   = document.createElement('div');
        wrap.className = 'inbox-msg ' + cls;
        var av = document.createElement('div');
        av.className = 'inbox-msg-av';
        av.textContent = isMine ? 'Tôi'[0] : (msg.senderName ? msg.senderName[0].toUpperCase() : '?');
        var col  = document.createElement('div');
        col.className = 'inbox-msg-body';
        var bub  = document.createElement('div');
        bub.className = 'inbox-bub';
        bub.textContent = msg.content;
        var meta = document.createElement('div');
        meta.className = 'inbox-msg-meta';
        var d = new Date(msg.sentAt);
        meta.textContent = (!isMine ? msg.senderName + ' · ' : '') +
            d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
        col.appendChild(bub); col.appendChild(meta);
        wrap.appendChild(av); wrap.appendChild(col);
        box.appendChild(wrap);
        if (scroll) box.scrollTop = box.scrollHeight;
    }

    function inboxSend() {
        if (!inboxConvId) return;
        var input = document.getElementById('inboxInput');
        var msg = input.value.trim();
        if (!msg) return;
        // Hiển thị ngay (optimistic UI)
        inboxAppendMsg({ senderId: inboxMyId, content: msg, sentAt: new Date().toISOString(), conversationId: inboxConvId }, true);
        input.value = '';
        if (inboxHubConn && inboxHubConn.state === 'Connected') {
            inboxHubConn.invoke('SendMessage', inboxConvId, msg).catch(function(){ inboxSendRest(msg); });
        } else { inboxSendRest(msg); }
    }

    function inboxSendRest(content) {
        // Tin đã hiển thị optimistic, chỉ lưu lên server
        fetch('/api/msgs/conversations/' + inboxConvId + '/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: content })
        }).catch(function() {});
    }

            function inboxConnectHub() {
            fetch('/api/msgs/token')
            .then(function(r){ return r.json(); })
            .then(function(data) {
                if (!data.token) {
                    console.error('Không lấy được SignalR token');
                    return;
                }

                // Tạo connection mới (nếu đã có thì stop trước để tránh duplicate)
                if (inboxHubConn) {
                    inboxHubConn.stop().catch(() => {});
                }

                inboxHubConn = new signalR.HubConnectionBuilder()
                    .withUrl('https://localhost:7100/hubs/chat?access_token=' + encodeURIComponent(data.token))
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])  // reconnect thông minh hơn
                    .configureLogging(signalR.LogLevel.Information)   // ← Bật log để debug
                    .build();

                // ====================== ĐĂNG KÝ EVENT TRƯỚC KHI START ======================
                inboxHubConn.on('ReceiveMessage', function(msg) {
                    console.log('Nhận được tin nhắn:', msg);   // ← Dùng để debug

                    if (msg.id && _inboxSeenIds.has(msg.id)) return;
                    if (msg.id) _inboxSeenIds.add(msg.id);

                    if (msg.senderId === inboxMyId) return;   // tin của chính mình

                    if (msg.conversationId === inboxConvId) {
                        // Đang mở đúng cuộc chat
                        inboxAppendMsg(msg, true);
                        fetch('/api/msgs/conversations/' + msg.conversationId + '/read', { method: 'PUT' });
                    } else {
                        // Tin nhắn từ cuộc chat khác
                        var b = document.getElementById('staffInboxBadge');
                        var n = parseInt(b.textContent || '0') + 1;
                        b.textContent = n;
                        b.style.display = 'inline';

                        inboxLoadConversations();   // reload danh sách để cập nhật preview + unread
                    }
                });

                // Xử lý reconnect tốt hơn
                inboxHubConn.onreconnecting(function() {
                    console.log('SignalR đang reconnect...');
                });

                inboxHubConn.onreconnected(function() {
                    console.log('SignalR đã reconnect thành công');
                    if (inboxConvId) {
                        inboxHubConn.invoke('JoinConversation', inboxConvId).catch(function(err) {
                            console.warn('Re-join conversation thất bại:', err);
                        });
                    }
                });

                inboxHubConn.onclose(function(err) {
                    console.warn('SignalR connection closed:', err);
                });

                // ====================== START CONNECTION ======================
                inboxHubConn.start()
                .then(function() {
                    console.log('SignalR Connected successfully!');
                    if (inboxConvId) {
                        inboxHubConn.invoke('JoinConversation', inboxConvId).catch(function(err) {
                            console.warn('JoinConversation error:', err);
                        });
                    }
                })
                .catch(function(err) {
                    console.error('SignalR start failed:', err);
                });
            })
            .catch(function(err) {
                console.error('Lỗi lấy token SignalR:', err);
            });
        }

