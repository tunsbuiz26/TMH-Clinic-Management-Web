    function loadAssignSlots() {
        var docId = document.getElementById('assignDoctorSel').value;
        var date  = document.getElementById('assignDate').value;
        var slotSel = document.getElementById('assignSlotSel');
        slotSel.innerHTML = '<option value="">Đang tải...</option>';

        if (!docId || !date) {
            slotSel.innerHTML = '<option value="">-- Chọn khung giờ --</option>';
            return;
        }

        fetch('/Staff/GetSlotsForReschedule?date=' + date + '&doctorId=' + docId)
            .then(function(r) { return r.json(); })
            .then(function(doctors) {
                slotSel.innerHTML = '<option value="">-- Chọn khung giờ --</option>';
                var doc = doctors.find(function(d) {
                    return (d.DoctorId || d.doctorId) == docId;
                });
                var slots = doc ? (doc.AvailableSlots || doc.availableSlots || []) : [];
                slots.forEach(function(s) {
                    var rem = s.RemainingSlots || s.remainingSlots || 0;
                    if (rem <= 0) return;
                    var start = (s.StartTime || s.startTime || '').substring(0,5);
                    var end   = (s.EndTime   || s.endTime   || '').substring(0,5);
                    var opt   = document.createElement('option');
                    opt.value = s.ScheduleId || s.scheduleId;
                    opt.textContent = start + ' – ' + end + ' (còn ' + rem + ' chỗ)';
                    slotSel.appendChild(opt);
                });
                if (slotSel.options.length === 1) {
                    slotSel.innerHTML = '<option value="">Không có ca trống ngày này</option>';
                }
            })
            .catch(function() {
                slotSel.innerHTML = '<option value="">Lỗi tải ca khám</option>';
            });
    }

    function submitAssign() {
        var scheduleId = document.getElementById('assignSlotSel').value;
        var note       = document.getElementById('assignNote').value.trim() || null;
        var errEl      = document.getElementById('assignErr');
        var btn        = document.getElementById('btnAssignConfirm');

        errEl.style.display = 'none';

        if (!scheduleId) {
            errEl.textContent   = '⚠️ Vui lòng chọn khung giờ.';
            errEl.style.display = 'block';
            return;
        }

        btn.disabled    = true;
        btn.textContent = 'Đang lưu...';

        fetch('/Staff/AssignSchedule', {
            method:  'POST',
            headers: {
                'Content-Type':             'application/json',
                'RequestVerificationToken': csrfToken
            },
            body: JSON.stringify({
                appointmentId: _currentAssignId,
                scheduleId:    parseInt(scheduleId),
                note:          note
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data || !data.success) {
                errEl.textContent   = '❌ ' + (data && data.message ? data.message : 'Có lỗi xảy ra.');
                errEl.style.display = 'block';
                return;
            }
            closeAssignModal();
            loadPending();
            showGlobalToast('Phân công lịch khám thành công!', 'success');
        })
        .catch(function() {
            errEl.textContent   = '❌ Không kết nối được máy chủ.';
            errEl.style.display = 'block';
        })
        .finally(function() {
            btn.disabled    = false;
            btn.textContent = 'Xác nhận phân công';
        });
    }

