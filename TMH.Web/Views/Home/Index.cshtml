@{
    ViewBag.Title = "Phòng Khám Tai Mũi Họng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* ===== HERO ===== */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 480px;
            background: linear-gradient(135deg,#f0f8ff 0%,#fff 60%);
            padding: 60px 40px 50px;
            gap: 40px;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                right: -100px;
                top: -100px;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: rgba(26,111,168,0.06);
                pointer-events: none;
            }

            .hero::after {
                content: '';
                position: absolute;
                right: 80px;
                bottom: -60px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: rgba(201,162,39,0.08);
                pointer-events: none;
            }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fdf3d7;
            border: 1px solid rgba(201,162,39,0.3);
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: 500;
            color: #c9a227;
            margin-bottom: 18px;
        }

            .hero-tag::before {
                content: '✦';
                font-size: 9px;
            }

        .hero-title {
            font-family: 'Crimson Pro',serif;
            font-size: 40px;
            font-weight: 600;
            color: #0a4d7c;
            line-height: 1.2;
            margin-bottom: 16px;
        }

            .hero-title em {
                color: #c9a227;
                font-style: normal;
            }

        .hero-desc {
            font-size: 14px;
            color: #3a5a72;
            line-height: 1.7;
            margin-bottom: 28px;
            max-width: 420px;
        }

        .hero-btns {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-hero-primary {
            height: 44px;
            padding: 0 24px;
            background: #0a4d7c;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            font-family: 'DM Sans',sans-serif;
            transition: background .15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .btn-hero-primary:hover {
                background: #1a6fa8;
            }

        .btn-hero-secondary {
            height: 44px;
            padding: 0 24px;
            background: #fdf3d7;
            color: #c9a227;
            border: 1px solid rgba(201,162,39,0.4);
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            font-family: 'DM Sans',sans-serif;
            transition: background .15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .btn-hero-secondary:hover {
                background: #f5e9b8;
            }

        .hero-stats {
            display: flex;
            gap: 24px;
            margin-top: 28px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-num {
            font-family: 'Crimson Pro',serif;
            font-size: 26px;
            font-weight: 600;
            color: #0a4d7c;
        }

        .stat-lbl {
            font-size: 11px;
            color: #7a9bb0;
            margin-top: 2px;
        }

        .stat-div {
            width: 1px;
            background: #d4e8f5;
            align-self: stretch;
        }

        /* ===== APPOINTMENT CARD ===== */

        /* ── Hero Carousel ─────────────────────────────── */
        .hero-carousel-wrap {
            width: 500px;
            flex-shrink: 0;
        }
        .hero-carousel {
            background: #fff;
            border-radius: 20px;
            padding: 36px;
            box-shadow: 0 8px 40px rgba(10,77,124,.12);
            min-height: 420px;
        }
        .carousel-slide { animation: fadeIn .4s ease; }
        @@keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }

        .slide-tag { font-size: 10px; font-weight: 600; color: #1a6fa8; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
        .slide-title { font-family: 'Crimson Pro', serif; font-size: 26px; font-weight: 600; color: #0a4d7c; line-height: 1.3; margin-bottom: 16px; }
        .slide-cta { font-size: 13px; color: #1a6fa8; text-decoration: none; font-weight: 500; display: inline-block; margin-top: 12px; }
        .slide-cta:hover { color: #0a4d7c; }

        /* Bác sĩ — header slide */
        .exp-hdr { margin-bottom: 16px; }
        .exp-hdr-badge { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg,#e8f4ff,#dbeeff); color: #0a4d7c; font-size: 11px; font-weight: 700; padding: 5px 14px; border-radius: 20px; margin-bottom: 8px; border: 1px solid #c2dfff; text-transform: uppercase; letter-spacing: .05em; }
        .exp-hdr-title { font-family: 'Crimson Pro', serif; font-size: 22px; font-weight: 700; color: #0a4d7c; line-height: 1.2; }
        .exp-hdr-sub { font-size: 12px; color: #7a9bb0; margin-top: 3px; }

        /* Bác sĩ — card nâng cao */
        .doctors-showcase { display: flex; flex-direction: column; gap: 10px; }
        .doc-card-mini { height: 80px; background: linear-gradient(90deg,#f0f0f0 25%,#e8e8e8 50%,#f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 12px; }
        .doc-card-new { display: flex; align-items: center; gap: 14px; padding: 12px 14px; background: #fff; border-radius: 12px; border: 1px solid #e2eff8; box-shadow: 0 2px 8px rgba(10,77,124,.06); transition: transform .15s, box-shadow .15s; text-decoration: none; }
        .doc-card-new:hover { transform: translateX(4px); box-shadow: 0 4px 18px rgba(10,77,124,.14); border-color: #b3d4ef; }
        .doc-avt-new { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2.5px solid #d0e8f7; }
        .doc-body-new { flex: 1; min-width: 0; }
        .doc-name-new { font-size: 13px; font-weight: 600; color: #0a4d7c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .doc-spec-new { font-size: 11px; color: #6a8ea8; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .doc-spec-chip { display: inline-block; font-size: 10.5px; font-weight: 500; color: #1a6fa8; background: #e8f4ff; border: 1px solid #c2dfff; border-radius: 20px; padding: 2px 10px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
        .doc-stats { display: flex; align-items: center; gap: 7px; margin-top: 7px; flex-wrap: wrap; }
        .doc-rating-tag { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 700; color: #92400e; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px; padding: 2px 8px; }
        .doc-rating-tag .r-count { font-weight: 400; font-size: 10px; color: #a16207; }
        .doc-exp-tag { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; color: #0a4d7c; background: #e8f4ff; border: 1px solid #b3d4ef; border-radius: 8px; padding: 2px 8px; }
        .loading-shimmer { background: linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 12px; }
        @@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

        /* Khuyến mãi */
        .promo-badge { display: inline-block; background: #fff3cd; color: #856404; font-size: 12px; font-weight: 500; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px; }
        .promo-title { font-family: 'Crimson Pro', serif; font-size: 34px; font-weight: 700; color: #0a4d7c; line-height: 1.2; margin-bottom: 10px; }
        .promo-title span { color: #c9a227; }
        .promo-desc { font-size: 12px; color: #7a9bb0; line-height: 1.6; margin-bottom: 14px; }
        .promo-items { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
        .promo-item { font-size: 12px; color: #2a3f52; font-weight: 500; }
        .slide-cta-btn { display: block; text-align: center; background: #0a4d7c; color: #fff; padding: 12px; border-radius: 10px; font-size: 13px; font-weight: 500; text-decoration: none; transition: background .15s; }
        .slide-cta-btn:hover { background: #1a6fa8; }

        /* Thống kê */
        .stats-showcase { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
        .stat-big { background: #f0f8ff; border-radius: 10px; padding: 14px 12px; text-align: center; }
        .stat-big-num { display: block; font-size: 28px; font-weight: 700; color: #0a4d7c; }
        .stat-big-lbl { display: block; font-size: 11px; color: #7a9bb0; margin-top: 2px; }
        .trust-badges { display: flex; flex-direction: column; gap: 6px; }
        .trust-item { font-size: 12px; color: #2a3f52; font-weight: 500; }

        /* Dots */
        .carousel-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
        .dot { width: 8px; height: 8px; border-radius: 50%; border: none; background: #d4e8f5; cursor: pointer; padding: 0; transition: all .2s; }
        .dot.active { background: #0a4d7c; width: 24px; border-radius: 4px; }

        @@media (max-width: 900px) { .hero-carousel-wrap { width: 100%; } }
        .hero-card {
            background: #fff;
            border: 1px solid #d4e8f5;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 8px 32px rgba(10,77,124,0.08);
        }

        .card-head-title {
            font-size: 15px;
            font-weight: 500;
            color: #0a4d7c;
            margin-bottom: 4px;
        }

        .card-head-sub {
            font-size: 12px;
            color: #7a9bb0;
            margin-bottom: 20px;
        }

        .appt-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 12px;
        }

        .appt-form-full {
            margin-bottom: 12px;
        }

        .appt-label {
            font-size: 11px;
            font-weight: 500;
            color: #3a5a72;
            margin-bottom: 5px;
            display: block;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .appt-input {
            width: 100%;
            height: 38px;
            border: 1px solid #d4e8f5;
            border-radius: 8px;
            padding: 0 12px;
            font-size: 13px;
            color: #0d2d44;
            background: #fff;
            outline: none;
            font-family: 'DM Sans',sans-serif;
            transition: border-color .15s;
        }

            .appt-input:focus {
                border-color: #1a6fa8;
                box-shadow: 0 0 0 3px rgba(26,111,168,0.1);
            }

        .appt-select {
            width: 100%;
            height: 38px;
            border: 1px solid #d4e8f5;
            border-radius: 8px;
            padding: 0 12px;
            font-size: 13px;
            color: #0d2d44;
            background: #fff;
            outline: none;
            font-family: 'DM Sans',sans-serif;
        }

        .btn-appt {
            width: 100%;
            height: 40px;
            background: #0a4d7c;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            font-family: 'DM Sans',sans-serif;
            margin-top: 4px;
            transition: background .15s;
        }

            .btn-appt:hover {
                background: #1a6fa8;
            }

        .appt-note {
            text-align: center;
            font-size: 11px;
            color: #7a9bb0;
            margin-top: 8px;
        }

            .appt-note span {
                color: #c9a227;
                font-weight: 500;
            }

        /* ===== SECTIONS ===== */
        .section {
            padding: 52px 40px;
        }

        .section-tag {
            display: inline-block;
            background: #e8f4fd;
            color: #1a6fa8;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 12px;
            border-radius: 20px;
            letter-spacing: .05em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .section-title {
            font-family: 'Crimson Pro',serif;
            font-size: 28px;
            font-weight: 600;
            color: #0a4d7c;
            margin-bottom: 6px;
        }

        .section-sub {
            font-size: 13px;
            color: #7a9bb0;
            margin-bottom: 32px;
        }

        /* ===== SERVICES ===== */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
        }

        .svc-card {
            background: #fff;
            border: 1px solid #d4e8f5;
            border-radius: 14px;
            padding: 20px 18px;
            position: relative;
            overflow: hidden;
        }

            .svc-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: #0a4d7c;
            }

        .svc-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #e8f4fd;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }

        .svc-name {
            font-size: 14px;
            font-weight: 500;
            color: #0a4d7c;
            margin-bottom: 6px;
        }

        .svc-desc {
            font-size: 12px;
            color: #7a9bb0;
            line-height: 1.55;
        }

        .svc-badge {
            display: inline-block;
            margin-top: 10px;
            font-size: 10px;
            font-weight: 500;
            padding: 2px 8px;
            border-radius: 10px;
            background: #fdf3d7;
            color: #c9a227;
        }

        /* ===== SYMPTOM ===== */
        .symptom-section {
            background: #fffbef;
            border-top: 1px solid rgba(201,162,39,.15);
            border-bottom: 1px solid rgba(201,162,39,.15);
            padding: 44px 40px;
        }
        .symptom-header { margin-bottom: 28px; }
        .symptom-tag {
            display: inline-block;
            background: #fdf3d7; color: #c9a227;
            font-size: 11px; font-weight: 500; padding: 4px 12px;
            border-radius: 20px; letter-spacing: .05em; text-transform: uppercase;
            margin-bottom: 10px;
        }
        .symptom-title {
            font-family: 'Crimson Pro', serif; font-size: 28px;
            font-weight: 600; color: #0a4d7c; margin-bottom: 6px;
        }
        .symptom-sub { font-size: 13px; color: #7a9bb0; }

        .symptom-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 14px;
        }
        .sym-card {
            background: #fff;
            border: 1px solid rgba(201,162,39,.25);
            border-radius: 14px;
            padding: 22px 16px;
            cursor: pointer;
            text-align: center;
            transition: all .2s;
            display: flex; flex-direction: column;
            align-items: center; gap: 8px;
            text-decoration: none; color: inherit;
        }
        .sym-card:hover {
               
        }
        .sym-emoji { font-size: 32px; line-height: 1; }
        .sym-name  { font-size: 13px; font-weight: 600; color: #0a4d7c; }
        .sym-desc  { font-size: 11px; color: #7a9bb0; line-height: 1.5; }
        .sym-cta {
            display: inline-flex; align-items: center; gap: 5px;
            margin-top: 4px; font-size: 11px; font-weight: 500;
            color: #c9a227; background: #fdf3d7;
            padding: 3px 10px; border-radius: 20px;
        }
        @@media(max-width:900px){ .symptom-grid { grid-template-columns: repeat(2,1fr); } }

        /* ===== DOCTORS ===== */
        .section-alt {
            background: #f0f8ff;
        }

        .doctors-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 20px;
        }

        .doc-card {
            background: #fff;
            border: 1px solid #d4e8f5;
            border-radius: 14px;
            overflow: hidden;
            transition: box-shadow .2s;
        }

            .doc-card:hover {
                box-shadow: 0 8px 24px rgba(10,77,124,0.1);
            }

        .doc-avatar {
            height: 120px;
            background: linear-gradient(135deg,#e8f4fd,#f0f8ff);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .avatar-circle {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #0a4d7c;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Crimson Pro',serif;
            font-size: 24px;
            font-weight: 600;
            color: #fff;
            border: 3px solid rgba(255,255,255,0.5);
        }

        .doc-avail {
            position: absolute;
            bottom: 10px;
            right: 12px;
            background: #fff;
            border: 1px solid #c9f0d8;
            border-radius: 10px;
            padding: 3px 8px;
            font-size: 10px;
            color: #2d7a52;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .doc-avail::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #3aaa6a;
            }

        .doc-body {
            padding: 16px;
        }

        .doc-name {
            font-size: 14px;
            font-weight: 500;
            color: #0a4d7c;
            margin-bottom: 3px;
        }

        .doc-spec {
            font-size: 12px;
            color: #c9a227;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .doc-info {
            font-size: 11px;
            color: #7a9bb0;
            line-height: 1.6;
        }

        .btn-book {
            width: 100%;
            height: 34px;
            background: #e8f4fd;
            color: #0a4d7c;
            border: 1px solid #d4e8f5;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            font-family: 'DM Sans',sans-serif;
            margin-top: 12px;
            transition: background .15s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-book:hover {
                background: #1a6fa8;
                color: #fff;
                border-color: #1a6fa8;
            }

        /* ===== NEWS ===== */
        .news-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 20px;
        }

        .news-card {
            border: 1px solid #d4e8f5;
            border-radius: 14px;
            overflow: hidden;
            cursor: pointer;
            transition: transform .15s;
            background: #fff;
        }

            .news-card:hover {
                transform: translateY(-2px);
            }

        .news-img {
            aspect-ratio: 16/9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            overflow: hidden;
        }

        .news-body {
            padding: 14px 16px;
        }

        .news-cat {
            font-size: 10px;
            font-weight: 500;
            color: #1a6fa8;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 6px;
        }

        .news-title {
            font-size: 13px;
            font-weight: 500;
            color: #0a4d7c;
            line-height: 1.45;
            margin-bottom: 6px;
        }

        .news-meta {
            font-size: 11px;
            color: #7a9bb0;
        }
    </style>
}
<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <div class="hero-tag">Chuyên khoa Tai Mũi Họng hàng đầu</div>
        <h1 class="hero-title">Chẩn đoán chính xác,<br>điều trị <em>Tai · Mũi · Họng</em><br>tận tâm</h1>
        <p class="hero-desc">Đội ngũ bác sĩ chuyên khoa TMH giàu kinh nghiệm, trang thiết bị nội soi hiện đại, điều trị toàn diện các bệnh lý về tai, mũi, họng và đầu cổ cho mọi lứa tuổi.</p>
        <div class="hero-btns">
            @if (ViewBag.IsLoggedIn == true)
            {
                <a asp-controller="Booking" asp-action="Index" class="btn-hero-primary">Đặt lịch khám ngay</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Đặt lịch khám ngay</a>
            }
            <a href="#bac-si" class="btn-hero-secondary">Tìm bác sĩ →</a>
        </div>
        <div class="hero-stats">
            <div class="stat-item"><div class="stat-num">18+</div><div class="stat-lbl">Năm kinh nghiệm</div></div>
            <div class="stat-div"></div>
            <div class="stat-item"><div class="stat-num">45</div><div class="stat-lbl">Bác sĩ chuyên khoa TMH</div></div>
            <div class="stat-div"></div>
            <div class="stat-item"><div class="stat-num">80K+</div><div class="stat-lbl">Bệnh nhân tin tưởng</div></div>
        </div>
    </div>

    <!-- Hero Carousel -->
    <div class="hero-carousel-wrap">
        <div class="hero-carousel" id="heroCarousel">

            <!-- Slide 1: Giới thiệu bác sĩ -->
            <div class="carousel-slide" id="slide-0">
                <div class="exp-hdr">
                    <div class="exp-hdr-badge">⚕️ Đội ngũ chuyên gia</div>
                    <div class="exp-hdr-title">Bác sĩ của chúng tôi</div>
                    <div class="exp-hdr-sub">Chuyên gia Tai · Mũi · Họng hàng đầu Việt Nam</div>
                </div>
                <div class="doctors-showcase" id="doctorShowcase">
                    <div class="doc-card-mini loading-shimmer" style="height:78px;"></div>
                    <div class="doc-card-mini loading-shimmer" style="height:78px;"></div>
                    <div class="doc-card-mini loading-shimmer" style="height:78px;"></div>
                </div>
