@{
    var articlesJson = ViewBag.ArticlesJson as string ?? "[]";
}
<script type="application/json" id="_homeArticlesData">@Html.Raw(articlesJson)</script>
<script>
(function() {
    var bgColors = [
        'linear-gradient(135deg,#e8f4fd,#d4ecf9)',
        'linear-gradient(135deg,#fdf3d7,#fde8b0)',
        'linear-gradient(135deg,#e6f7ef,#c9f0d8)',
        'linear-gradient(135deg,#fdecea,#f9c9c9)',
        'linear-gradient(135deg,#f3e8fd,#e4c9f9)'
    ];
    var catIcons = {
        'Viem xoang':'🤧','Thinh hoc':'👂','Hong — Thanh quan':'😴',
        'TMH Nhi':'👶','Phau thuat noi soi':'🔬','Phong ngua':'💊','Khac':'📋'
    };
    function getIcon(cat) {
        var map = {'Viêm xoang':'🤧','Thính học':'👂','Hồng — Thanh quản':'😴','TMH Nhi':'👶','Phẫu thuật nội soi':'🔬','Phòng ngừa':'💊'};
        return map[cat] || '📋';
    }
    try {
        var articles = JSON.parse(document.getElementById('_homeArticlesData').textContent || '[]');
        var grid = document.getElementById('homeNewsGrid');
        if (!Array.isArray(articles) || !articles.length) {
            grid.innerHTML = '<p style="color:#7a9bb0;font-size:13px;text-align:center;grid-column:1/-1">Chưa có bài viết nào.</p>';
            return;
        }
        grid.innerHTML = articles.map(function(a, i) {
            var bg  = bgColors[i % bgColors.length];
            var ico = getIcon(a.category);
            var date = a.publishedAt ? new Date(a.publishedAt).toLocaleDateString('vi-VN') : '';
            var imgDiv = a.thumbnail
                ? '<div class="news-img" style="background:#f0f8ff;padding:0;overflow:hidden"><img src="' + a.thumbnail + '" style="width:100%;height:100%;object-fit:contain" /></div>'
                : '<div class="news-img" style="background:' + bg + '">' + ico + '</div>';
            return '<a href="/News/Detail/' + a.id + '" style="text-decoration:none">' +
                '<div class="news-card">' + imgDiv +
                    '<div class="news-body">' +
                        '<div class="news-cat">' + (a.category||'') + '</div>' +
                        '<div class="news-title">' + (a.title||'') + '</div>' +
                        '<div class="news-meta">' + (a.authorName||'') + (date?' · '+date:'') + '</div>' +
                    '</div>' +
                '</div></a>';
        }).join('');
    } catch(e) {
        console.error('News render error:', e);
    }

    // ── Hero Carousel ─────────────────────────────────────────────
    var currentSlide = 0;
    var totalSlides  = 3;
    var carouselTimer;

    function goSlide(n) {
        document.getElementById('slide-' + currentSlide).style.display = 'none';
        document.querySelectorAll('.dot')[currentSlide].classList.remove('active');
        currentSlide = n;
        document.getElementById('slide-' + currentSlide).style.display = 'block';
        document.querySelectorAll('.dot')[currentSlide].classList.add('active');
        resetTimer();
    }

    function nextSlide() { goSlide((currentSlide + 1) % totalSlides); }

    function resetTimer() {
        clearInterval(carouselTimer);
        carouselTimer = setInterval(nextSlide, 5000);
    }

    // Load doctors vào slide 1
    fetch('/api/article/published?limit=1')  // dummy call để test connection
        .catch(function(){});

    // Load doctors từ API
    var _isLoggedIn = @(ViewBag.IsLoggedIn == true ? "true" : "false");
    var _docAvatars = [
        'https://images.unsplash.com/photo-1527613426441-4da17471b66d?w=120&q=80',
        'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=120&q=80',
        'https://images.unsplash.com/photo-1594824476967-48c8b964273f?w=120&q=80'
    ];
    function renderStars(avg) {
        var rounded = Math.round(avg * 2) / 2; // làm tròn 0.5
        var s = '';
        for (var i = 1; i <= 5; i++) {
            s += (i <= rounded) ? '<span style="color:#f59e0b;">★</span>' : '<span style="color:#d1d5db;">★</span>';
        }
        return s;
    }
    function parseYears(desc) {
        if (!desc) return '';
        var m = String(desc).match(/(\d+)\s*năm/);
        return m ? m[1] + ' năm KN' : '';
    }
    function renderDocCards(list) {
        var showcase = document.getElementById('doctorShowcase');
        if (!list || !list.length) {
            showcase.innerHTML = '<div style="font-size:12px;color:#7a9bb0;text-align:center;padding:20px">Đang cập nhật...</div>';
            return;
        }
        showcase.innerHTML = list.slice(0, 3).map(function(d, i) {
            var name    = d.fullName    || d.FullName    || '';
            var spec    = d.specialty   || d.Specialty   || 'Tai Mũi Họng';
            var desc    = d.description || d.Description || '';
            var rating  = parseFloat(d.averageRating || d.AverageRating || 0);
            var reviews = parseInt(d.reviewCount     || d.ReviewCount   || 0, 10);
            var years   = parseYears(desc);
            var avatar  = _docAvatars[i] || _docAvatars[0];
            var docId   = d.id || d.Id || d.doctorId || d.DoctorId || '';

            // Rút gọn specialty: bỏ prefix "Tai Mũi Họng — "
            var specShort = spec.replace(/^Tai M[uũ]i H[oọ]ng\s*[—–-]\s*/i, '').replace(/^TMH\s*[—–-]\s*/i, '');
            if (!specShort) specShort = spec;

            var ratingHtml = rating > 0
                ? '<div class="doc-rating-tag">' + renderStars(rating) +
                  ' ' + rating.toFixed(1) +
                  '<span class="r-count">&nbsp;(' + reviews + ' đánh giá)</span></div>'
                : '<div class="doc-rating-tag" style="color:#9ca3af;border-color:#e5e7eb;background:#f9fafb;">' +
                  '<span style="color:#d1d5db;">★★★★★</span>&nbsp;<span style="font-weight:400;">Chưa có</span></div>';

            var expHtml = years
                ? '<div class="doc-exp-tag">📅 ' + years + '</div>'
                : '';

            var bookHref = docId
                ? (_isLoggedIn ? '/Booking/Index?doctorId=' + docId : '/Account/Login?returnUrl=/Booking/Index?doctorId=' + docId)
                : (_isLoggedIn ? '/Booking/Index' : '/Account/Login?returnUrl=/Booking/Index');

            return '<a href="' + bookHref + '" class="doc-card-new">' +
                '<img class="doc-avt-new" src="' + avatar + '" onerror="this.src=\'https://ui-avatars.com/api/?name=' + encodeURIComponent(name) + '&background=0a4d7c&color=fff&size=50\'" />' +
                '<div class="doc-body-new">' +
                    '<div class="doc-name-new">' + name + '</div>' +
                    '<div class="doc-spec-chip">' + specShort + '</div>' +
                    '<div class="doc-stats">' + ratingHtml + expHtml + '</div>' +
                '</div>' +
            '</a>';
        }).join('');
    }
    fetch('/Booking/GetDoctorsJson')
        .then(function(r){ return r.json(); })
        .then(function(docs) { renderDocCards(docs); })
        .catch(function() {
            renderDocCards([
                { fullName: 'TS.BS. Nguyễn Thanh Vân', specialty: 'Tai Mũi Họng — Phẫu thuật nội soi xoang', description: '22 năm kinh nghiệm, BV TMH TW', averageRating: 4.9, reviewCount: 38 },
                { fullName: 'PGS.BS. Trần Minh Linh',  specialty: 'Tai Mũi Họng — Thính học & cấy ốc tai',   description: '18 năm kinh nghiệm, chuyên thính học', averageRating: 4.7, reviewCount: 24 },
                { fullName: 'TS.BS. Phạm Thị Hương',   specialty: 'TMH Nhi — Viêm tai giữa trẻ em',           description: '14 năm kinh nghiệm tại BV Nhi Đồng', averageRating: 4.8, reviewCount: 31 }
            ]);
        });

    
        // Hàm mở chatbot và tự động điền tin nhắn
        function openChatWithSymptom(msg) {
            var win = document.getElementById('tmhWindow');

            // 1. Kiểm tra xem khung chat đã mở chưa, nếu chưa thì gọi hàm tmhToggle() của bạn
            var isOpen = win && (win.style.display === 'flex' || win.classList.contains('open'));
            if (!isOpen && typeof tmhToggle === 'function') {
                tmhToggle();
            }

            // 2. Chờ 300ms để popup bật lên xong, rồi tìm ô nhập text và điền câu hỏi vào
            setTimeout(function() {
                if (win) {
                    // Tìm ô input bên trong chatbot (thường là thẻ input type="text" hoặc input có class chat)
                    var chatInput = win.querySelector('input[type="text"]') || win.querySelector('textarea');

                    if (chatInput) {
                        chatInput.value = msg; // Tự động điền câu: "Chào bác sĩ AI..."
                        chatInput.focus();     // Đặt con trỏ nhấp nháy vào ô đó luôn
                    }
                }
            }, 300);
        }

    resetTimer();
})();
</script>
