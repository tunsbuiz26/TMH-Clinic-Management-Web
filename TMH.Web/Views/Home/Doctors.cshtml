</section>

@section Scripts {
<script>
(function () {

    // Bảng màu avatar theo index
    var AVATAR_COLORS = [
        'linear-gradient(135deg,#0a4d7c,#1a6fa8)',
        'linear-gradient(135deg,#c9a227,#e0b93a)',
        'linear-gradient(135deg,#1a6fa8,#2a8fd8)',
        'linear-gradient(135deg,#2d7a52,#3aaa6a)',
        'linear-gradient(135deg,#7b4fa8,#a06fd8)',
        'linear-gradient(135deg,#c94040,#e06060)',
    ];

    // Map bằng cấp → chữ hiển thị và điểm sort
    var DEGREE_MAP = {
        'GS': { label:'Giáo sư', rank:5 },
        'PGS': { label:'Phó Giáo sư', rank:4 },
        'TS': { label:'Tiến sĩ Y khoa', rank:3 },
        'ThS': { label:'Thạc sĩ', rank:2 },
        'CKII': { label:'Chuyên khoa II', rank:2 },
        'CKI':  { label:'Chuyên khoa I', rank:1 },
        'BS':   { label:'Bác sĩ', rank:0 },
    };

    function getDegreeInfo(fullName, degreeRaw) {
        // Ưu tiên field Degree từ DTO nếu có
        if (degreeRaw) {
            for (var key of Object.keys(DEGREE_MAP)) {
                if (degreeRaw === key || degreeRaw.toUpperCase() === key) return DEGREE_MAP[key];
            }
            // Nếu không khớp prefix, trả về label nguyên
            return { label: degreeRaw, rank: 1 };
        }
        // Fallback: parse từ tên
        for (var prefix of Object.keys(DEGREE_MAP)) {
            if (fullName && fullName.startsWith(prefix + '.')) return DEGREE_MAP[prefix];
        }
        return { label:'Bác sĩ', rank:0 };
    }

    function getInitials(name) {
        // Lấy 2 chữ cái đầu của tên (bỏ học hàm phía trước)
        var clean = name.replace(/^(GS|PGS|TS|ThS|CKII|CKI|BS)\.(BS\.)?\s*/i, '').trim();
        var parts = clean.split(' ');
        if (parts.length >= 2) return (parts[0][0] + parts[parts.length-1][0]).toUpperCase();
        return clean.slice(0,2).toUpperCase();
    }

    function formatSlotDate(dateStr) {
        var d = new Date(dateStr);
        var days = ['CN','T2','T3','T4','T5','T6','T7'];
        var h = d.getHours().toString().padStart(2,'0');
        var m = d.getMinutes().toString().padStart(2,'0');
        return days[d.getDay()] + ', ' + h + ':' + m;
    }

    function renderStars(rating) {
        if (!rating) return '';
        var full = Math.round(rating);
        return '★'.repeat(full) + '☆'.repeat(5-full);
    }

    function buildCard(doc, index) {
        // === Field names khớp DoctorScheduleDto ===
        // doc.DoctorId | doc.FullName | doc.Degree | doc.Specialty
        // doc.AverageRating | doc.ReviewCount | doc.AvailableSlots[]
        // slot: { WorkDate, StartTime, EndTime, RemainingSlots, IsFull }

        var fullName  = doc.FullName  || doc.fullName  || doc.DoctorName || doc.doctorName || '';
        var degreeRaw = doc.Degree    || doc.degree    || '';
        var specialty = doc.Specialty || doc.specialty || 'Tai Mũi Họng';
        var docId     = doc.DoctorId  || doc.doctorId  || doc.Id || doc.id;
        var rating    = doc.AverageRating || doc.averageRating || 0;
        var reviewCnt = doc.ReviewCount   || doc.reviewCount   || 0;
        var slots     = doc.AvailableSlots || doc.availableSlots || [];
        var description = doc.Description || doc.description || '';

        var degInfo  = getDegreeInfo(fullName, degreeRaw);
        var initials = getInitials(fullName);
        var color    = AVATAR_COLORS[index % AVATAR_COLORS.length];

        // Availability dot
        var hasSlot      = slots.some(function(s){ return !(s.IsFull || s.isFull); });
        var dotColor     = hasSlot ? '#3aaa6a' : '#e0b93a';
        var dotText      = hasSlot ? 'Còn lịch tuần này' : 'Chưa có lịch trống';
        var dotTextColor = hasSlot ? '#9fdfbe' : '#f5d87a';

        // Slot chips — dùng WorkDate + StartTime
        var slotHtml = '';
        var validSlots = slots.filter(function(s){ return !(s.IsFull || s.isFull); });
        if (validSlots.length === 0) {
            slotHtml = '<span class="slot-empty">Chưa có lịch trống trong tuần</span>';
        } else {
            validSlots.slice(0, 5).forEach(function(s) {
                var dateStr = s.WorkDate || s.workDate || '';
                var timeStr = s.StartTime || s.startTime || '';
                var label;
                if (dateStr) {
                    var d = new Date(dateStr);
                    var days = ['CN','T2','T3','T4','T5','T6','T7'];
                    var t = timeStr.slice(0, 5); // "08:00"
                    label = days[d.getDay()] + ' ' + (d.getDate()) + '/' + (d.getMonth()+1) + ', ' + t;
                } else {
                    label = timeStr.slice(0,5);
                }
                slotHtml += '<span class="slot-chip" onclick="selectSlot(this)">' + label + '</span>';
            });
            if (validSlots.length > 5) {
                slotHtml += '<span class="slot-chip" style="background:#f7fafd;color:#7a9bb0;cursor:default">+'+(validSlots.length-5)+' ca</span>';
            }
        }

        var isLoggedIn = @(ViewBag.IsLoggedIn == true ? "true" : "false");
        var bookLink = isLoggedIn
            ? '/Booking/Index?doctorId=' + docId
            : '/Account/Login?returnUrl=/Booking/Index?doctorId=' + docId;

        return '<div class="doc-card-full"'
            + ' data-rating="' + rating + '"'
            + ' data-exp="0"'
            + ' data-degree="' + degInfo.rank + '"'
            + ' id="doc-' + docId + '">'
            + '<div class="doc-card-header">'
            + '<div class="doc-avt-full" style="background:' + color + '">' + initials + '</div>'
            + '<div class="doc-name-full">' + (fullName || 'Bác sĩ') + '</div>'
            + '<span class="doc-degree-chip">' + degInfo.label + '</span>'
            + (rating > 0
                ? '<div class="doc-stars-row">'
                  + '<span class="stars">' + renderStars(rating) + '</span>'
                  + '<span class="star-val">' + rating.toFixed(1) + '</span>'
                  + '<span class="star-cnt">(' + reviewCnt + ' lượt)</span>'
                  + '</div>'
                : '')
            + '<div class="doc-avail-row">'
            + '<span class="avail-dot" style="background:' + dotColor + '"></span>'
            + '<span style="color:' + dotTextColor + ';font-size:11px;">' + dotText + '</span>'
            + '</div>'
            + '</div>'
            + '<div class="doc-card-body">'
            + '<div class="doc-meta-list">'
            + '<div class="doc-meta-row"><span class="doc-meta-icon">🏥</span>Chuyên khoa: ' + specialty + '</div>'
            + (description ? '<div class="doc-meta-row"><span class="doc-meta-icon">📋</span>' + description + '</div>' : '')
            + '</div>'
            + '<div class="slot-section">'
            + '<div class="slot-label">📅 Lịch trống tuần này</div>'
            + '<div class="slot-chips">' + slotHtml + '</div>'
            + '</div>'
            + '</div>'
            + '<a href="' + bookLink + '" class="btn-book-full">📅 Đặt lịch khám</a>'
            + '</div>';
    }

    // ── Tải danh sách bác sĩ từ DB ──────────────────────────────────
    function loadDoctors() {
        fetch('/Booking/GetDoctorsJson')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var grid = document.getElementById('doctors-grid');
                var count = document.getElementById('result-count');
                if (!data || data.length === 0) {
                    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#7a9bb0;">Chưa có bác sĩ nào đang nhận lịch.</div>';
                    count.textContent = '0 bác sĩ';
                    return;
                }
                var html = '';
                data.forEach(function(doc, i) { html += buildCard(doc, i); });
                grid.innerHTML = html;
                count.textContent = data.length + ' bác sĩ';
            })
            .catch(function() {
                var grid = document.getElementById('doctors-grid');
                grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#e74c3c;">Không thể tải danh sách bác sĩ. Vui lòng thử lại.</div>';
                document.getElementById('result-count').textContent = '';
            });
    }

    loadDoctors();

    // ── Sắp xếp ─────────────────────────────────────────────────────
    window.sortDocs = function(by) {
        var grid = document.getElementById('doctors-grid');
        var cards = Array.from(grid.querySelectorAll('.doc-card-full'));
        if (cards.length === 0) return;
        cards.sort(function(a, b) {
            if (by === 'rating') return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
            if (by === 'exp')    return parseInt(b.dataset.exp)    - parseInt(a.dataset.exp);
            if (by === 'degree') return parseInt(b.dataset.degree) - parseInt(a.dataset.degree);
        });
        cards.forEach(function(c) { grid.appendChild(c); });
    };

    // ── Chọn slot ────────────────────────────────────────────────────
    window.selectSlot = function(el) {
        el.closest('.slot-chips').querySelectorAll('.slot-chip')
          .forEach(function(c) { c.classList.remove('selected'); });
        el.classList.add('selected');
    };

    // ── Mở chatbot góc phải kèm tin nhắn gợi ý ──────────────────────
    window.openChatWithSymptom = function(msg) {
        // Tìm nút toggle chatbot (tmhToggle được khai báo trong _Layout hoặc chatbot widget)
        if (typeof tmhToggle === 'function') {
            tmhToggle();
        } else {
            // Fallback: click nút toggle nổi nếu có
            var toggleBtn = document.querySelector('#tmh-chat-toggle, .chat-fab, [data-chat-toggle]');
            if (toggleBtn) toggleBtn.click();
        }
        // Điền tin nhắn vào ô chat sau khi chatbot mở
        setTimeout(function() {
            if (typeof tmhQuick === 'function') {
                tmhQuick(msg);
            } else {
                var input = document.querySelector('#tmh-chat-input, .chat-input, [data-chat-input]');
                if (input) {
                    input.value = msg;
                    input.focus();
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                }
            }
        }, 380);
    };

})();
</script>
}
