@{
    ViewBag.Title = "Bác sĩ — Phòng Khám Tai Mũi Họng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ===== PAGE HERO ===== */
.page-hero {
    background: linear-gradient(135deg,#f0f8ff 0%,#fff 60%);
    padding: 56px 40px 48px;
    position: relative; overflow: hidden;
    border-bottom: 1px solid #d4e8f5;
}
.page-hero::before {
    content:''; position:absolute; right:-80px; top:-80px;
    width:320px; height:320px; border-radius:50%;
    background:rgba(26,111,168,0.06); pointer-events:none;
}
.page-hero::after {
    content:''; position:absolute; left:60px; bottom:-60px;
    width:180px; height:180px; border-radius:50%;
    background:rgba(201,162,39,0.07); pointer-events:none;
}
.page-hero-inner { max-width:680px; position:relative; z-index:1; }
.page-breadcrumb {
    display:flex; align-items:center; gap:6px;
    font-size:12px; color:#7a9bb0; margin-bottom:16px;
}
.page-breadcrumb a { color:#1a6fa8; text-decoration:none; }
.page-breadcrumb a:hover { text-decoration:underline; }
.page-breadcrumb-sep { color:#b0c8db; }
.page-tag {
    display:inline-flex; align-items:center; gap:6px;
    background:#e8f4fd; color:#1a6fa8;
    border:1px solid rgba(26,111,168,0.25);
    border-radius:20px; padding:4px 12px;
    font-size:11px; font-weight:500;
    letter-spacing:.05em; text-transform:uppercase;
    margin-bottom:14px;
}
.page-title {
    font-family:'Crimson Pro',serif;
    font-size:38px; font-weight:600;
    color:#0a4d7c; line-height:1.2; margin-bottom:12px;
}
.page-title em { color:#c9a227; font-style:normal; }
.page-desc { font-size:14px; color:#3a5a72; line-height:1.7; max-width:560px; }

/* ===== SYMPTOM CARDS ===== */
.symptom-section {
    background:#fffbef;
    border-top:1px solid rgba(201,162,39,.15);
    border-bottom:1px solid rgba(201,162,39,.15);
    padding:44px 40px;
}
.symptom-header { margin-bottom:28px; }
.symptom-tag {
    display:inline-block; background:#fdf3d7; color:#c9a227;
    font-size:11px; font-weight:500; padding:4px 12px;
    border-radius:20px; letter-spacing:.05em; text-transform:uppercase;
    margin-bottom:10px;
}
.symptom-title {
    font-family:'Crimson Pro',serif; font-size:28px;
    font-weight:600; color:#0a4d7c; margin-bottom:6px;
}
.symptom-sub { font-size:13px; color:#7a9bb0; }
.symptom-grid {
    display:grid; grid-template-columns:repeat(4,1fr); gap:14px;
}
.symptom-card {
    background:#fff; border:1px solid rgba(201,162,39,.25);
    border-radius:14px; padding:22px 16px; text-align:center;
    cursor:pointer; transition:all .2s;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    text-decoration:none; color:inherit;
}
.symptom-card:hover {
    border-color:#c9a227; transform:translateY(-3px);
    box-shadow:0 8px 24px rgba(201,162,39,.15);
}
.symptom-icon { font-size:32px; line-height:1; }
.symptom-name { font-size:13px; font-weight:600; color:#0a4d7c; }
.symptom-hint { font-size:11px; color:#7a9bb0; line-height:1.5; }
.symptom-cta {
    display:inline-flex; align-items:center; gap:5px;
    margin-top:4px; font-size:11px; font-weight:500;
    color:#c9a227; background:#fdf3d7;
    padding:3px 10px; border-radius:20px;
}

/* ===== SECTION ===== */
.section { padding:52px 40px; }
.section-tag {
    display:inline-block; background:#e8f4fd; color:#1a6fa8;
    font-size:11px; font-weight:500; padding:4px 12px;
    border-radius:20px; letter-spacing:.05em; text-transform:uppercase;
    margin-bottom:10px;
}
.section-title {
    font-family:'Crimson Pro',serif; font-size:28px;
    font-weight:600; color:#0a4d7c; margin-bottom:6px;
}
.section-sub { font-size:13px; color:#7a9bb0; margin-bottom:32px; }

/* SORT BAR */
.sort-bar {
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:24px; flex-wrap:wrap; gap:12px;
}
.sort-left { display:flex; align-items:center; gap:8px; }
.sort-label { font-size:12px; color:#7a9bb0; }
.sort-select {
    height:32px; padding:0 12px; border-radius:8px;
    border:1px solid #d4e8f5; background:#fff;
    font-family:'DM Sans',sans-serif; font-size:12px; color:#0d2d44;
    outline:none; cursor:pointer;
}
.sort-select:focus { border-color:#1a6fa8; }
.result-count { font-size:12px; color:#7a9bb0; }

/* ===== DOCTOR CARDS ===== */
.doctors-grid-main {
    display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
}
.doc-card-full {
    background:#fff; border:1px solid #d4e8f5; border-radius:16px;
    overflow:hidden; transition:all .25s; display:flex; flex-direction:column;
}
.doc-card-full:hover { box-shadow:0 10px 32px rgba(10,77,124,.12); transform:translateY(-3px); }

.doc-card-header {
    padding:28px 20px 20px;
    background:linear-gradient(145deg,#0a4d7c 0%,#1a6fa8 100%);
    text-align:center; position:relative;
}
.doc-avt-full {
    width:76px; height:76px; border-radius:50%;
    background:rgba(255,255,255,.12); border:3px solid rgba(255,255,255,.2);
    display:flex; align-items:center; justify-content:center;
    font-family:'Crimson Pro',serif; font-size:26px; font-weight:600;
    color:#fff; margin:0 auto 12px; overflow:hidden;
}
.doc-avt-full img { width:100%; height:100%; object-fit:cover; }
.doc-name-full { font-size:15px; font-weight:600; color:#fff; margin-bottom:3px; }
.doc-degree-chip {
    display:inline-block;
    background:rgba(201,162,39,.2); border:1px solid rgba(201,162,39,.4);
    color:#f5d87a; font-size:10px; font-weight:600;
    padding:2px 10px; border-radius:20px; letter-spacing:.04em;
}
.doc-stars-row {
    display:flex; align-items:center; justify-content:center;
    gap:5px; margin-top:10px;
}
.stars { color:#f59e0b; font-size:13px; letter-spacing:1px; }
.star-val { font-size:13px; font-weight:700; color:#fff; }
.star-cnt { font-size:11px; color:rgba(255,255,255,.5); }
.doc-avail-row {
    margin-top:8px;
    display:flex; align-items:center; justify-content:center;
    gap:5px; font-size:11px; font-weight:500;
}
.avail-dot { width:6px; height:6px; border-radius:50%; display:inline-block; }

.doc-card-body { padding:18px 18px 0; flex:1; display:flex; flex-direction:column; }
.doc-meta-list { display:flex; flex-direction:column; gap:7px; margin-bottom:12px; }
.doc-meta-row {
    display:flex; align-items:flex-start; gap:8px;
    font-size:12px; color:#3a5a72; line-height:1.5;
}
.doc-meta-icon { flex-shrink:0; width:16px; text-align:center; }
.doc-card-desc {
    font-size:12px; color:#7a9bb0; line-height:1.6;
    margin-bottom:14px; flex:1;
}

/* Slots */
.slot-section { margin-bottom:14px; }
.slot-label {
    font-size:10px; font-weight:600; color:#3a5a72;
    letter-spacing:.05em; text-transform:uppercase; margin-bottom:7px;
    display:flex; align-items:center; gap:6px;
}
.slot-chips { display:flex; flex-wrap:wrap; gap:5px; min-height:28px; }
.slot-chip {
    height:26px; padding:0 10px; border-radius:6px;
    font-size:11px; font-weight:500; cursor:pointer;
    background:#e8f4fd; color:#1a6fa8;
    border:1px solid rgba(26,111,168,.15);
    font-family:'DM Sans',sans-serif; transition:all .15s;
}
.slot-chip:hover { background:#0a4d7c; color:#fff; border-color:#0a4d7c; }
.slot-chip.unavail { background:#f5f5f5; color:#b0c8db; cursor:not-allowed; border-color:#e8e8e8; }
.slot-loading { font-size:11px; color:#b0c8db; font-style:italic; }
.slot-empty { font-size:11px; color:#b0c8db; }

.btn-book-full {
    display:flex; align-items:center; justify-content:center;
    height:38px; border-radius:0 0 14px 14px;
    background:#e8f4fd; color:#0a4d7c;
    border:none; border-top:1px solid #d4e8f5;
    font-size:13px; font-weight:500; cursor:pointer;
    font-family:'DM Sans',sans-serif; text-decoration:none;
    transition:all .15s; margin-top:auto;
}
.btn-book-full:hover { background:#0a4d7c; color:#fff; }

/* Skeleton loading */
.doc-skeleton {
    border-radius:16px; overflow:hidden; border:1px solid #e8f2fa;
    display:flex; flex-direction:column;
}
.sk-header { height:160px; background:#e8f2fa; }
.sk-body { padding:18px; display:flex; flex-direction:column; gap:10px; }
.sk-line { border-radius:6px; background:linear-gradient(90deg,#f0f0f0 25%,#e8e8e8 50%,#f0f0f0 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; }
@@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* ===== CTA ===== */
.cta-strip {
    background:linear-gradient(135deg,#c9a227 0%,#e0b93a 100%);
    padding:48px 40px; text-align:center;
}
.cta-title { font-family:'Crimson Pro',serif; font-size:28px; font-weight:600; color:#fff; margin-bottom:10px; }
.cta-desc { font-size:14px; color:rgba(255,255,255,.85); margin-bottom:28px; line-height:1.65; }
.btn-cta {
    display:inline-flex; align-items:center; gap:8px;
    height:44px; padding:0 28px; border-radius:10px;
    background:#0a4d7c; color:#fff; font-size:14px; font-weight:500;
    text-decoration:none; font-family:'DM Sans',sans-serif;
    transition:background .15s; cursor:pointer; border:none;
}
.btn-cta:hover { background:#1a6fa8; }

@@media(max-width:900px){
    .doctors-grid-main { grid-template-columns:1fr; }
    .symptom-grid { grid-template-columns:repeat(2,1fr); }
    .page-hero,.section,.symptom-section { padding-left:20px; padding-right:20px; }
}
</style>
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="page-hero-inner">
        <div class="page-breadcrumb">
            <a href="/">Trang chủ</a>
            <span class="page-breadcrumb-sep">/</span>
            <span>Đội ngũ bác sĩ</span>
        </div>
        <div class="page-tag">⚕️ Chuyên gia TMH</div>
        <h1 class="page-title">Đội ngũ bác sĩ<br>chuyên khoa <em>Tai · Mũi · Họng</em></h1>
