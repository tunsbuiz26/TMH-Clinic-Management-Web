                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="hong">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">🗣️</div>
                <div class="svc-card-name">Khám Họng &amp; Amidan</div>
                <p class="svc-card-desc">Điều trị viêm họng, amidan mãn tính, khàn tiếng và rối loạn giọng nói.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 15–25 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
