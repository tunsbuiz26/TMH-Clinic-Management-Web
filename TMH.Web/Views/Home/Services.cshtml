                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="hong phau noisy">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">🎙️</div>
                <div class="svc-card-name">Điều trị rối loạn giọng nói</div>
                <p class="svc-card-desc">Hạt xơ dây thanh, polyp thanh quản, liệt dây thanh — nội soi vi phẫu hoặc nội khoa.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 20–30 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="nhi tai hong mui">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">👶</div>
                <div class="svc-card-name">TMH Nhi khoa</div>
                <p class="svc-card-desc">Khám và điều trị tai mũi họng cho trẻ em từ sơ sinh: viêm tai giữa, VA, amidan.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ Từ 3 tuổi</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="mui noisy">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">📷</div>
                <div class="svc-card-name">Nội soi mũi xoang chức năng</div>
                <p class="svc-card-desc">Nội soi can thiệp mũi xoang — rửa xoang, sinh thiết, lấy polyp nhỏ tại chỗ.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 20–35 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

    </div>
</section>

<!-- QUY TRÌNH KHÁM -->
<section class="section section-navy">
    <div style="text-align:center;margin-bottom:0">
        <div class="section-tag section-tag-white">Quy trình</div>
        <div class="section-title section-title-white" style="text-align:center;margin-bottom:6px">Quy trình khám — nhanh &amp; đơn giản</div>
        <div class="section-sub section-sub-white" style="text-align:center;margin-bottom:0">Từ đặt lịch đến nhận kết quả, mọi bước đều minh bạch</div>
    </div>
    <div class="process-grid">
        <div class="process-step">
            <div class="step-num">1</div>
            <div class="step-title">Đặt lịch online</div>
            <p class="step-desc">Chọn bác sĩ &amp; khung giờ trực tiếp — không cần gọi điện, xác nhận trong 15 phút.</p>
        </div>
        <div class="process-step">
            <div class="step-num">2</div>
            <div class="step-title">Tư vấn triệu chứng</div>
            <p class="step-desc">Nhắn tin với trợ lý AI để được tư vấn bác sĩ phù hợp — nhanh, miễn phí.</p>
        </div>
        <div class="process-step">
            <div class="step-num">3</div>
            <div class="step-title">Đến khám đúng giờ</div>
            <p class="step-desc">Check-in nhanh tại lễ tân. Không chờ đợi lâu, bác sĩ đón tiếp đúng lịch hẹn.</p>
        </div>
        <div class="process-step">
            <div class="step-num">4</div>
            <div class="step-title">Nhận kết quả &amp; đơn thuốc</div>
            <p class="step-desc">Kết quả và đơn thuốc lưu trong hồ sơ bệnh nhân điện tử, truy cập mọi lúc.</p>
        </div>
    </div>
   
</section>

<!-- BẢNG GIÁ — 1 GÓI DUY NHẤT -->
<section class="price-section">
    <div class="section-tag">Chi phí</div>
    <div class="section-title">Giá khám rõ ràng, không phụ phí bất ngờ</div>
    <div class="section-sub">Một mức giá thống nhất — bao gồm toàn bộ dịch vụ khám cơ bản</div>

    <div class="price-wrap">

        <!-- Header giá -->
        <div class="price-header">
            <div>
                <div class="price-badge">✦ Gói khám chuẩn duy nhất</div>
                <div class="price-name-big">Khám Tai Mũi Họng toàn diện</div>
                <div class="price-tagline">Áp dụng cho tất cả bác sĩ · Mọi chuyên khoa TMH</div>
            </div>
            <div>
                <div class="price-amount-big">100K</div>
                <div class="price-unit-big">đồng / lượt khám</div>
            </div>
        </div>

        <!-- Nội dung gói -->
        <div class="price-body">
            <div>
                <div class="price-col-title">✓ Bao gồm trong giá 100K</div>
                <ul class="price-feat-list">
                    <li><span class="chk">✓</span>Khám lâm sàng Tai Mũi Họng đầy đủ</li>
                    <li><span class="chk">✓</span>Nội soi chẩn đoán bằng camera HD (nếu cần)</li>
                    <li><span class="chk">✓</span>Tư vấn phác đồ điều trị cá nhân hóa</li>
                    <li><span class="chk">✓</span>Đơn thuốc điện tử (nếu có chỉ định)</li>
                    <li><span class="chk">✓</span>Hồ sơ bệnh nhân điện tử — lưu vĩnh viễn</li>
                    <li><span class="chk">✓</span>Kết quả tư vấn trong ngày</li>
                </ul>
            </div>
            <div>
                <div class="price-col-title">📋 Tính thêm nếu có chỉ định</div>
                <ul class="price-feat-list">
                    <li><span class="chk chk-gray">i</span>Thuốc điều trị — theo đơn bác sĩ</li>
                    <li><span class="chk chk-gray">i</span>Phẫu thuật &amp; thủ thuật — báo giá trước</li>
                    <li><span class="chk chk-gray">i</span>Xét nghiệm máu / chẩn đoán hình ảnh</li>
                    <li><span class="chk chk-gray">i</span>Đo thính lực chuyên sâu có yêu cầu riêng</li>
                </ul>
            </div>
        </div>

        <!-- Ưu đãi tái khám -->
        <div class="retour-banner">
            <div class="retour-icon">🎁</div>
            <div>
                <div class="retour-title">Ưu đãi tái khám — dành riêng cho bệnh nhân cũ</div>
                <div class="retour-desc">
                    Bệnh nhân quay lại tái khám trong vòng <strong>30 ngày</strong> kể từ lần khám trước
                    được hưởng ưu đãi đặc biệt. Hệ thống tự động nhận diện hồ sơ tái khám — không cần khai báo lại.
                </div>
                <div class="retour-chips">
                    <span class="retour-chip">🔁 Miễn phí tư vấn theo dõi</span>
                    <span class="retour-chip">📋 Hồ sơ liên tục không khai lại</span>
                    <span class="retour-chip">⚡ Ưu tiên xếp lịch sớm hơn</span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="price-footer">
            <p class="price-note-inline">* Giá có thể thay đổi theo từng thời kỳ. Vui lòng liên hệ phòng khám để xác nhận.</p>
            @if (ViewBag.IsLoggedIn == true) {
                <a asp-controller="Booking" asp-action="Index" class="btn-book-price">📅 Đặt lịch khám ngay</a>
            } else {
                <a asp-controller="Account" asp-action="Register" class="btn-book-price">📅 Đặt lịch khám ngay</a>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-strip">
    <div class="cta-title">Chưa biết nên khám dịch vụ nào?</div>
    <p class="cta-desc">Mô tả triệu chứng với trợ lý AI của chúng tôi — tư vấn ngay lập tức, hoàn toàn miễn phí.</p>
    <button class="btn-cta" onclick="openChatWithSymptom('Tôi muốn được tư vấn về dịch vụ khám tai mũi họng')">💬 Nhắn tin với AI ngay</button>
</section>

@section Scripts {
<script>
function filterSvc(btn, cat) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#svc-grid .svc-card-main').forEach(card => {
        const cats = card.dataset.cat || '';
        card.style.display = (cat === 'all' || cats.split(' ').includes(cat)) ? '' : 'none';
    });
}
window.openChatWithSymptom = function(msg) {
    if (typeof tmhToggle === 'function') { tmhToggle(); }
    else { var b = document.querySelector('#tmh-chat-toggle,.chat-fab,[data-chat-toggle]'); if(b) b.click(); }
    setTimeout(function() {
        if (typeof tmhQuick === 'function') { tmhQuick(msg); }
        else { var i = document.querySelector('#tmh-chat-input,.chat-input,[data-chat-input]'); if(i){i.value=msg;i.focus();i.dispatchEvent(new Event('input',{bubbles:true}));} }
    }, 380);
};
</script>
}
