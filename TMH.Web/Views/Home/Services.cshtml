@{
    ViewBag.Title = "Dịch vụ — Phòng Khám Tai Mũi Họng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ===== PAGE HERO ===== */
.page-hero {
    background:linear-gradient(135deg,#f0f8ff 0%,#fff 60%);
    padding:56px 40px 48px; position:relative; overflow:hidden;
    border-bottom:1px solid #d4e8f5;
}
.page-hero::before {
    content:''; position:absolute; right:-80px; top:-80px;
    width:320px; height:320px; border-radius:50%;
    background:rgba(26,111,168,0.06); pointer-events:none;
}
.page-hero-inner { max-width:680px; position:relative; z-index:1; }
.page-breadcrumb {
    display:flex; align-items:center; gap:6px;
    font-size:12px; color:#7a9bb0; margin-bottom:16px;
}
.page-breadcrumb a { color:#1a6fa8; text-decoration:none; }
.page-breadcrumb-sep { color:#b0c8db; }
.page-tag {
    display:inline-flex; align-items:center; gap:6px;
    background:#e8f4fd; color:#1a6fa8;
    border:1px solid rgba(26,111,168,0.25);
    border-radius:20px; padding:4px 12px;
    font-size:11px; font-weight:500; letter-spacing:.05em; text-transform:uppercase;
    margin-bottom:14px;
}
.page-title {
    font-family:'Crimson Pro',serif; font-size:38px; font-weight:600;
    color:#0a4d7c; line-height:1.2; margin-bottom:12px;
}
.page-title em { color:#c9a227; font-style:normal; }
.page-desc { font-size:14px; color:#3a5a72; line-height:1.7; max-width:540px; }

/* ===== FILTER BAR ===== */
.filter-bar {
    background:#fff; border-bottom:1px solid #d4e8f5;
    padding:0 40px; position:sticky; top:0; z-index:50;
    box-shadow:0 2px 8px rgba(10,77,124,.05);
}
.filter-inner {
    display:flex; align-items:center; gap:8px;
    height:54px; overflow-x:auto; scrollbar-width:none;
}
.filter-inner::-webkit-scrollbar { display:none; }
.filter-btn {
    height:32px; padding:0 16px; border-radius:20px;
    font-size:12px; font-weight:500; border:1px solid #d4e8f5;
    background:#fff; color:#3a5a72; cursor:pointer; white-space:nowrap;
    font-family:'DM Sans',sans-serif; transition:all .15s;
}
.filter-btn:hover { border-color:#1a6fa8; color:#1a6fa8; }
.filter-btn.active { background:#0a4d7c; color:#fff; border-color:#0a4d7c; }

/* ===== SECTION ===== */
.section { padding:52px 40px; }
.section-navy { background:#0a4d7c; }
.section-tag {
    display:inline-block; background:#e8f4fd; color:#1a6fa8;
    font-size:11px; font-weight:500; padding:4px 12px;
    border-radius:20px; letter-spacing:.05em; text-transform:uppercase; margin-bottom:10px;
}
.section-tag-white { background:rgba(255,255,255,.15); color:#b8ddf8; }
.section-title { font-family:'Crimson Pro',serif; font-size:28px; font-weight:600; color:#0a4d7c; margin-bottom:6px; }
.section-title-white { color:#fff; }
.section-sub { font-size:13px; color:#7a9bb0; margin-bottom:32px; }
.section-sub-white { color:rgba(255,255,255,.65); }

/* ===== SERVICES GRID ===== */
.services-grid-main {
    display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:32px;
}
.svc-card-main {
    background:#fff; border:1px solid #d4e8f5; border-radius:14px;
    overflow:hidden; transition:all .2s; display:flex; flex-direction:column;
}
.svc-card-main::before {
    content:''; display:block; height:3px;
    background:#0a4d7c; transform:scaleX(0); transition:transform .2s; transform-origin:left;
}
.svc-card-main:hover { border-color:#1a6fa8; transform:translateY(-3px); box-shadow:0 8px 24px rgba(10,77,124,.1); }
.svc-card-main:hover::before { transform:scaleX(1); }
.svc-card-top { padding:22px 20px 16px; flex:1; }
.svc-card-icon-wrap {
    width:42px; height:42px; border-radius:11px; background:#e8f4fd;
    display:flex; align-items:center; justify-content:center; margin-bottom:14px; font-size:20px;
}
.svc-card-name { font-size:14px; font-weight:600; color:#0a4d7c; margin-bottom:6px; }
.svc-card-desc { font-size:12px; color:#7a9bb0; line-height:1.55; }
.svc-card-bot {
    padding:12px 20px; background:#f7fafd; border-top:1px solid #e8f2fa;
    display:flex; align-items:center; justify-content:space-between;
}
.svc-card-time { font-size:11px; color:#7a9bb0; }
.svc-card-link { font-size:12px; font-weight:500; color:#1a6fa8; text-decoration:none; }
.svc-card-link:hover { text-decoration:underline; }

/* ===== QUY TRÌNH ===== */
.process-grid {
    display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:32px;
}
.process-step { text-align:center; padding:20px 14px; position:relative; }
.process-step:not(:last-child)::after {
    content:'→'; position:absolute; top:24px; right:-10px;
    font-size:18px; color:rgba(255,255,255,.25);
}
.step-num {
    width:48px; height:48px; border-radius:50%;
    background:rgba(255,255,255,.12); border:2px solid rgba(255,255,255,.25);
    color:#b8ddf8; font-family:'Crimson Pro',serif; font-size:20px; font-weight:700;
    display:flex; align-items:center; justify-content:center; margin:0 auto 14px;
}
.step-title { font-size:14px; font-weight:600; color:#fff; margin-bottom:6px; }
.step-desc { font-size:12px; color:rgba(255,255,255,.6); line-height:1.6; }

/* ===== BẢNG GIÁ 1 GÓI ===== */
.price-section { padding:52px 40px; background:#f0f8ff; }
.price-wrap {
    max-width:820px; margin:32px auto 0;
    background:#fff; border-radius:20px;
    border:1px solid #d4e8f5;
    box-shadow:0 8px 40px rgba(10,77,124,.1);
    overflow:hidden;
}
.price-header {
    background:linear-gradient(135deg,#0a4d7c 0%,#1a6fa8 100%);
    padding:36px 40px; display:flex; align-items:center;
    justify-content:space-between; gap:24px; flex-wrap:wrap;
}
.price-badge {
    display:inline-block; background:rgba(201,162,39,.25);
    border:1px solid rgba(201,162,39,.5); color:#f5d87a;
    font-size:10px; font-weight:700; padding:3px 12px;
    border-radius:20px; letter-spacing:.06em; text-transform:uppercase; margin-bottom:10px;
}
.price-name-big {
    font-family:'Crimson Pro',serif; font-size:26px; font-weight:600;
    color:#fff; margin-bottom:6px;
}
.price-tagline { font-size:13px; color:rgba(255,255,255,.65); }
.price-amount-big {
    font-family:'Crimson Pro',serif; font-size:52px; font-weight:700;
    color:#f5d87a; line-height:1;
}
.price-unit-big { font-size:13px; color:rgba(255,255,255,.55); margin-top:4px; text-align:right; }
.price-body {
    padding:36px 40px; display:grid;
    grid-template-columns:1fr 1fr; gap:32px;
}
.price-col-title {
    font-size:11px; font-weight:600; color:#1a6fa8;
    letter-spacing:.06em; text-transform:uppercase; margin-bottom:14px;
}
.price-feat-list { list-style:none; display:flex; flex-direction:column; gap:10px; }
.price-feat-list li {
    display:flex; align-items:flex-start; gap:10px;
    font-size:13px; color:#3a5a72; line-height:1.5;
}
.chk {
    width:20px; height:20px; border-radius:50%;
    background:#0a4d7c; color:#fff; font-size:10px; font-weight:700;
    display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;
}
.chk-gray { background:#7a9bb0; }
.retour-banner {
    margin:0 40px 36px; padding:18px 22px;
    background:linear-gradient(135deg,#fffbef,#fff9e6);
    border:1.5px solid rgba(201,162,39,.35);
    border-radius:14px; display:flex; align-items:flex-start; gap:14px;
}
.retour-icon { font-size:28px; flex-shrink:0; }
.retour-title { font-size:14px; font-weight:600; color:#0a4d7c; margin-bottom:4px; }
.retour-desc { font-size:12px; color:#7a9bb0; line-height:1.6; }
.retour-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.retour-chip {
    display:inline-flex; align-items:center; gap:5px;
    background:#fdf3d7; color:#c9a227;
    font-size:11px; font-weight:500; padding:3px 10px; border-radius:20px;
}
.price-footer {
    padding:20px 40px 36px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
}
.price-note-inline { font-size:11px; color:#b0c8db; }
.btn-book-price {
    display:inline-flex; align-items:center; gap:8px;
    height:42px; padding:0 28px; border-radius:10px;
    background:#0a4d7c; color:#fff; font-size:14px; font-weight:500;
    text-decoration:none; font-family:'DM Sans',sans-serif; transition:background .15s;
}
.btn-book-price:hover { background:#1a6fa8; }

/* ===== CTA ===== */
.cta-strip {
    background:linear-gradient(135deg,#c9a227 0%,#e0b93a 100%);
    padding:48px 40px; text-align:center;
}
.cta-title { font-family:'Crimson Pro',serif; font-size:28px; font-weight:600; color:#fff; margin-bottom:10px; }
.cta-desc { font-size:14px; color:rgba(255,255,255,.85); margin-bottom:28px; line-height:1.65; }
.btn-cta {
    display:inline-flex; align-items:center; gap:8px;
    height:44px; padding:0 28px; border-radius:10px;
    background:#0a4d7c; color:#fff; font-size:14px; font-weight:500;
    font-family:'DM Sans',sans-serif; transition:background .15s;
    cursor:pointer; border:none; text-decoration:none;
}
.btn-cta:hover { background:#1a6fa8; }

@@media(max-width:900px){
    .services-grid-main,.process-grid { grid-template-columns:1fr; }
    .price-body { grid-template-columns:1fr; gap:20px; }
    .price-header { flex-direction:column; }
    .price-unit-big { text-align:left; }
    .page-hero,.section,.price-section { padding-left:20px; padding-right:20px; }
    .price-body,.price-footer,.retour-banner { padding-left:20px; padding-right:20px; }
    .filter-bar { padding:0 20px; }
}
</style>
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="page-hero-inner">
        <div class="page-breadcrumb">
            <a href="/">Trang chủ</a>
            <span class="page-breadcrumb-sep">/</span>
            <span>Dịch vụ</span>
        </div>
        <div class="page-tag">Chuyên khoa TMH</div>
        <h1 class="page-title">Dịch vụ khám &amp; điều trị<br><em>Tai · Mũi · Họng</em> toàn diện</h1>
        <p class="page-desc">Từ thăm khám thông thường đến phẫu thuật chuyên sâu — một địa chỉ, đội ngũ chuyên gia và thiết bị nội soi thế hệ mới.</p>
    </div>
</section>

<!-- FILTER BAR -->
<div class="filter-bar">
    <div class="filter-inner">
        <button class="filter-btn active" onclick="filterSvc(this,'all')">Tất cả</button>
        <button class="filter-btn" onclick="filterSvc(this,'tai')">👂 Tai &amp; Thính học</button>
        <button class="filter-btn" onclick="filterSvc(this,'mui')">🤧 Mũi &amp; Xoang</button>
        <button class="filter-btn" onclick="filterSvc(this,'hong')">🗣️ Họng &amp; Thanh quản</button>
        <button class="filter-btn" onclick="filterSvc(this,'phau')">🏥 Phẫu thuật</button>
        <button class="filter-btn" onclick="filterSvc(this,'noisy')">🔭 Nội soi</button>
        <button class="filter-btn" onclick="filterSvc(this,'nhi')">👶 Nhi khoa</button>
    </div>
</div>

<!-- DANH MỤC DỊCH VỤ -->
<section class="section" id="svc-featured">
    <div class="section-tag">Danh mục dịch vụ</div>
    <div class="section-title">Tất cả dịch vụ</div>
    <div class="section-sub">Chọn nhóm bằng bộ lọc phía trên để xem nhanh</div>

    <div class="services-grid-main" id="svc-grid">

        <div class="svc-card-main" data-cat="tai noisy">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">🔭</div>
                <div class="svc-card-name">Nội soi Tai Mũi Họng</div>
                <p class="svc-card-desc">Nội soi chẩn đoán bằng camera HD, hình ảnh sắc nét, không đau, thời gian nhanh.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 10–20 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="tai">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">📊</div>
                <div class="svc-card-name">Đo thính lực toàn diện</div>
                <p class="svc-card-desc">Audiometry đơn âm, ngôn ngữ, nhĩ lượng đồ — đánh giá chức năng nghe chính xác.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 30–40 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
                    <a href="/Account/Login" class="svc-card-link">Đặt lịch →</a>
                }
            </div>
        </div>

        <div class="svc-card-main" data-cat="mui noisy">
            <div class="svc-card-top">
                <div class="svc-card-icon-wrap">🤧</div>
                <div class="svc-card-name">Khám Mũi &amp; Viêm xoang</div>
                <p class="svc-card-desc">Thăm khám nghẹt mũi, viêm mũi dị ứng, polyp mũi và các bệnh lý xoang mãn tính.</p>
            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 20–30 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Đặt lịch →</a>
                } else {
