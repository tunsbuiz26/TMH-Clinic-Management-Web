            </div>
            <div class="svc-card-bot">
                <span class="svc-card-time">⏱ 30–45 phút</span>
                @if (ViewBag.IsLoggedIn == true) {
                    <a href="/Booking/Index" class="svc-card-link">Tư vấn →</a>
                } else {
