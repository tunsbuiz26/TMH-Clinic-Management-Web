@model List<TMH.Shared.DTOs.DoctorScheduleDto>
@{
    ViewBag.Title = "Đặt lịch khám";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patients = ViewBag.Patients as List<TMH.Shared.DTOs.PatientDto> ?? new List<TMH.Shared.DTOs.PatientDto>();
    var preselectedDoctorId = Context.Request.Query["doctorId"].ToString();
}
<style>
    @@keyframes pulse-green {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0.5);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(34,197,94,0);
        }
    }

    @@keyframes dot-blink {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.4;
            transform: scale(0.75);
        }
    }

    .book-wrap {
        max-width: 860px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .book-title {
        font-family: 'Crimson Pro',serif;
        font-size: 28px;
        font-weight: 600;
        color: #0a4d7c;
        margin-bottom: 6px;
    }

    .book-sub {
        font-size: 13px;
        color: #7a9bb0;
        margin-bottom: 28px;
    }

    .step-bar {
        display: flex;
        gap: 0;
        margin-bottom: 28px;
    }

    .step-item {
        flex: 1;
        text-align: center;
        padding: 10px;
        font-size: 12px;
        font-weight: 500;
        color: #7a9bb0;
        border-bottom: 2px solid #d4e8f5;
    }

        .step-item.active {
            color: #0a4d7c;
            border-color: #0a4d7c;
        }

        .step-item.done {
            color: #2d7a52;
            border-color: #2d7a52;
        }

    /* ===== FILTER CHIPS ===== */
    .filter-chips {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }
    .filter-chip {
        height: 30px;
        padding: 0 14px;
        border: 1.5px solid #d4e8f5;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        color: #7a9bb0;
        background: #fff;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: all .15s;
        white-space: nowrap;
    }
    .filter-chip:hover { border-color: #1a6fa8; color: #1a6fa8; background: #f0f8ff; }
    .filter-chip.active { border-color: #0a4d7c; color: #0a4d7c; background: #e8f4fd; font-weight: 600; }

    .doctor-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .doc-card {
        border: 1.5px solid #d4e8f5;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: border-color .15s,background .15s;
    }

        .doc-card:hover {
            border-color: #1a6fa8;
            background: #f0f8ff;
        }

        .doc-card.selected {
            border-color: #0a4d7c;
            background: #e8f4fd;
        }

        /* Bác sĩ được AI gợi ý */
        .doc-card.ai-recommended {
            border-color: #0a4d7c;
            box-shadow: 0 0 0 3px rgba(10,77,124,.12);
            position: relative;
        }
        .doc-card.ai-recommended::before {
            content: '✦ AI Gợi ý';
            position: absolute;
            top: -1px; right: -1px;
            background: linear-gradient(90deg, #0a4d7c, #1a6fa8);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 0 11px 0 8px;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        /* Bác sĩ đã từng khám */
        .doc-card.past-doctor {
            border-color: #2d7a52;
            box-shadow: 0 0 0 2px rgba(45,122,82,.10);
            position: relative;
        }
        .doc-card.past-doctor::before {
            content: '✔ Đã từng khám';
            position: absolute;
            top: -1px; right: -1px;
            background: linear-gradient(90deg, #2d7a52, #3a9966);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 0 11px 0 8px;
            letter-spacing: .04em;
        }

    /* Bác sĩ hết lịch — không cho click */
    .doc-card--unavailable {
        opacity: 0.75;
        cursor: default;
        border-color: #e2e8f0;
        background: #f8fafc;
    }
    .doc-card--unavailable:hover {
        border-color: #e2e8f0;
        background: #f8fafc;
    }

    .doc-slots--full {
        color: #f59e0b;
        font-size: 12px;
        margin-top: 4px;
    }

    .doc-rating {
        font-size: 12px;
        color: #f59e0b;
        margin-top: 4px;
    }
    .doc-rating-none {
        color: #94a3b8;
    }

    .btn-pending-booking {
        margin-top: 10px;
        width: 100%;
        padding: 7px 0;
        background: #fff;
        border: 1.5px solid #d97706;
        color: #92400e;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .15s;
    }
    .btn-pending-booking:hover {
        background: #fef9c3;
    }

    /* ===== PAST DOCTOR SECTION ===== */
    .past-doc-section {
        margin-bottom: 20px;
        display: none;
    }
    .past-doc-label {
        font-size: 11.5px;
        font-weight: 600;
        color: #2d7a52;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .past-doc-label::before {
        content: '';
        display: inline-block;
        width: 3px; height: 14px;
        background: #2d7a52;
        border-radius: 2px;
    }

    /* ===== AI RESULT LABEL ===== */
    .ai-rec-result-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(90deg, #0a4d7c, #1a6fa8);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .doc-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #0a4d7c;
        color: #fff;
        font-family: 'Crimson Pro',serif;
        font-size: 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

    .doc-name {
        font-size: 13px;
        font-weight: 500;
        color: #0a4d7c;
        margin-bottom: 3px;
    }

    .doc-spec {
        font-size: 11px;
        color: #c9a227;
        font-weight: 500;
        margin-bottom: 6px;
    }

    .doc-slots {
        font-size: 11px;
        color: #7a9bb0;
    }

    /* ===== AI RECOMMENDATION PANEL ===== */
    .ai-rec-panel {
        background: linear-gradient(135deg, #f0f8ff 0%, #e8f4fd 100%);
        border: 1.5px solid #b3d7f0;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 20px;
        position: relative;
    }
    .ai-rec-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }
    .ai-rec-badge {
        background: linear-gradient(90deg, #0a4d7c, #1a6fa8);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: .06em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .ai-rec-title {
        font-size: 13px;
        font-weight: 600;
        color: #0a4d7c;
    }
    .ai-rec-sub {
        font-size: 11.5px;
        color: #6b8fa8;
        margin-bottom: 12px;
        line-height: 1.5;
    }
    .ai-rec-input-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }
    .ai-rec-textarea {
        flex: 1;
        height: 70px;
        border: 1.5px solid #b3d7f0;
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 13px;
        color: #0d2d44;
        background: #fff;
        outline: none;
        font-family: 'DM Sans', sans-serif;
        resize: none;
        transition: border-color .15s;
        box-sizing: border-box;
    }
    .ai-rec-textarea:focus {
        border-color: #0a4d7c;
        box-shadow: 0 0 0 3px rgba(10,77,124,.08);
    }
    .ai-rec-btn {
        height: 70px;
        padding: 0 18px;
        background: linear-gradient(135deg, #0a4d7c, #1a6fa8);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        white-space: nowrap;
        transition: all .18s;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-width: 110px;
    }
    .ai-rec-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #083d62, #155d8a);
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(10,77,124,.25);
    }
    .ai-rec-btn:disabled {
        opacity: .6;
        cursor: not-allowed;
        transform: none;
    }
    /* Kết quả gợi ý */
    .ai-rec-result {
        margin-top: 14px;
        background: #fff;
        border: 1.5px solid #0a4d7c;
        border-radius: 12px;
        padding: 16px 18px;
        display: none;
        animation: fadeInUp .3s ease;
    }
    @@keyframes fadeInUp {
        from { opacity:0; transform:translateY(8px); }
        to   { opacity:1; transform:translateY(0); }
    }
    .ai-rec-result-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
    }
    .ai-rec-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0a4d7c, #1a6fa8);
        color: #fff;
        font-family: 'Crimson Pro', serif;
        font-size: 17px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .ai-rec-doctor-name  { font-size: 14px; font-weight: 700; color: #0a4d7c; margin-bottom: 2px; }
    .ai-rec-doctor-spec  { font-size: 11.5px; color: #c9a227; font-weight: 600; }
    .ai-rec-reason {
        font-size: 12.5px;
        color: #3a5a72;
        line-height: 1.65;
        margin-bottom: 14px;
        padding: 10px 14px;
        background: #f5fbff;
        border-radius: 8px;
        border-left: 3px solid #1a6fa8;
    }
    .ai-rec-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }
    .ai-rec-select-btn {
        padding: 9px 20px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .15s;
    }
    .ai-rec-select-btn:hover { background: #083d62; }
    .ai-rec-dismiss {
        font-size: 12px;
        color: #94a3b8;
        cursor: pointer;
        background: none;
        border: none;
        font-family: 'DM Sans', sans-serif;
        padding: 0;
        text-decoration: underline;
    }
    .ai-rec-dismiss:hover { color: #64748b; }
    .ai-rec-error {
        margin-top: 10px;
        font-size: 12px;
        color: #c0392b;
        display: none;
    }
    /* Loading spinner nhỏ */
    .ai-spin {
        display: inline-block;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        vertical-align: middle;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Slot */
    .slot-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 10px;
        margin-bottom: 24px;
    }

    .slot-btn {
        position: relative;
        border: 1.5px solid #bbf7d0;
        border-radius: 10px;
        padding: 12px 8px;
        font-size: 12px;
        font-weight: 500;
        color: #3a5a72;
        cursor: pointer;
        text-align: center;
        background: #f0fdf4;
        transition: all .15s;
        font-family: 'DM Sans',sans-serif;
        animation: pulse-green 2.4s ease-in-out infinite;
    }

        .slot-btn:hover {
            border-color: #1a6fa8;
            background: #f0f8ff;
            color: #0a4d7c;
            animation: none;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(26,111,168,0.12);
        }

        .slot-btn.selected {
            border-color: #0a4d7c;
            background: #0a4d7c;
            color: #fff;
            animation: none;
        }

            .slot-btn.selected .slot-dot {
                background: #fff;
            }

            .slot-btn.selected .slot-available {
                color: rgba(255,255,255,0.8);
                border-color: rgba(255,255,255,0.3);
                background: rgba(255,255,255,0.1);
            }

    /* Ca đã qua giờ */
    .slot-btn.expired {
        border-color: #e2e8f0;
        background: #f8fafc;
        color: #94a3b8;
        cursor: not-allowed;
        animation: none;
        opacity: 0.7;
    }
    .slot-btn.expired:hover {
        border-color: #e2e8f0;
        background: #f8fafc;
        color: #94a3b8;
        transform: none;
        box-shadow: none;
    }
    .slot-expired-badge {
        display: inline-flex;
        align-items: center;
        margin-top: 6px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 500;
        padding: 2px 8px;
        border-radius: 20px;
    }

    /* Chấm xanh nhấp nháy */
    .slot-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: #22c55e;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
        animation: dot-blink 1.6s ease-in-out infinite;
    }
    /* Badge "Còn X chỗ" */
    .slot-available {
        display: inline-flex;
        align-items: center;
        margin-top: 6px;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 10px;
        font-weight: 500;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .form-section {
        background: #fff;
        border: 1px solid #d4e8f5;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 500;
        color: #0a4d7c;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #d4e8f5;
    }

    .form-label {
        font-size: 11px;
        font-weight: 500;
        color: #3a5a72;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        width: 100%;
        height: 40px;
        border: 1px solid #d4e8f5;
        border-radius: 9px;
        padding: 0 12px;
        font-size: 13px;
        color: #0d2d44;
        background: #fff;
        outline: none;
        font-family: 'DM Sans',sans-serif;
        margin-bottom: 14px;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 3px rgba(26,111,168,.09);
        }

    .form-textarea {
        width: 100%;
        height: 80px;
        border: 1px solid #d4e8f5;
        border-radius: 9px;
        padding: 10px 12px;
        font-size: 13px;
        color: #0d2d44;
        background: #fff;
        outline: none;
        font-family: 'DM Sans',sans-serif;
        resize: none;
        box-sizing: border-box;
    }

        .form-textarea:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 3px rgba(26,111,168,.09);
        }

    .summary-box {
        background: #f0f8ff;
        border: 1px solid #d4e8f5;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 20px;
        display: none;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: 4px 0;
    }

        .summary-row .lbl {
            color: #7a9bb0;
        }

        .summary-row .val {
            font-weight: 500;
            color: #0a4d7c;
        }

    .btn-submit {
        width: 100%;
        height: 44px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
        transition: background .15s;
    }

        .btn-submit:hover {
            background: #1a6fa8;
        }

        .btn-submit:disabled {
            background: #9bb5c8;
            cursor: not-allowed;
        }

    .book-card {
        background: #f5faff;
        border: 1px solid #c8dff0;
        border-radius: 18px;
        padding: 32px 36px;
        box-shadow: 0 4px 24px rgba(10,77,124,.08);
        margin-bottom: 24px;
    }

    .no-slots {
        text-align: center;
        padding: 20px;
        color: #7a9bb0;
        font-size: 13px;
    }

    .pay-method-row {
        display: flex;
        gap: 12px;
        margin: 10px 0 16px;
    }

    .pay-card {
        flex: 1;
        border: 2px solid #d4e8f5;
        border-radius: 12px;
        padding: 14px 10px;
        cursor: pointer;
        text-align: center;
        transition: all .2s;
        background: #fff;
        user-select: none;
    }

        .pay-card:hover { border-color: #0a4d7c; }

        .pay-card.selected {
            border-color: #0a4d7c;
            background: #e8f4fd;
            box-shadow: 0 0 0 3px rgba(10,77,124,.12);
        }

    .pay-icon  { font-size: 22px; display: block; margin-bottom: 4px; }
    .pay-title { font-size: 13px; font-weight: 600; color: #0a4d7c; }
    .pay-desc  { font-size: 11px; color: #7a9bb0; margin-top: 3px; }

    .btn-confirm {
        width: 100%;
        height: 48px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .15s;
        margin-top: 4px;
    }

        .btn-confirm:disabled { background: #b0c8d9; cursor: not-allowed; }
        .btn-confirm:not(:disabled):hover { background: #083d62; }

    .patient-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 14px;
    }

        .patient-row select {
            flex: 1;
            margin-bottom: 0;
        }

    .btn-add-profile {
        height: 40px;
        padding: 0 14px;
        background: #fff;
        border: 1px solid #0a4d7c;
        color: #0a4d7c;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'DM Sans',sans-serif;
        transition: all .15s;
        flex-shrink: 0;
    }

        .btn-add-profile:hover {
            background: #0a4d7c;
            color: #fff;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 420px;
        max-width: 90vw;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 600;
        color: #0a4d7c;
        margin-bottom: 20px;
    }

    .modal-footer {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-modal-cancel {
        flex: 1;
        height: 40px;
        background: #f5f5f5;
        color: #555;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

    .btn-modal-save {
        flex: 2;
        height: 40px;
        background: #0a4d7c;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

        .btn-modal-save:hover {
            background: #1a6fa8;
        }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .msg-err {
        background: #fdecea;
        border: 1px solid #f5c6c6;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 14px;
        color: #c0392b;
        font-size: 12px;
        display: none;
    }
</style>

<div class="book-wrap">
<div class="book-card">
    <div class="book-title">Đặt lịch khám Tai Mũi Họng</div>
    <div class="book-sub">Mô tả triệu chứng để AI gợi ý bác sĩ chuyên khoa phù hợp nhất</div>

    <div class="step-bar">
        <div class="step-item active" id="step1-bar">1. Chọn bác sĩ</div>
        <div class="step-item" id="step2-bar">2. Chọn khung giờ</div>
        <div class="step-item" id="step3-bar">3. Xác nhận</div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#2d7a52;font-size:13px;">
            ✅ @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background:#fdecea;border:1px solid #f5c6c6;border-radius:10px;padding:14px 18px;margin-bottom:18px;color:#c0392b;font-size:13px;">
            ❌ @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="no-slots">Hiện chưa có lịch làm việc nào. Vui lòng quay lại sau.</div>
    }
    else
    {
        <form asp-action="Book" asp-controller="Booking" method="post" id="bookForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" id="hPatientId" value="" />
            <input type="hidden" name="scheduleId" id="hScheduleId" value="" />

            <!-- Bước 1: Mô tả triệu chứng & Chọn bác sĩ (hiện ngay khi load) -->
            <div class="form-section" id="sec1">
                <div class="form-section-title">Chọn bác sĩ phù hợp</div>

                <!-- ===== AI SYMPTOM SECTION (nổi bật, là CTA chính) ===== -->
                <div class="ai-rec-panel" id="aiRecPanel">
                    <div class="ai-rec-header">
                        <span class="ai-rec-badge">✦ AI Gợi ý</span>
                        <span class="ai-rec-title">Mô tả triệu chứng để tìm bác sĩ phù hợp nhất</span>
                    </div>
                    <p class="ai-rec-sub">
                        Nhập triệu chứng bạn đang gặp — AI sẽ phân tích và gợi ý bác sĩ chuyên khoa phù hợp nhất.
                    </p>
                    <div class="ai-rec-input-row">
                        <textarea id="aiSymptoms" class="ai-rec-textarea"
                                  placeholder="Ví dụ: Ù tai 2 tuần nay, nghe kém, đôi khi chóng mặt..."></textarea>
                        <button type="button" class="ai-rec-btn" id="aiRecBtn" onclick="getAiRecommendation()">
                            <span id="aiRecBtnIcon">🔍</span>
                            <span id="aiRecBtnText">Tìm bác sĩ</span>
                        </button>
                    </div>
                    <div style="margin-top:14px;text-align:center;">
                        <button type="button" onclick="showDoctorSection()"
                                style="background:#f0f8ff;border:1.5px solid #1a6fa8;color:#0a4d7c;padding:8px 22px;border-radius:20px;font-size:13px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .2s;display:inline-flex;align-items:center;gap:6px;"
                                onmouseover="this.style.background='#daeef9';this.style.borderColor='#0a4d7c'"
                                onmouseout="this.style.background='#f0f8ff';this.style.borderColor='#1a6fa8'">
                            <span style="font-size:15px">📋</span> Bỏ qua, chọn bác sĩ ngay
                        </button>
                    </div>
                    <div class="ai-rec-error" id="aiRecError"></div>

                    <!-- Kết quả gợi ý AI (inline, xuất hiện sau khi phân tích) -->
                    <div class="ai-rec-result" id="aiRecResult">
                        <div class="ai-rec-result-label">✦ AI Gợi ý bác sĩ phù hợp với triệu chứng của bạn</div>
                        <div class="ai-rec-result-header">
                            <div class="ai-rec-avatar" id="aiDocAvatar"></div>
                            <div>
                                <div class="ai-rec-doctor-name" id="aiDocName"></div>
                                <div class="ai-rec-doctor-spec" id="aiDocSpec"></div>
                            </div>
                        </div>
                        <div class="ai-rec-reason" id="aiDocReason"></div>
                        <div class="ai-rec-actions">
                            <button type="button" class="ai-rec-select-btn"
                                    onclick="applyAiRecommendation()">
                                Chọn bác sĩ này →
                            </button>
                            <button type="button" class="ai-rec-dismiss"
                                    onclick="dismissAiResult()">Bỏ qua, tự chọn bác sĩ</button>
                        </div>
                    </div>
                </div>
                <!-- ===== END AI SECTION ===== -->

                <!-- Khu vực tự chọn bác sĩ — ẩn ban đầu, hiện khi bấm "Bỏ qua, tự chọn" -->
                <div id="doctorSection" style="display:none">

                    <!-- Bác sĩ đã từng khám (nếu có) -->
                    <div class="past-doc-section" id="pastDoctorSection">
                        <div class="past-doc-label">Bác sĩ bạn đã từng khám</div>
                        <div class="doctor-grid" id="pastDoctorGrid"></div>
                    </div>

                    <!-- Filter chips — chỉ Tai / Mũi / Họng -->
                    @*<div class="filter-chips" id="filterChips">
                        <span style="font-size:11px;color:#94a3b8;line-height:30px;margin-right:4px;">Lọc theo khoa:</span>
                        <button type="button" class="filter-chip" id="chip-tai"  onclick="filterDoctorGrid('tai',  this)">👂 Tai</button>
                        <button type="button" class="filter-chip" id="chip-mui"  onclick="filterDoctorGrid('mui',  this)">👃 Mũi</button>
                        <button type="button" class="filter-chip" id="chip-hong" onclick="filterDoctorGrid('hong', this)">🗣️ Họng</button>
                    </div>*@

                    <!-- Doctor grid (render qua JS) -->
                    <div class="doctor-grid" id="doctorGrid"></div>
                </div>
            </div>

            <!-- Bước 2: Chọn ngày + khung giờ -->
            <div class="form-section" id="sec2" style="display:none">
                <div class="form-section-title">
                    Chọn ca khám —
                    <span id="selDoctorName" style="color:#c9a227"></span>
                    <span style="font-size:11px;color:#7a9bb0;font-weight:400;margin-left:8px;">
                        <span style="display:inline-block;width:7px;height:7px;background:#22c55e;border-radius:50%;margin-right:3px;vertical-align:middle;"></span>
                        Ô xanh = còn chỗ trống
                    </span>
                </div>

                <!-- Date picker -->
                <div style="margin-bottom:20px;">
                    <label class="form-label">Chọn ngày khám</label>
                    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                        <input type="date" id="datePicker" class="form-control"
                               style="max-width:200px;margin-bottom:0;"
                               onchange="onDateChange()" />
                        <div id="dateLoadingSpinner" style="display:none;font-size:12px;color:#7a9bb0;">
                            <span style="display:inline-block;width:14px;height:14px;border:2px solid #d4e8f5;border-top-color:#0a4d7c;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;"></span>
                            Đang tải ca khám...
                        </div>
                    </div>
                    <div id="dateHint" style="font-size:12px;color:#7a9bb0;margin-top:6px;">
                        📅 Vui lòng chọn ngày để xem các ca khám còn trống
                    </div>
                </div>

                <div class="slot-grid" id="slotGrid">
                    <p style="color:#7a9bb0;font-size:13px;grid-column:1/-1;">Chọn ngày để xem ca khám</p>
                </div>
            </div>

            <!-- Bước 3: Hồ sơ + ghi chú -->
            <div class="form-section" id="sec3" style="display:none">
                <div class="form-section-title">Thông tin bổ sung</div>
                <label class="form-label">Hồ sơ khám bệnh</label>
                <div class="patient-row">
                    <select class="form-control" id="selPatient"
                            onchange="document.getElementById('hPatientId').value=this.value">
                        <option value="">-- Chọn hồ sơ --</option>
                        @foreach (var p in patients)
                        {
                            <option value="@p.Id">@p.DisplayLabel</option>
                        }
                    </select>
                    <button type="button" class="btn-add-profile" onclick="openModal()">+ Hồ sơ mới</button>
                </div>
                <label class="form-label">Ghi chú cho bác sĩ (tuỳ chọn)</label>
                <textarea class="form-textarea" name="note"
                      placeholder="Mô tả triệu chứng, tiền sử bệnh liên quan..."></textarea>
            </div>

            <!-- Tóm tắt -->
            <div class="summary-box" id="summaryBox" style="display:none">
                <div class="form-section-title" style="border:none;padding:0;margin-bottom:12px">Tóm tắt lịch khám</div>
                <div class="summary-row"><span class="lbl">Bác sĩ</span><span class="val" id="sumDoctor"></span></div>
                <div class="summary-row"><span class="lbl">Chuyên khoa</span><span class="val" id="sumSpec"></span></div>
                <div class="summary-row"><span class="lbl">Ngày khám</span><span class="val" id="sumDate"></span></div>
                <div class="summary-row"><span class="lbl">Ca khám</span><span class="val" id="sumTime"></span></div>
            </div>

            <!-- Nút xác nhận đặt lịch -->
            <div class="form-section" style="padding-top:8px;">
                <input type="hidden" name="paymentMethod" id="hPaymentMethod" value="cash" />
                <button type="button"
                        id="btnConfirm"
                        disabled
                        onclick="confirmBooking()"
                        class="btn-confirm">
                    Xác nhận đặt lịch
                </button>
            </div>
        </form>
    }
</div>
</div>

<!-- Modal Thông báo Đặt lịch thành công -->
